<?xml version="1.0" encoding="UTF-8"?>
<!--
    sitemap.xsd alone rejects image:image: its xsd:any is processContents="strict", so the extension's schema must be
    known. This wrapper adds it. Sources, copied unchanged next to this file:
    https://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd
    https://www.sitemaps.org/schemas/sitemap/0.9/siteindex.xsd
    https://www.google.com/schemas/sitemap-image/1.1/sitemap-image.xsd
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://www.sitemaps.org/schemas/sitemap/0.9"
            elementFormDefault="qualified">
  <xsd:import namespace="http://www.google.com/schemas/sitemap-image/1.1" schemaLocation="sitemap-image.xsd"/>
  <xsd:include schemaLocation="sitemap.xsd"/>
</xsd:schema>
