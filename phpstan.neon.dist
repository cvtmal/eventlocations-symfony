includes:
    - vendor/phpat/phpat/extension.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - tests/Architecture/Fixtures

services:
    -
        class: App\Tests\PHPStan\DoctrineColumnExtension
        tags: [phpstan.properties.readWriteExtension]
    -
        class: App\Tests\Architecture\ClassModifiersTest
        tags: [phpat.test]
    -
        class: App\Tests\Architecture\LayerIsolationTest
        tags: [phpat.test]
    -
        class: App\Tests\Architecture\InheritanceContractsTest
        tags: [phpat.test]
    -
        class: App\Tests\Architecture\InfrastructureAccessTest
        tags: [phpat.test]
    -
        class: App\Tests\Architecture\CqrsContractsTest
        tags: [phpat.test]
    -
        class: App\Tests\Architecture\ModuleBoundariesTest
        tags: [phpat.test]
