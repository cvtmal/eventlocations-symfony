#!/bin/sh
# 03:15 Europe/Zurich: the one nightly chain, one Neon wake-up (#20). Every step runs even if an
# earlier one failed; the script exits non-zero if any did, and prints only on a failure or when
# report-stuck has something to say, so the host's cron mail stays silent on a good night.
set -u

PHP="${DEPLOY_PHP:-php}"
cd -P "$(dirname "$0")/.." || exit 1
failed=0

step() { # step <label> <command...>
    label="$1"
    shift
    out="$("$@" 2>&1)" || {
        failed=1
        printf 'cron-daily: %s failed\n' "$label"
        [ -z "$out" ] || printf '%s\n' "$out"
        return 0
    }
    [ -z "$out" ] || printf '%s\n' "$out"
}

main() {
    # bin/deploy links these into shared/ (empty on a fresh server); the stats subdirectories start missing.
    mkdir -p var/import-staging var/sessions var/lock var/stats/spool var/stats/salt
    # --quiet: these two print "0 inquiries deleted." and one line per cache pool on a good night. An error
    # still prints (the exception renderer ignores --quiet) and `step` adds its own "failed" line either way.
    step inquiries-purge "$PHP" bin/console --no-interaction --quiet app:inquiries:purge
    # D36: three years after the decision, a complaint's name, e-mail and message go (the case stays). --quiet:
    # its count line would mail every night.
    step moderation-erase "$PHP" bin/console --no-interaction --quiet app:venues:erase-complainants
    # D46: a week of searches without results goes 12 months after its Monday. --quiet: its count line would mail
    # every night.
    step search-misses-purge "$PHP" bin/console --no-interaction --quiet app:stats:purge-search-misses
    # #28: a contract's end flips the company stage and writes its renewal task. Counts stay at normal
    # verbosity, a failure line prints under --quiet.
    step crm-refresh-stages "$PHP" bin/console --no-interaction --quiet app:crm:refresh-stages
    step crm-renewal-tasks "$PHP" bin/console --no-interaction --quiet app:crm:renewal-tasks
    # G9: a lapsed paid term drops its venue to Free (it stays online) and purges it; then the reminders 30 and 7
    # days before a term ends. Both write nothing on a second run; a failure line prints under --quiet.
    step subscriptions-expire "$PHP" bin/console --no-interaction --quiet app:subscriptions:expire
    step subscriptions-remind "$PHP" bin/console --no-interaction --quiet app:subscriptions:remind
    # G14: offers «Kurzfristig frei» past their last day are deleted and their managers mailed. The pages hid them at
    # midnight already. A second run writes nothing; a failure line prints under --quiet.
    step last-minute-expire "$PHP" bin/console --no-interaction --quiet app:last-minute:expire
    # No --quiet: a repaired inquiry is worth the mail, and a good night prints nothing anyway.
    step crm-backfill "$PHP" bin/console --no-interaction app:crm:backfill-inquiries
    # No --quiet: its output (the stuck rows) is the point of this step.
    step inquiries-stuck "$PHP" bin/console --no-interaction app:inquiries:report-stuck
    # #47: loads the beacon's day files into Neon and rebuilds stats_daily; the button on /admin/statistik runs
    # the same job. --quiet: its count line would mail every night; an error still prints.
    step stats-ingest "$PHP" bin/console --no-interaction --quiet app:stats:ingest
    step pool-prune "$PHP" bin/console --no-interaction --quiet cache:pool:prune
    # The trailing slashes matter: these directories are symlinks into shared/, and find does not follow a
    # symlink it is given as a start unless the path names the directory behind it.
    # #25: abandoned uploads in the import staging directory, older than a day.
    step staging-sweep find var/import-staging/ -mindepth 1 -maxdepth 1 -mtime +1 -exec rm -rf {} +
    # Sessions the garbage collector never reaches on this host. 43200 minutes is the 30-day admin idle timeout
    # (IdleTimeoutListener::IDLE_SECONDS); a shorter age would end idle back-office sessions at 03:15.
    step sessions-sweep find var/sessions/ -type f -mmin +43200 -delete
    # Limiter locks: FlockStore never unlinks its files, so each client leaves one for ever. The longest
    # limiter window is 60 minutes; deleting a file a process still holds costs at most one count race.
    step lock-sweep find var/lock/ -maxdepth 1 -type f -name 'sf.*.lock' -mmin +180 -delete
    exit "$failed"
}

main "$@"
