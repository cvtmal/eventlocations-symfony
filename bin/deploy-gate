#!/bin/sh
# SSH forced command for the GitHub deploy key (#20). Installed ONCE by the owner, outside the
# app directory, because a deploy replaces everything inside it:
#
#   /home/djweddin/deploy/hochzeitslocation/deploy-gate        (chmod 700)
#
# ~/.ssh/authorized_keys (see deploy/authorized_keys.example; authorized_keys does not expand
# $HOME, so the line carries the absolute path):
#
#   command="/home/djweddin/deploy/hochzeitslocation/deploy-gate",restrict ssh-ed25519 AAAA… github-deploy
#
# Accepts exactly three commands, anything else is refused with exit 2 and no shell:
#   deploy <40-hex sha>   the release tarball (tar.gz) arrives on stdin
#   purge                 empty the HTTP cache
#   check                 env guard, sha, PHP version, free disk
#
# A change to this file needs a manual copy; it is deliberately tiny and delegates everything.
set -eu

APP="${DEPLOY_APP:-$HOME/www/hochzeitslocation.ch}"
WORK="${DEPLOY_WORK:-$HOME/deploy/hochzeitslocation}"
MAX_BYTES=300000000

refuse() {
    printf '%s\n' "deploy-gate: $*" >&2
    exit 2
}

deploy() {
    sha="$1"
    case "$sha" in
        *[!0-9a-f]* | "") refuse "deploy needs a lowercase hex sha" ;;
    esac
    [ "${#sha}" -eq 40 ] || refuse "deploy needs a 40-character sha"

    # mkdir is atomic: a second deploy while one runs is refused, not queued.
    mkdir "$WORK/.lock" 2>/dev/null || refuse "another deploy is running (rm -r $WORK/.lock if it died)"
    trap 'rm -rf "$WORK/.lock" "$WORK/stage"' EXIT

    rm -rf "$WORK/stage"
    mkdir "$WORK/stage"
    # head caps what an authorised key can push; tar stops at the first error (pipefail is not POSIX).
    head -c "$MAX_BYTES" | tar -xzf - -C "$WORK/stage"

    # Not exec: the trap must still run. The release's own script does the work, so a new
    # release is deployed by its own, newest logic.
    sh "$WORK/stage/bin/deploy" install "$sha"
}

main() {
    mkdir -p "$WORK"
    cmd="${SSH_ORIGINAL_COMMAND:-}"
    case "$cmd" in
        "deploy "*) deploy "${cmd#deploy }" ;;
        purge | check) exec sh "$APP/bin/deploy" "$cmd" ;;
        *) refuse "refused: only 'deploy <sha>', 'purge' and 'check' are allowed" ;;
    esac
}

main "$@"
