#!/bin/sh
# SSH forced command for the GitHub deploy key (#20, F15). Installed ONCE by the owner, next to the
# releases and outside them, so a deploy never replaces it:
#
#   /var/www/deine-eventlocation.ch/deploy-gate        (chmod 700, owned by the deploy user)
#
# ~/.ssh/authorized_keys of the deploy user (see deploy/authorized_keys.example):
#
#   command="/var/www/deine-eventlocation.ch/deploy-gate",restrict ssh-ed25519 AAAA… github-deploy
#
# Accepts exactly four commands, anything else is refused with exit 2 and no shell:
#   deploy <40-hex sha>   the release tarball (tar.gz) arrives on stdin
#   purge                 empty the HTTP cache
#   check                 env guard, sha, PHP version, free disk
#   rollback              switch current back to the previous release
#
# A change to this file needs a manual copy; it is deliberately tiny and delegates everything.
set -eu

ROOT="${DEPLOY_ROOT:-/var/www/deine-eventlocation.ch}"
# On the releases' filesystem, so bin/deploy moves the stage into releases/ instead of copying it.
WORK="${DEPLOY_WORK:-$ROOT/.deploy}"
MAX_BYTES=300000000

refuse() {
    printf '%s\n' "deploy-gate: $*" >&2
    exit 2
}

lock() {
    # mkdir is atomic: a second deploy or rollback while one runs is refused, not queued.
    mkdir "$WORK/.lock" 2>/dev/null || refuse "another deploy is running (rm -r $WORK/.lock if it died)"
    trap 'rm -rf "$WORK/.lock" "$WORK/stage"' EXIT
    # A dropped SSH connection is a HUP; dash runs the EXIT trap only on exit.
    trap 'exit 1' HUP INT TERM
}

deploy() {
    sha="$1"
    case "$sha" in
        *[!0-9a-f]* | "") refuse "deploy needs a lowercase hex sha" ;;
    esac
    [ "${#sha}" -eq 40 ] || refuse "deploy needs a 40-character sha"

    lock

    rm -rf "$WORK/stage"
    mkdir "$WORK/stage"
    # head caps what an authorised key can push; tar stops at the first error (pipefail is not POSIX).
    head -c "$MAX_BYTES" | tar -xzf - -C "$WORK/stage"

    # Not exec: the trap must still run. The release's own script does the work, so a new
    # release is deployed by its own, newest logic.
    sh "$WORK/stage/bin/deploy" install "$sha"
}

# review-demo: the operator's demo flag (make review-up) skips 2FA; the server never runs it. bin/deploy checks the
# same, this refuses before a tarball is even read. Only an unset, empty or 0 value passes.
refuse_review_mode() {
    case "${APP_REVIEW_MODE:-0}" in
        0) ;;
        *) refuse "APP_REVIEW_MODE is set in the environment, review mode never runs on the server" ;;
    esac
    [ -f "$ROOT/shared/.env.local" ] || return 0
    value="$(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}APP_REVIEW_MODE=//p' "$ROOT/shared/.env.local" | tail -n 1 | tr -d "\"' \r")"
    case "$value" in
        "" | 0) ;;
        *) refuse "APP_REVIEW_MODE is set in shared/.env.local, review mode never runs on the server" ;;
    esac
}

main() {
    mkdir -p "$WORK"
    refuse_review_mode
    cmd="${SSH_ORIGINAL_COMMAND:-}"
    case "$cmd" in
        "deploy "*) deploy "${cmd#deploy }" ;;
        purge | check) exec sh "$ROOT/current/bin/deploy" "$cmd" ;;
        # Under the deploy lock, so it never races a running install's switch. Not exec: the trap must run.
        rollback)
            lock
            sh "$ROOT/current/bin/deploy" rollback
            ;;
        *) refuse "refused: only 'deploy <sha>', 'purge', 'check' and 'rollback' are allowed" ;;
    esac
}

main "$@"
