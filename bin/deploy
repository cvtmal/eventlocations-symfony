#!/bin/sh
# Production deploy (#20, F15): an Infomaniak VPS with nginx, php-fpm 8.5 and SSH. Each deploy is a
# new directory under releases/, and a symlink switch makes it live in one rename:
#
#   /var/www/deine-eventlocation.ch/          DEPLOY_ROOT, owned by the deploy user
#     current  -> releases/<sha>              what nginx and cron run (nginx resolves it per request)
#     previous -> releases/<sha>              what `rollback` goes back to
#     releases/<sha>/                         one unpacked tarball each, the last KEEP plus both links
#     shared/.env.local                       secrets, written by the owner once, chmod 600
#     shared/var/<dir>                        state that outlives a release (SHARED_VAR below)
#     shared/public/media/                    generated image variants and PDFs
#     deploy-gate, .deploy/                   the forced command and its lock and stage
#
#   bin/deploy install <40-hex sha>   run from the unpacked tarball (stage), by bin/deploy-gate
#   bin/deploy purge                  run from current: empty the HTTP cache
#   bin/deploy check                  run from current: env guard, sha, PHP version, free disk
#   bin/deploy rollback               run from current: switch back to previous, then purge
#
# Order of an install, and why:
#   1. check the tarball, move it in      a half-built tarball changes nothing
#   2. link shared state, env guard       a bad .env.local never reaches the live release
#   3. migrations                         additive, so the live release keeps working on the new
#                                         schema (and a rollback can go back over it)
#   4. cache:warmup, towns import         in the new directory, before any request reaches it
#   5. switch current, purge, prune       the only moment the live site changes (one rename)
#
# Each release compiles its own var/cache, so an old container never boots new code (F-M2 is gone).
# Never echoes a secret: it prints names, shas and counts.
set -eu

ROOT="${DEPLOY_ROOT:-/var/www/deine-eventlocation.ch}"
PHP="${DEPLOY_PHP:-php}"
KEEP="${DEPLOY_KEEP:-3}"
# var/cache stays in each release; everything else under var/ is shared.
SHARED_VAR="log sessions share media stats lock import-staging"

say() { printf '%s\n' "deploy: $*"; }
die() { printf '%s\n' "deploy: $*" >&2; exit 1; }

console() { # console <dir> <args...>
    dir="$1"
    shift
    (cd "$dir" && "$PHP" bin/console --no-interaction "$@")
}

# Exit 0: listed. 1: this build does not have it. 2: the console did not boot, so nothing is known.
# Its stderr stays unread: a FormatException quotes .env.local, and that excerpt can hold part of a secret.
has_command() { # has_command <dir> <name>
    listing="$(console "$1" list --raw 2>/dev/null)" || return 2
    printf '%s\n' "$listing" | grep -q "^$2 "
}

verify_stage() {
    for f in bin/console vendor/autoload_runtime.php public/index.php \
        public/assets/manifest.json public/admin-build/.vite/manifest.json; do
        [ -e "$1/$f" ] || die "the tarball lacks $f, nothing was changed"
    done
}

require_root() {
    [ -d "$ROOT/releases" ] || die "$ROOT/releases does not exist (first-time setup, docs/operations.md), nothing was changed"
    [ -f "$ROOT/shared/.env.local" ] || die "$ROOT/shared/.env.local is missing (secrets live there, see deploy/env.local.example), nothing was changed"
}

require_current() {
    require_root
    [ -L "$ROOT/current" ] || die "$ROOT/current does not exist, nothing is deployed yet"
}

no_boot() { # no_boot <dir>
    printf '%s\n' "deploy: the console in $1 does not boot, often a malformed .env.local; its output is withheld because it can quote a secret, read it over SSH with: cd $1 && $PHP bin/console about" >&2
}

guard_env() { # runs the release's own guard against the server's real .env.local
    found=0
    has_command "$1" app:prod:check-env || found=$?
    case "$found" in
        0) ;;
        1) die "app:prod:check-env is missing in this release, the live release is unchanged" ;;
        *)
            no_boot "$1"
            die "the env guard could not run, the live release is unchanged"
            ;;
    esac
    console "$1" app:prod:check-env || die "the env guard refused, the live release is unchanged"
}

link_shared() { # link_shared <release>
    mkdir -p "$ROOT/shared/public/media" "$1/var" "$1/public"
    ln -sfn "$ROOT/shared/.env.local" "$1/.env.local"
    for d in $SHARED_VAR; do
        mkdir -p "$ROOT/shared/var/$d"
        rm -rf "${1:?}/var/$d"
        ln -sfn "$ROOT/shared/var/$d" "$1/var/$d"
    done
    rm -rf "$1/public/media"
    ln -sfn "$ROOT/shared/public/media" "$1/public/media"
}

target() { # target <link>: the release a link points at, empty if none
    [ -L "$1" ] || return 0
    basename "$(readlink "$1")"
}

# ln makes the new link under a temporary name, mv -T renames it over the old one: rename(2) is
# atomic, so a request sees either the old release or the new one, never no release.
point() { # point <link name> <release sha>
    ln -sfn "releases/$2" "$ROOT/.$1.new"
    mv -T "$ROOT/.$1.new" "$ROOT/$1"
}

switch_to() { # switch_to <sha>: current becomes <sha>, previous becomes the old current
    old="$(target "$ROOT/current")"
    point current "$1"
    if [ -n "$old" ] && [ "$old" != "$1" ]; then
        point previous "$old"
    fi
}

# Newest first by the time the release was moved in; current and previous are always kept.
prune() {
    cur="$(target "$ROOT/current")"
    prev="$(target "$ROOT/previous")"
    # The names are shas (install checks them), so ls output is safe to read line by line, and only
    # ls sorts by time in POSIX.
    # shellcheck disable=SC2012
    ls -1t "$ROOT/releases" | tail -n +"$((KEEP + 1))" | while read -r r; do
        if [ "$r" = "$cur" ] || [ "$r" = "$prev" ]; then
            continue
        fi
        rm -rf "${ROOT:?}/releases/$r"
        say "pruned $r"
    done
}

install_release() {
    sha="$1"
    case "$sha" in
        *[!0-9a-f]* | "") die "install needs a lowercase hex sha" ;;
    esac
    [ "${#sha}" -eq 40 ] || die "install needs a 40-character sha"

    stage="$(cd "$(dirname "$0")/.." && pwd -P)"
    real_root="$(cd "$ROOT" 2>/dev/null && pwd -P || printf '%s' "$ROOT")"
    case "$stage" in
        "$real_root"/releases/*) die "install must run from the unpacked tarball, not from a release" ;;
        *) ;;
    esac

    verify_stage "$stage"
    require_root
    release="$ROOT/releases/$sha"
    [ "$(target "$ROOT/current")" != "$sha" ] || die "$sha is live already, nothing was changed"
    # Rebuilding it would delete the one release a rollback can go back to.
    [ "$(target "$ROOT/previous")" != "$sha" ] || die "$sha is the previous release, use rollback; nothing was changed"

    # An older copy of the same sha is not live (checked above): replace it. Until the switch, a
    # failure removes the new directory again, so releases/ only ever holds releases that went live.
    rm -rf "$release"
    trap 'rm -rf "$release"' EXIT
    # A dropped SSH connection or a cancelled run is a signal; dash runs the EXIT trap only on exit.
    trap 'exit 1' HUP INT TERM
    mv "$stage" "$release"
    # mv keeps the stage's time; prune orders by it.
    touch "$release"
    link_shared "$release"
    # Read at runtime by the Sentry options (#20); one file per release, so a rollback reports the right one.
    printf 'SENTRY_RELEASE=%s\n' "$sha" > "$release/.env.prod.local"

    guard_env "$release"
    console "$release" doctrine:migrations:migrate --allow-no-migration \
        || die "the migration failed, the live release is unchanged"
    console "$release" cache:warmup || die "cache:warmup failed, the live release is unchanged"
    console "$release" app:geo:import-towns || die "the towns import failed, the live release is unchanged"

    switch_to "$sha"
    trap - EXIT HUP INT TERM
    say "current -> releases/$sha"
    # From here the new release is live. A failure below leaves it live; the message says so.
    purge_cache "$release" || die "the release is live but the HTTP cache could not be cleared, run bin/deploy purge"
    prune

    say "DEPLOYED_SHA=$sha"
}

purge_cache() { # the store is #19's; a build without it has nothing to clear
    found=0
    has_command "$1" app:http-cache:clear || found=$?
    case "$found" in
        0) console "$1" app:http-cache:clear ;;
        1) say "no app:http-cache:clear in this build (#19 not included), skipped" ;;
        *)
            no_boot "$1"
            return 1
            ;;
    esac
}

rollback() {
    require_current
    prev="$(target "$ROOT/previous")"
    if [ -z "$prev" ] || [ ! -d "$ROOT/releases/$prev" ]; then
        die "there is no previous release to go back to, nothing was changed"
    fi
    switch_to "$prev"
    say "current -> releases/$prev (rolled back; migrations stay, docs/operations.md)"
    purge_cache "$ROOT/releases/$prev" || die "rolled back, but the HTTP cache could not be cleared, run bin/deploy purge"
    say "DEPLOYED_SHA=$prev"
}

check_app() {
    require_current
    guard_env "$ROOT/current"
    say "sha=$(sed -n 's/^SENTRY_RELEASE=//p' "$ROOT/current/.env.prod.local" 2>/dev/null || true)"
    say "previous=$(target "$ROOT/previous")"
    say "releases=$(find "$ROOT/releases" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')"
    say "php=$("$PHP" -r 'echo PHP_VERSION;')"
    say "disk=$(df -h "$ROOT" | awk 'NR==2 {print $4 " free"}')"
}

main() {
    cmd="${1:-}"
    case "$cmd" in
        install) install_release "${2:-}" ;;
        purge) require_current && purge_cache "$ROOT/current" ;;
        check) check_app ;;
        rollback) rollback ;;
        *) die "usage: bin/deploy install <sha> | purge | check | rollback" ;;
    esac
}

main "$@"
