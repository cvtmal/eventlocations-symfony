#!/bin/sh
# Loads the owner's content into production from the owner's Mac (#20): the local php container
# does the work against Neon, and the media goes up with rsync. The server has 256M and a slow
# AVIF encoder, so it never imports.
#
# Run bin/prod-import help for the commands and the run order.
#
# PROD_DATABASE_URL and PROD_SSH live in the shell, never in a file. The connection string stays
# off every process list too: it reaches the container by name only (see prod_console).
set -eu

MEDIA_DIR="${PROD_MEDIA_DIR:-var/prod-media}"
# compose.yaml mounts the checkout here.
CONTAINER_ROOT="${PROD_CONTAINER_ROOT:-/var/www/html}"
# The live release; its var/media and public/media are links into shared/ (bin/deploy).
REMOTE_APP="${PROD_REMOTE_APP:-/var/www/deine-eventlocation.ch/current}"
REMOTE_PHP="${PROD_REMOTE_PHP:-php}"

say() { printf '%s\n' "prod-import: $*"; }
die() { printf '%s\n' "prod-import: $*" >&2; exit 1; }

usage() {
    cat <<'USAGE'
Usage: bin/prod-import <command>

  import                   app:venues:import against Neon, media into PROD_MEDIA_DIR
  import-dry               app:venues:import --dry-run against Neon: the summary and the kept venues, no writes
  regenerate [--venue=N]   app:media:regenerate against Neon, then sync, then purge
  sync                     rsync the media to the server, additive: nothing is deleted there
  purge                    empty the HTTP cache on the server
  all                      import, then sync, then purge
  crm-bootstrap            app:crm:bootstrap against Neon: one company per venue that has none
  places-find              app:venues:find-google-places against Neon: the place ID report, no writes
  places-apply-dry         app:venues:apply-google-places --dry-run against Neon: the summary, no writes
  places-apply             app:venues:apply-google-places against Neon, then purge
  consents-dry <csv>       app:crm:record-consents --dry-run against Neon: what would be recorded, no writes
  consents <csv>           app:crm:record-consents against Neon
  withdraw-dry <number> [--on=YYYY-MM-DD]
                           app:crm:withdraw-consent --dry-run against Neon: what would go, here and
                           on the server, no writes
  withdraw <number> [--on=YYYY-MM-DD]
                           app:crm:withdraw-consent against Neon, then delete the venue's public
                           media and originals on the server, then purge
  withdraw-media <number>  delete the withdrawn venue's public media and originals here and on the
                           server, then purge: the retry when withdraw committed but its media
                           step or purge failed
  contacts-dry <csv>       app:crm:import-contacts --dry-run against Neon: the row outcomes, no writes
  contacts <csv>           app:crm:import-contacts against Neon (sends nothing)
  help                     this text

Run order: first deploy (migrations and towns), then import-dry until its summary is right, then
all. The import keeps every venue staff edited and lists it; import-dry shows the list first.
--prune is refused: an empty or unmounted venues/ would unpublish every unedited venue.

Google place IDs (#53, #57): places-find (needs GOOGLE_PLACES_API_KEY in the shell; confident rows
come pre-marked apply=yes), check the report, then places-apply-dry until right, then places-apply.

Onboarding (F14, docs/operations.md "Onboarding"): each CRM command runs its -dry form first, until
its summary is right. <csv> is a path inside the checkout (e.g. content/owner/sheet.csv).

Environment, never in a file:
  PROD_DATABASE_URL   Neon's direct string
  PROD_SSH            the owner's unrestricted login, user@host (not the forced-command deploy key)
  PROD_MEDIA_DIR      inside the checkout, default var/prod-media
  GOOGLE_PLACES_API_KEY  places-find only: a Places API (New) key restricted to your IP
USAGE
}

require_env() {
    [ -n "${PROD_DATABASE_URL:-}" ] || die "PROD_DATABASE_URL is not set"
    [ -n "${PROD_SSH:-}" ] || die "PROD_SSH is not set"
    case "$PROD_SSH" in
        -*) die "PROD_SSH must be user@host" ;;
    esac
    # Mounted into the php container, so it has to stay inside the checkout.
    case "$MEDIA_DIR" in
        "" | /* | ..* | */..*) die "PROD_MEDIA_DIR must be a path inside the checkout" ;;
    esac
}

prod_console() { # prod_console <console args...>
    # debug is off, so a kernel left over from an older checkout would never notice new code.
    docker compose exec -T php rm -rf var/cache/prod

    if docker compose exec -T php test -x /usr/bin/time; then
        set -- /usr/bin/time -f 'prod-import: peak memory %M KB' php bin/console --no-debug --no-interaction "$@"
    else
        set -- php bin/console --no-debug --no-interaction "$@"
    fi

    # -e with a bare name: compose reads the value from its own environment, so it is on no argv.
    # The prefix is what sets it: without one, compose would fall back to DATABASE_URL in .env.
    # GOOGLE_PLACES_API_KEY (#53's places-find) comes the same way, from the shell when it is set.
    DATABASE_URL="$PROD_DATABASE_URL" docker compose exec -T \
        -e GOOGLE_PLACES_API_KEY \
        -e APP_ENV=prod \
        -e DATABASE_URL \
        -e MEDIA_ROOT="$CONTAINER_ROOT/$MEDIA_DIR/originals" \
        -e MEDIA_PUBLIC_DIR="$CONTAINER_ROOT/$MEDIA_DIR/public" \
        php "$@"
}

import_content() {
    prod_console app:venues:import
}

regenerate_media() { # regenerate_media [--venue=N]
    prod_console app:media:regenerate "$@"
}

sync_media() {
    originals="$MEDIA_DIR/originals/content"
    public="$MEDIA_DIR/public"
    [ -d "$originals" ] || die "$originals is missing, run import first"
    [ -d "$public" ] || die "$public is missing, run import first"

    # rsync creates only the last level, and var/ starts empty on the server.
    # shellcheck disable=SC2029 # REMOTE_APP is meant to expand here.
    ssh "$PROD_SSH" "mkdir -p $REMOTE_APP/var/media/content $REMOTE_APP/public/media"
    # No --delete: the server's files outlive a smaller export. No -o -p -g: the login owns them.
    rsync -rltz "$originals/" "$PROD_SSH:$REMOTE_APP/var/media/content/"
    rsync -rltz "$public/" "$PROD_SSH:$REMOTE_APP/public/media/"
    say "media synced"
}

withdrawn_key() { # withdrawn_key <venue number>: the content key Neon's withdrawal note keeps, never a sheet's
    if ! key="$(prod_console app:crm:withdraw-consent --withdrawn-key "$1")"; then
        printf '%s\n' "$key" >&2
        die "no content key for venue $1: it has to be withdrawn first"
    fi
    # The pattern of a content key (ContentFormat::KEY_PATTERN), so the path stays one directory deep.
    case "$key" in
        "") ;;
        *[!a-z0-9-]* | -* | *- | *--*) die "refused content key for venue $1: $key" ;;
    esac
    [ "${#key}" -le 100 ] || die "refused content key for venue $1: longer than 100"
    printf '%s' "$key"
}

venue_media_paths() { # venue_media_paths <venue number> [<content key>]: the venue's directories on the server
    # Public media and uploads are kept under the number, the import's originals under the key (Venues\VenueOriginals).
    printf '%s' "$REMOTE_APP/public/media/$1 $REMOTE_APP/var/media/cms/$1"
    [ -z "${2:-}" ] || printf ' %s' "$REMOTE_APP/var/media/content/$2"
}

remove_venue_media() { # remove_venue_media <venue number>
    # The console deletes the local copies only; the sync never deletes on the server.
    # Two steps: set -e stops on a failed substitution only when it is the whole assignment.
    key="$(withdrawn_key "$1")"
    # The local copies again: if the console's own delete failed after the withdrawal committed, the next sync
    # would bring them back. A venue without a key has no content directory, so content/ itself is never named.
    rm -rf "$MEDIA_DIR/public/$1"
    [ -z "$key" ] || rm -rf "$MEDIA_DIR/originals/content/$key"
    say "deleted here: $MEDIA_DIR/public/$1${key:+ $MEDIA_DIR/originals/content/$key}"
    paths="$(venue_media_paths "$1" "$key")"
    # shellcheck disable=SC2029 # The paths are meant to expand here: digits and a checked key only.
    ssh "$PROD_SSH" "rm -rf $paths"
    say "deleted on the server: $paths"
}

purge_cache() {
    # shellcheck disable=SC2029 # Both paths are meant to expand here.
    ssh "$PROD_SSH" "cd $REMOTE_APP && $REMOTE_PHP bin/console app:http-cache:clear"
}

refuse_csv_arguments() { # refuse_csv_arguments <command> <args...>: exactly one CSV inside the checkout
    cmd="$1"
    shift
    [ "$#" -eq 1 ] || die "$cmd takes one CSV file"
    # Mounted into the php container with the checkout, so it has to stay inside it.
    case "$1" in
        "" | -* | /* | ..* | */..*) die "$cmd needs a CSV path inside the checkout" ;;
        *.csv | *.CSV) ;;
        *) die "$cmd needs a .csv file" ;;
    esac
    [ -f "$1" ] || die "$1 is not a file"
}

refuse_venue_number() { # refuse_venue_number <command> <venue number>
    # Digits without a leading zero: the console reads 007 as 7, the rm would take public/media/007.
    case "$2" in
        "" | 0* | *[!0-9]*) die "$1 needs a venue number" ;;
    esac
}

refuse_withdraw_arguments() { # refuse_withdraw_arguments <command> <venue number> [--on=YYYY-MM-DD]
    cmd="$1"
    shift
    if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then die "$cmd takes a venue number and at most --on=YYYY-MM-DD"; fi
    refuse_venue_number "$cmd" "$1"
    [ "$#" -eq 1 ] && return 0
    case "$2" in
        --on=[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
        *) die "refused: $2 ($cmd takes --on=YYYY-MM-DD only)" ;;
    esac
}

refuse_arguments() { # refuse_arguments <command> <args...>
    cmd="$1"
    shift
    case "$cmd" in
        consents-dry | consents | contacts-dry | contacts)
            refuse_csv_arguments "$cmd" "$@"
            return 0
            ;;
        withdraw-dry | withdraw)
            refuse_withdraw_arguments "$cmd" "$@"
            return 0
            ;;
        withdraw-media)
            [ "$#" -eq 1 ] || die "$cmd takes a venue number only"
            refuse_venue_number "$cmd" "$1"
            return 0
            ;;
    esac
    for arg in "$@"; do
        case "$arg" in
            --prune*) die "--prune is refused: run bin/prod-import help" ;;
            --venue=*)
                venue="${arg#--venue=}"
                [ "$cmd" = regenerate ] || die "$cmd takes no arguments"
                case "$venue" in
                    "" | *[!0-9]*) die "--venue needs a venue number" ;;
                esac
                ;;
            *) die "refused: $arg (this script runs fixed console commands only)" ;;
        esac
    done
    [ "$cmd" = regenerate ] || [ "$#" -eq 0 ] || die "$cmd takes no arguments"
    [ "$#" -le 1 ] || die "$cmd takes one --venue at most"
}

main() {
    cd "$(dirname "$0")/.." || exit 1

    cmd="${1:-}"
    [ "$#" -eq 0 ] || shift
    case "$cmd" in
        help | -h | --help)
            usage
            return 0
            ;;
        import | import-dry | regenerate | sync | purge | all | crm-bootstrap) ;;
        places-find | places-apply-dry | places-apply) ;;
        consents-dry | consents | withdraw-dry | withdraw | withdraw-media | contacts-dry | contacts) ;;
        *)
            usage >&2
            die "unknown command: $cmd"
            ;;
    esac

    refuse_arguments "$cmd" "$@"
    require_env

    case "$cmd" in
        import) import_content ;;
        import-dry) prod_console app:venues:import --dry-run ;;
        regenerate)
            # New variants change nothing for a visitor until they are on the server.
            regenerate_media "$@"
            sync_media
            purge_cache
            ;;
        sync) sync_media ;;
        purge) purge_cache ;;
        all)
            import_content
            sync_media
            purge_cache
            ;;
        crm-bootstrap) prod_console app:crm:bootstrap ;;
        places-find) prod_console app:venues:find-google-places ;;
        places-apply-dry) prod_console app:venues:apply-google-places --dry-run ;;
        places-apply)
            # The handlers purge only the local container's cache store.
            prod_console app:venues:apply-google-places
            purge_cache
            ;;
        consents-dry) prod_console app:crm:record-consents --dry-run "$CONTAINER_ROOT/$1" ;;
        consents) prod_console app:crm:record-consents "$CONTAINER_ROOT/$1" ;;
        withdraw-dry)
            prod_console app:crm:withdraw-consent --dry-run "$@"
            # withdraw takes the key from the withdrawal note, which does not exist yet: the console named the originals.
            say "dry run: withdraw would then delete on the server $REMOTE_APP/public/media/$1 and the originals named above, under $REMOTE_APP/var/media"
            ;;
        withdraw)
            prod_console app:crm:withdraw-consent "$@"
            # Once this commits, a rerun stops at "no venue": withdraw-media is the retry of the two steps below.
            remove_venue_media "$1"
            purge_cache
            ;;
        withdraw-media)
            remove_venue_media "$1"
            purge_cache
            ;;
        contacts-dry) prod_console app:crm:import-contacts --dry-run "$CONTAINER_ROOT/$1" ;;
        contacts) prod_console app:crm:import-contacts "$CONTAINER_ROOT/$1" ;;
    esac
}

main "$@"
