{# The card rows of templates/emails/layout.html.twig. Each macro emits one <tr> for the layout's content table; styles are inline. hl-btn and aria-hidden="true" also tell EmailHtmlToTextConverter what to do with a row, and a fact is one cell so its text part reads "label: value". #}

{% macro greeting(text) %}
<tr><td class="hl-pad" style="padding-left:40px;padding-right:40px;padding-top:36px;padding-bottom:16px;"><h1 class="hl-h" style="margin:0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:24px;line-height:32px;mso-line-height-rule:exactly;font-weight:700;color:#262b3f;">{{ text }}</h1></td></tr>
{% endmacro %}

{% macro p(text) %}
<tr><td class="hl-pad hl-p" style="padding-left:40px;padding-right:40px;padding-bottom:16px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:16px;line-height:26px;mso-line-height-rule:exactly;color:#262b3f;">{{ text }}</td></tr>
{% endmacro %}

{# Already rendered HTML, printed raw: only MarkdownRenderer output goes in, which escapes raw HTML and drops unsafe links. Everything else goes through p or quote. #}
{% macro rich(html) %}
<tr><td class="hl-pad hl-p" style="padding-left:40px;padding-right:40px;padding-top:28px;padding-bottom:16px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:16px;line-height:26px;mso-line-height-rule:exactly;color:#262b3f;">{{ html|raw }}</td></tr>
{% endmacro %}

{% macro button(label, url) %}
<tr><td class="hl-pad" style="padding-left:40px;padding-right:40px;padding-top:12px;padding-bottom:12px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="#3a3fb0" style="background:#3a3fb0;border-radius:999px;mso-padding-alt:14px 32px;"><a href="{{ url }}" class="hl-btn" style="display:inline-block;padding:14px 32px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:16px;line-height:20px;mso-line-height-rule:exactly;font-weight:700;color:#ffffff;text-decoration:none;border-radius:999px;">{{ label }}</a></td></tr></table></td></tr>
{% endmacro %}

{% macro note(text) %}
<tr><td class="hl-pad hl-muted" style="padding-left:40px;padding-right:40px;padding-bottom:16px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:14px;line-height:22px;mso-line-height-rule:exactly;color:#5a6078;">{{ text }}</td></tr>
{% endmacro %}

{% macro rule() %}
<tr><td class="hl-pad" style="padding-left:40px;padding-right:40px;padding-top:8px;padding-bottom:20px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;"><tr><td class="hl-rule" height="1" bgcolor="#d8dcec" style="height:1px;line-height:1px;font-size:0;background:#d8dcec;">&#160;</td></tr></table></td></tr>
{% endmacro %}

{# rows: list of {label, value}, both already translated or formatted. #}
{% macro facts(rows) %}
<tr><td class="hl-pad" style="padding-left:40px;padding-right:40px;padding-bottom:16px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
{% for row in rows %}
<tr><td class="hl-p" style="padding-bottom:6px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:15px;line-height:22px;mso-line-height-rule:exactly;color:#262b3f;word-break:break-word;">{{ row.label }}: <strong>{{ row.value }}</strong></td></tr>
{% endfor %}
</table></td></tr>
{% endmacro %}

{# Free text from a person: escaped, line breaks kept. #}
{% macro quote(text) %}
<tr><td class="hl-pad" style="padding-left:40px;padding-right:40px;padding-bottom:16px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;"><tr><td class="hl-p" style="padding-left:16px;border-left:3px solid #3a3fb0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;font-size:16px;line-height:26px;mso-line-height-rule:exactly;color:#262b3f;word-break:break-word;">{{ text|nl2br }}</td></tr></table></td></tr>
{% endmacro %}
