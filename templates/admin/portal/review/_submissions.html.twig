{#
    The tab "Neue Locations" of the review queue. rows: list<PendingSubmissionRow>. Spam is a link: the CMS delete modal on
    the edit page does the deleting.
#}
{% embed 'admin/components/_table.html.twig' with {
    label: 'onboarding.queue.tab'|trans({}, 'portal'),
    id: 'review-submissions',
    columns: [
        {label: 'onboarding.queue.column.location'|trans({}, 'portal')},
        {label: 'onboarding.queue.column.place'|trans({}, 'portal')},
        {label: 'onboarding.queue.column.manager'|trans({}, 'portal')},
        {label: 'onboarding.queue.column.submitted'|trans({}, 'portal')},
    ],
    actions_label: 'review.column.actions'|trans({}, 'portal'),
    rows: rows,
} only %}
    {% block rows %}
        {% for row in rows %}
            {% embed 'admin/components/_table_row.html.twig' with {actions_column: true, row: row} only %}
                {% block cells %}
                    <td><a class="table__name" href="{{ path('admin_locations_edit', {number: row.number}) }}">{{ row.name }}</a></td>
                    <td>{{ row.place|trans }}</td>
                    <td>{{ row.managerEmail is null ? '—' : row.managerFirstName ~ ' ' ~ row.managerLastName }}</td>
                    <td class="muted">{{ row.submittedAt|swiss_date }}</td>
                {% endblock %}
                {% block actions %}
                    {# One form, so the actions sit side by side, as in the access requests. #}
                    <form method="post" action="{{ path('admin_portal_review_submission_accept', {number: row.number}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                        {{ include('admin/components/_button.html.twig', {
                            label: 'onboarding.queue.preview'|trans({}, 'portal'),
                            size: 'sm', variant: 'ghost', href: path('admin_locations_preview', {number: row.number}),
                        }, with_context = false) }}
                        {{ include('admin/components/_button.html.twig', {
                            label: 'onboarding.queue.accept'|trans({}, 'portal'),
                            size: 'sm', variant: 'primary', type: 'submit',
                        }, with_context = false) }}
                        {{ include('admin/components/_button.html.twig', {
                            label: 'onboarding.queue.reject'|trans({}, 'portal'),
                            size: 'sm', variant: 'ghost', href: path('admin_portal_review_submission_reject', {number: row.number}),
                        }, with_context = false) }}
                        {{ include('admin/components/_button.html.twig', {
                            label: 'onboarding.queue.spam'|trans({}, 'portal'),
                            size: 'sm', variant: 'ghost', href: path('admin_locations_edit', {number: row.number}),
                        }, with_context = false) }}
                    </form>
                {% endblock %}
            {% endembed %}
        {% endfor %}
    {% endblock %}
    {% block empty %}
        {{ include('admin/components/_empty.html.twig', {
            icon: 'shield',
            title: 'onboarding.queue.empty'|trans({}, 'portal'),
        }, with_context = false) }}
    {% endblock %}
{% endembed %}
