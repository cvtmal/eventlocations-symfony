{#-
    A record's timeline (CRM-3, CRM-4): the `timeline` island and its read-only fallback, the first page (P6) from the
    same props (`Crm\TimelineProps`). Include with `with_context = false`: props. The island knows the icons
    (`timeline/types.js`), so the fallback shows one for all. A body stays text: escaped here, by Vue in the island (D13).
-#}
{%- set labels = props.labels -%}
{%- set type_labels = {} -%}
{%- for type in props.types -%}
    {%- set type_labels = type_labels|merge({(type.code): type.label}) -%}
{%- endfor -%}
{%- set fallback -%}
    <section class="crm-timeline" aria-label="{{ labels.section }}">
        {%- if props.page.entries is empty -%}
            <p class="crm-side__empty">{{ labels.empty }}</p>
        {%- else -%}
            <ol class="timeline">
                {%- for entry in props.page.entries -%}
                    {#- occurredAt is Zurich's wall clock without a zone; swiss_date wants a moment. -#}
                    {%- set at = date(entry.occurredAt ~ ' Europe/Zurich') -%}
                    {%- set when = at|swiss_date ~ ', ' ~ at|date('H:i', 'Europe/Zurich') -%}
                    {%- if entry.stage -%}
                        {%- set sentence = entry.actorName ? labels.system[entry.type] : labels.dealStageChangedAnonymous -%}
                        {{ include('admin/components/_timeline_item.html.twig', {
                            variant: 'system',
                            icon: 'history',
                            title: sentence|replace({'__actor__': entry.actorName, '__deal__': entry.title, '__stage__': labels.stages[entry.stage] ?? entry.stage}),
                            meta: when,
                        }, with_context = false) }}
                    {%- elseif entry.kind == 'system' -%}
                        {{ include('admin/components/_timeline_item.html.twig', {
                            variant: 'system',
                            icon: 'history',
                            title: labels.system[entry.type]|replace({'__venue__': entry.venueName, '__tier__': labels.tiers[entry.tier] ?? ''}),
                            meta: entry.actorName ? entry.actorName ~ ' · ' ~ when : when,
                        }, with_context = false) }}
                    {%- elseif entry.type == 'inquiry' -%}
                        {#- `title` is the venue's name. Without JS the timeline is read-only, so no link. -#}
                        {%- set sentence = entry.inquiryCouple ? labels.inquiryEntry|replace({'__couple__': entry.inquiryCouple, '__venue__': entry.title}) : entry.title -%}
                        {{ include('admin/components/_timeline_item.html.twig', {
                            icon: 'history',
                            title: type_labels[entry.type] ?? entry.type,
                            meta: when,
                            body: entry.anonymised ? labels.anonymised : sentence,
                        }, with_context = false) }}
                    {%- elseif entry.type == 'email_sent' -%}
                        {#- `title` is the subject. A failed send says so here too: without JS there is no pill. -#}
                        {%- set failed = entry.email and entry.email.status == 'failed' -%}
                        {%- set type = failed ? labels.emailTitleFailed : (type_labels[entry.type] ?? entry.type) -%}
                        {{ include('admin/components/_timeline_item.html.twig', {
                            icon: 'history',
                            title: entry.actorName ? labels.by|replace({'__type__': type, '__actor__': entry.actorName}) : type,
                            meta: failed ? when ~ ' · ' ~ labels.emailStatusFailed : when,
                            body: entry.anonymised ? labels.anonymised : [entry.title, entry.body]|filter(v => v)|join("\n"),
                        }, with_context = false) }}
                    {%- else -%}
                        {%- set type = type_labels[entry.type] ?? entry.type -%}
                        {{ include('admin/components/_timeline_item.html.twig', {
                            icon: 'history',
                            title: entry.actorName ? labels.by|replace({'__type__': type, '__actor__': entry.actorName}) : type,
                            meta: when,
                            body: entry.anonymised ? labels.anonymised : entry.body,
                        }, with_context = false) }}
                    {%- endif -%}
                {%- endfor -%}
            </ol>
        {%- endif -%}
    </section>
{%- endset -%}
{{ admin_island('timeline', props, fallback) }}
