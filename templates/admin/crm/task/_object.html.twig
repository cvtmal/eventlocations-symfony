{#
    What a task is on, with a link: `Firma · Schloss Seeblick`, or for a deal `Deal · Seehotel Bellerive` with the
    deal's company (`Main.dc.html`) and a link to the deal; nothing for a task on no object. Include with
    `with_context = false`: task (TaskRow).
#}
{%- if task.companyId -%}
    {{- 'task.object.company'|trans({}, 'crm') }} · <a href="{{ path('admin_crm_companies_show', {id: task.companyId}) }}">{{ task.companyName }}</a>
{%- elseif task.dealId -%}
    {{- 'task.object.deal'|trans({}, 'crm') }} · <a href="{{ path('admin_crm_deals_show', {id: task.dealId}) }}">{{ task.dealCompanyName }}</a>
{%- endif -%}
