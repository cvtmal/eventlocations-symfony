{% extends 'admin/base.html.twig' %}

{% form_theme form 'admin/form/theme.html.twig' %}

{% block title %}{{ 'create.deal.title'|trans({}, 'crm') }} – {{ 'shell.backoffice'|trans({}, 'admin') }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumbs__item">{{ 'nav.section'|trans({}, 'crm') }}</li>
    <li class="breadcrumbs__item"><a href="{{ path('admin_crm_deals') }}">{{ 'list.deals.title'|trans({}, 'crm') }}</a></li>
    <li class="breadcrumbs__item" aria-current="page">{{ 'create.deal.title'|trans({}, 'crm') }}</li>
{% endblock %}

{% block page_header %}
    <div class="page-header"><h1>{{ 'create.deal.title'|trans({}, 'crm') }}</h1></div>
{% endblock %}

{% block main %}
    {{ form_start(form, {action: path('admin_crm_deals_new'), attr: {class: 'form', novalidate: 'novalidate'}}) }}
        {% embed 'admin/components/_card.html.twig' with {title: 'create.deal.company_card'|trans({}, 'crm'), id: 'create-deal-company-title', create_form: form} only %}
            {% block body %}
                <p class="muted">{{ 'create.deal.intro'|trans({}, 'crm') }}</p>
                <div class="crm-create__fields">
                    {{ form_row(create_form.company) }}
                </div>
            {% endblock %}
            {% block foot %}
                {{ include('admin/components/_button.html.twig', {label: 'create.deal.next'|trans({}, 'crm'), variant: 'primary', type: 'submit'}, with_context = false) }}
                {{ include('admin/components/_button.html.twig', {label: 'create.cancel'|trans({}, 'crm'), variant: 'ghost', href: path('admin_crm_deals')}, with_context = false) }}
            {% endblock %}
        {% endembed %}
    {{ form_end(form) }}
{% endblock %}
