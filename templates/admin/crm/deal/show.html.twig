{% extends 'admin/crm/_record_layout.html.twig' %}

{% form_theme stage_form 'admin/form/theme.html.twig' %}

{% set record_type = 'deal' %}
{% set record_id = deal.id %}
{% set record_title = deal.name %}
{% set list_route = 'admin_crm_deals' %}
{% set list_label = 'list.deals.title'|trans({}, 'crm') %}

{% block record_crumb %}<span data-crm-follow="name">{{ deal.name }}</span>{% endblock %}

{% block record_identity %}
    <h1 id="record-title" data-crm-follow="name">{{ deal.name }}</h1>
    <a class="crm-record__website" href="{{ path('admin_crm_companies_show', {id: deal.companyId}) }}">{{ deal.companyName }}</a>
    {{ include('admin/components/_pill.html.twig', {label: ('deal.stage.' ~ deal.stage)|trans({}, 'crm'), tone: crm_deal_tone(deal.stage)}, with_context = false) }}
{% endblock %}

{% block record_properties %}
    {{ form_start(stage_form, {attr: {class: 'form deal-stage-form', novalidate: 'novalidate'}}) }}
        {{ form_row(stage_form.stage) }}
        {{ form_row(stage_form.lostReason) }}
        {{ include('admin/components/_button.html.twig', {label: 'deal.record.stage_submit'|trans({}, 'crm'), variant: 'secondary', size: 'sm', type: 'submit'}, with_context = false) }}
    {{ form_end(stage_form) }}
    {{ include('admin/crm/_properties.html.twig', {
        fields: crm_deal_fields(deal, owners),
        url: path('admin_api_crm_deal_property', {id: deal.id}),
        id_prefix: 'deal',
    }, with_context = false) }}
    {% if deal.closedAt %}
        {{ include('admin/components/_property.html.twig', {label: 'deal.record.closed_on'|trans({}, 'crm'), value: deal.closedAt|swiss_date}, with_context = false) }}
    {% endif %}
    {{ include('admin/components/_property.html.twig', {label: 'record.created'|trans({}, 'crm'), value: deal.createdAt|swiss_date}, with_context = false) }}
{% endblock %}

{% block record_actions %}
    {%- if tier_offer -%}
        <li><button class="dropdown__item" type="button" commandfor="deal-tier" command="show-modal">{{ 'deal.tier.action'|trans({}, 'crm') }}</button></li>
    {%- endif -%}
    {%- if deal.renewable -%}
        <li><button class="dropdown__item" type="button" commandfor="deal-renew" command="show-modal">{{ 'deal.renew.action'|trans({}, 'crm') }}</button></li>
    {%- endif -%}
    {%- if delete_form -%}
        <li><button class="dropdown__item dropdown__item--danger" type="button" commandfor="deal-delete" command="show-modal">{{ 'deal.record.delete.action'|trans({}, 'crm') }}</button></li>
    {%- endif -%}
{% endblock %}

{% block record_dialogs %}
    {% if tier_offer %}
        {% embed 'admin/components/_modal.html.twig' with {
            id: 'deal-tier',
            title: 'deal.tier.title'|trans({}, 'crm'),
            close_label: 'deal.tier.close'|trans({}, 'crm'),
            deal: deal,
            offer: tier_offer,
        } only %}
            {% block body %}
                <form id="deal-tier-form" method="post" action="{{ path('admin_crm_deals_apply_tier', {id: deal.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                    <input type="hidden" name="expected" value="{{ offer.current.value }}">
                    <input type="hidden" name="return_to" value="{{ path('admin_crm_deals_show', {id: deal.id}) }}">
                    <p>{{ 'deal.tier.text'|trans({venue: offer.venueName, current: offer.current|trans, offered: offer.offered|trans}, 'crm') }}</p>
                </form>
            {% endblock %}
            {% block footer %}
                <form method="dialog"><button class="btn">{{ 'deal.tier.cancel'|trans({}, 'crm') }}</button></form>
                {{ include('admin/components/_button.html.twig', {label: 'deal.tier.confirm'|trans({}, 'crm'), variant: 'primary', type: 'submit', attributes: {form: 'deal-tier-form'}}, with_context = false) }}
            {% endblock %}
        {% endembed %}
    {% endif %}
    {% if deal.renewable %}
        {% embed 'admin/components/_modal.html.twig' with {
            id: 'deal-renew',
            title: 'deal.renew.title'|trans({}, 'crm'),
            close_label: 'deal.renew.close'|trans({}, 'crm'),
            deal: deal,
        } only %}
            {% block body %}
                <form id="deal-renew-form" method="post" action="{{ path('admin_crm_deals_renew', {id: deal.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                    <p>{{ 'deal.renew.text'|trans({}, 'crm') }}</p>
                </form>
            {% endblock %}
            {% block footer %}
                <form method="dialog"><button class="btn">{{ 'deal.renew.cancel'|trans({}, 'crm') }}</button></form>
                {{ include('admin/components/_button.html.twig', {label: 'deal.renew.confirm'|trans({}, 'crm'), variant: 'primary', type: 'submit', attributes: {form: 'deal-renew-form'}}, with_context = false) }}
            {% endblock %}
        {% endembed %}
    {% endif %}
    {% if delete_form %}
        {% embed 'admin/components/_modal.html.twig' with {
            id: 'deal-delete',
            title: 'deal.record.delete.title'|trans({}, 'crm'),
            close_label: 'deal.record.delete.close'|trans({}, 'crm'),
            danger: true,
            deal: deal,
            delete_form: delete_form,
        } only %}
            {% block body %}<p>{{ 'deal.record.delete.text'|trans({name: deal.name}, 'crm') }}</p>{% endblock %}
            {% block footer %}
                <form method="dialog"><button class="btn" autofocus>{{ 'deal.record.delete.cancel'|trans({}, 'crm') }}</button></form>
                {{ form_start(delete_form) }}
                    {{ include('admin/components/_button.html.twig', {label: 'deal.record.delete.confirm'|trans({}, 'crm'), variant: 'danger', type: 'submit'}, with_context = false) }}
                {{ form_end(delete_form) }}
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}

{% block record_center %}{{ include('admin/crm/_timeline.html.twig', {props: timeline}, with_context = false) }}{% endblock %}

{% block record_aside %}
    <section class="card crm-side" aria-labelledby="deal-company-title">
        <div class="card__head"><h2 id="deal-company-title">{{ 'deal.record.company.title'|trans({}, 'crm') }}</h2></div>
        <div class="card__body">
            <ul class="crm-side__list">
                <li class="crm-side__item">
                    <span class="crm-side__thumb">{{ admin_icon('building-2') }}</span>
                    <span class="crm-side__text"><a class="crm-side__link" href="{{ path('admin_crm_companies_show', {id: deal.companyId}) }}">{{ deal.companyName }}</a></span>
                </li>
            </ul>
        </div>
    </section>

    <section class="card crm-side" id="kontakte" aria-labelledby="deal-contacts-title">
        <div class="card__head">
            <h2 id="deal-contacts-title">{{ 'deal.record.contacts.title'|trans({}, 'crm') }} <span class="crm-side__count">({{ deal.contacts|length }})</span></h2>
        </div>
        <div class="card__body">
            {% if deal.contacts is empty %}
                <p class="crm-side__empty">{{ 'deal.record.contacts.empty'|trans({}, 'crm') }}</p>
            {% else %}
                <ul class="crm-side__list">
                    {% for contact in deal.contacts %}
                        <li class="crm-side__item">
                            {{ include('admin/components/_avatar.html.twig', {initials: contact.initials}, with_context = false) }}
                            <span class="crm-side__text">
                                <span class="crm-side__name">{{ contact.fullName }}</span>
                                {% if contact.position %}<span class="crm-side__detail">{{ contact.position }}</span>{% endif %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </section>

    <section class="card crm-side" id="location" aria-labelledby="deal-venue-title" data-crm-refresh="venue">
        <div class="card__head"><h2 id="deal-venue-title">{{ 'deal.record.venue.title'|trans({}, 'crm') }}</h2></div>
        <div class="card__body">
            {% if deal.venue %}
                <ul class="crm-side__list">
                    <li class="crm-side__item">
                        <span class="crm-side__thumb">{{ admin_icon('landmark') }}</span>
                        <span class="crm-side__text">
                            <a class="crm-side__link" href="{{ path('admin_locations_edit', {number: deal.venue.number}) }}">{{ deal.venue.name }}</a>
                            <span class="crm-side__detail">{{ deal.venue.tier|trans }}{% if deal.venue.place.isKnown %} · {{ deal.venue.place|trans }}{% endif %}</span>
                        </span>
                    </li>
                </ul>
            {% else %}
                <p class="crm-side__empty">{{ 'deal.record.venue.empty'|trans({}, 'crm') }}</p>
            {% endif %}
        </div>
    </section>

    {{ include('admin/crm/task/_card.html.twig', {tasks: tasks, return_to: path('admin_crm_deals_show', {id: deal.id})}, with_context = false) }}
{% endblock %}
