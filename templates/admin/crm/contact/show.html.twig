{% extends 'admin/crm/_record_layout.html.twig' %}

{% set record_type = 'contact' %}
{% set record_id = contact.id %}
{% set record_title = contact.fullName %}
{% set list_route = 'admin_crm_contacts' %}
{% set list_label = 'list.contacts.title'|trans({}, 'crm') %}

{% block record_actions %}
    {%- if erase_form -%}
        <li><a class="dropdown__item" href="{{ path('admin_crm_contacts_data_export', {id: contact.id}) }}">{{ 'record.export.action'|trans({}, 'crm') }}</a></li>
        <li><button class="dropdown__item dropdown__item--danger" type="button" commandfor="contact-erase" command="show-modal">{{ 'record.erase.action'|trans({}, 'crm') }}</button></li>
    {%- endif -%}
{% endblock %}

{% block record_dialogs %}
    {% if erase_form %}
        {% embed 'admin/components/_modal.html.twig' with {
            id: 'contact-erase',
            title: 'record.erase.title'|trans({}, 'crm'),
            close_label: 'record.erase.close'|trans({}, 'crm'),
            danger: true,
            contact: contact,
            erase_form: erase_form,
        } only %}
            {% block body %}<p>{{ 'record.erase.text'|trans({name: contact.fullName}, 'crm') }}</p><p>{{ 'record.erase.copies'|trans({}, 'crm') }}</p>{% endblock %}
            {% block footer %}
                <form method="dialog"><button class="btn" autofocus>{{ 'record.erase.cancel'|trans({}, 'crm') }}</button></form>
                {{ form_start(erase_form) }}
                    {{ include('admin/components/_button.html.twig', {label: 'record.erase.confirm'|trans({}, 'crm'), variant: 'danger', type: 'submit'}, with_context = false) }}
                {{ form_end(erase_form) }}
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}

{% block record_crumb %}<span data-crm-follow="first_name"{% if not contact.firstName %} hidden{% endif %}>{{ contact.firstName }}</span> <span data-crm-follow="last_name">{{ contact.lastName }}</span>{% endblock %}

{% block record_identity %}
    {{ include('admin/components/_avatar.html.twig', {initials: contact.initials, size: 56}, with_context = false) }}
    <h1 id="record-title"><span data-crm-follow="first_name"{% if not contact.firstName %} hidden{% endif %}>{{ contact.firstName }}</span> <span data-crm-follow="last_name">{{ contact.lastName }}</span></h1>
    <span class="muted" data-crm-follow="position"{% if not contact.position %} hidden{% endif %}>{{ contact.position }}</span>
    <span class="pill pill--{{ crm_tone(contact.kind) }}" data-crm-follow="kind" data-crm-tones="{{ crm_tones('kind')|json_encode }}">{{ contact.kind|trans }}</span>
{% endblock %}

{% block record_properties %}
    {{ include('admin/crm/_properties.html.twig', {
        fields: crm_contact_fields(contact, owners),
        url: path('admin_api_crm_contact_property', {id: contact.id}),
        id_prefix: 'contact',
    }, with_context = false) }}
    {{ include('admin/components/_property.html.twig', {label: 'record.created'|trans({}, 'crm'), value: contact.createdAt|swiss_date}, with_context = false) }}
{% endblock %}

{% block record_aside %}
    <section class="card crm-side" aria-labelledby="crm-company-title" data-crm-refresh="company">
        <div class="card__head">
            <h2 id="crm-company-title">{{ 'record.company.title'|trans({}, 'crm') }}</h2>
        </div>
        <div class="card__body">
            {% if contact.companyId %}
                <ul class="crm-side__list">
                    <li class="crm-side__item">
                        {{ include('admin/components/_avatar.html.twig', {initials: contact.companyInitials, square: true}, with_context = false) }}
                        <span class="crm-side__text">
                            <a class="crm-side__link" href="{{ path('admin_crm_companies_show', {id: contact.companyId}) }}">{{ contact.companyName }}</a>
                        </span>
                        {{ include('admin/components/_pill.html.twig', {label: contact.companyStage|trans, tone: crm_tone(contact.companyStage)}, with_context = false) }}
                    </li>
                </ul>
            {% else %}
                <p class="crm-side__empty">{{ 'record.company.empty'|trans({}, 'crm') }}</p>
            {% endif %}
        </div>
    </section>
{% endblock %}
