{% extends 'admin/base.html.twig' %}

{% form_theme form 'admin/form/theme.html.twig' %}

{% block title %}{{ 'list.contacts.title'|trans({}, 'crm') }} – {{ 'shell.backoffice'|trans({}, 'admin') }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumbs__item">{{ 'nav.section'|trans({}, 'crm') }}</li>
    <li class="breadcrumbs__item" aria-current="page">{{ 'list.contacts.title'|trans({}, 'crm') }}</li>
{% endblock %}

{% block page_header %}
    <div class="page-header">
        <div class="page-header__title">
            <h1>{{ 'list.contacts.title'|trans({}, 'crm') }} <span class="muted">{{ list.total|swiss_number }}</span></h1>
        </div>
        <div class="page-header__actions">
            {% block list_actions %}
                {% if is_granted('ROLE_ADMIN') %}
                    {{ include('admin/components/_button.html.twig', {label: 'list.export'|trans({}, 'crm'), variant: 'secondary', icon: 'download', href: path('admin_crm_contacts_export', app.request.query.all|filter((value, key) => key != 'page'))}, with_context = false) }}
                {% endif %}
            {% endblock %}
            {{ include('admin/components/_button.html.twig', {label: 'list.contacts.new'|trans({}, 'crm'), variant: 'primary', icon: 'plus', href: path('admin_crm_contacts_new')}, with_context = false) }}
        </div>
    </div>
{% endblock %}

{% block main %}
    {% set chips = [] %}
    {% if filter.q %}
        {% set label = 'list.chip.search'|trans({q: filter.q}, 'crm') %}
        {% set chips = chips|merge([{label: label, remove_href: admin_query_path({q: null}), remove_label: 'list.chip.remove'|trans({label: label}, 'crm')}]) %}
    {% endif %}
    {% if filter.kind %}
        {% set label = 'list.chip.kind'|trans({label: filter.kind|trans}, 'crm') %}
        {% set chips = chips|merge([{label: label, remove_href: admin_query_path({kind: null}), remove_label: 'list.chip.remove'|trans({label: label}, 'crm')}]) %}
    {% endif %}
    {% if filter.owner %}
        {% set owner_choice = form.owner.vars.choices|filter(choice => choice.value == filter.owner)|first %}
        {% set label = 'list.chip.owner'|trans({label: owner_choice ? owner_choice.label|trans : filter.owner}, 'crm') %}
        {% set chips = chips|merge([{label: label, remove_href: admin_query_path({owner: null}), remove_label: 'list.chip.remove'|trans({label: label}, 'crm')}]) %}
    {% endif %}

    {% do form.q.setRendered() %}
    {% embed 'admin/components/_filter_bar.html.twig' with {
        action: path('admin_crm_contacts'),
        id: 'contact-filter',
        search_value: filter.q,
        search_label: 'list.filter.search'|trans({}, 'crm'),
        search_placeholder: 'list.filter.search_contacts'|trans({}, 'crm'),
        submit_label: 'list.filter.submit'|trans({}, 'crm'),
        reset_href: chips is empty ? null : path('admin_crm_contacts'),
        reset_label: 'list.filter.reset'|trans({}, 'crm'),
        chips: chips,
        filter_form: form,
        sort: sort,
        dir: dir,
    } only %}
        {% block filters %}
            {% for field in ['kind', 'owner'] %}
                <label class="visually-hidden" for="{{ filter_form[field].vars.id }}">{{ filter_form[field].vars.label|trans({}, 'crm') }}</label>
                {{ form_widget(filter_form[field], {attr: {class: 'filter-bar__control'}}) }}
            {% endfor %}
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
        {% endblock %}
    {% endembed %}
    {% if form.vars.submitted and not form.vars.valid %}
        <p class="form-error" role="alert">{{ 'list.filter.invalid'|trans({}, 'crm') }}</p>
    {% endif %}

    {% embed 'admin/components/_table.html.twig' with {
        label: 'list.contacts.table_label'|trans({}, 'crm'),
        id: 'contact-list',
        columns: [
            {label: 'list.contacts.column.name'|trans({}, 'crm'), sort_key: 'name'},
            {label: 'list.contacts.column.kind'|trans({}, 'crm'), sort_key: 'kind'},
            {label: 'list.contacts.column.company'|trans({}, 'crm'), sort_key: 'company'},
            {label: 'list.contacts.column.email'|trans({}, 'crm'), sort_key: 'email'},
            {label: 'list.contacts.column.owner'|trans({}, 'crm')},
        ],
        sort: sort,
        dir: dir,
        list: list,
    } only %}
        {% block rows %}
            {% for row in list.rows %}
                {% embed 'admin/components/_table_row.html.twig' with {row: row} only %}
                    {% block cells %}
                        <td>
                            <div class="crm-list__name">
                                {{ include('admin/components/_avatar.html.twig', {initials: row.initials}, with_context = false) }}
                                <span class="crm-list__text">
                                    <a class="crm-list__link" href="{{ path('admin_crm_contacts_show', {id: row.id}) }}">{{ row.fullName }}</a>
                                    {% if row.position %}<span class="crm-list__detail">{{ row.position }}</span>{% endif %}
                                </span>
                            </div>
                        </td>
                        <td>{{ include('admin/components/_pill.html.twig', {label: row.kind|trans, tone: crm_tone(row.kind)}, with_context = false) }}</td>
                        <td>
                            {%- if row.companyId -%}
                                <a href="{{ path('admin_crm_companies_show', {id: row.companyId}) }}">{{ row.companyName }}</a>
                            {%- else -%}
                                —
                            {%- endif -%}
                        </td>
                        <td>{{ row.email ?? '—' }}</td>
                        <td>{{ row.ownerName ?? '—' }}</td>
                    {% endblock %}
                {% endembed %}
            {% endfor %}
        {% endblock %}
        {% block empty %}
            {{ include('admin/components/_empty.html.twig', {icon: 'users', title: 'list.contacts.empty.title'|trans({}, 'crm'), text: 'list.contacts.empty.text'|trans({}, 'crm')}, with_context = false) }}
        {% endblock %}
        {% block foot %}
            {{ include('admin/components/_pagination.html.twig', {
                page: list.page,
                last_page: list.lastPage,
                total: list.total,
                per_page: list.perPage,
                label: 'list.pagination.label'|trans({}, 'crm'),
                previous_label: 'list.pagination.previous'|trans({}, 'crm'),
                next_label: 'list.pagination.next'|trans({}, 'crm'),
            }, with_context = false) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
