{% extends 'admin/base.html.twig' %}

{% form_theme form 'admin/form/theme.html.twig' %}

{% block title %}{{ 'list.companies.title'|trans({}, 'crm') }} – {{ 'shell.backoffice'|trans({}, 'admin') }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumbs__item">{{ 'nav.section'|trans({}, 'crm') }}</li>
    <li class="breadcrumbs__item" aria-current="page">{{ 'list.companies.title'|trans({}, 'crm') }}</li>
{% endblock %}

{% block page_header %}
    <div class="page-header">
        <div class="page-header__title">
            <h1>{{ 'list.companies.title'|trans({}, 'crm') }} <span class="muted">{{ list.total|swiss_number }}</span></h1>
        </div>
        <div class="page-header__actions">
            {% block list_actions %}
                {% if unlinked_venues > 0 %}
                    <form method="post" action="{{ path('admin_crm_companies_bootstrap') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                        {{ include('admin/components/_button.html.twig', {label: 'bootstrap.action'|trans({count: unlinked_venues}, 'crm'), variant: 'secondary', icon: 'building-2', type: 'submit'}, with_context = false) }}
                    </form>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    {{ include('admin/components/_button.html.twig', {label: 'list.export'|trans({}, 'crm'), variant: 'secondary', icon: 'download', href: path('admin_crm_companies_export', app.request.query.all|filter((value, key) => key != 'page'))}, with_context = false) }}
                {% endif %}
            {% endblock %}
            {{ include('admin/components/_button.html.twig', {label: 'list.companies.new'|trans({}, 'crm'), variant: 'primary', icon: 'plus', href: path('admin_crm_companies_new')}, with_context = false) }}
        </div>
    </div>
{% endblock %}

{% block main %}
    {% set chips = [] %}
    {% if filter.q %}
        {% set label = 'list.chip.search'|trans({q: filter.q}, 'crm') %}
        {% set chips = chips|merge([{label: label, remove_href: admin_query_path({q: null}), remove_label: 'list.chip.remove'|trans({label: label}, 'crm')}]) %}
    {% endif %}
    {% if filter.stage %}
        {% set label = 'list.chip.stage'|trans({label: filter.stage|trans}, 'crm') %}
        {% set chips = chips|merge([{label: label, remove_href: admin_query_path({stage: null}), remove_label: 'list.chip.remove'|trans({label: label}, 'crm')}]) %}
    {% endif %}
    {% if filter.owner %}
        {% set owner_choice = form.owner.vars.choices|filter(choice => choice.value == filter.owner)|first %}
        {% set label = 'list.chip.owner'|trans({label: owner_choice ? owner_choice.label|trans : filter.owner}, 'crm') %}
        {% set chips = chips|merge([{label: label, remove_href: admin_query_path({owner: null}), remove_label: 'list.chip.remove'|trans({label: label}, 'crm')}]) %}
    {% endif %}
    {% if filter.venues %}
        {% set label = ('list.filter.venues_' ~ filter.venues)|trans({}, 'crm') %}
        {% set chips = chips|merge([{label: label, remove_href: admin_query_path({venues: null}), remove_label: 'list.chip.remove'|trans({label: label}, 'crm')}]) %}
    {% endif %}

    {% do form.q.setRendered() %}
    {% embed 'admin/components/_filter_bar.html.twig' with {
        action: path('admin_crm_companies'),
        id: 'company-filter',
        search_value: filter.q,
        search_label: 'list.filter.search'|trans({}, 'crm'),
        search_placeholder: 'list.filter.search_companies'|trans({}, 'crm'),
        submit_label: 'list.filter.submit'|trans({}, 'crm'),
        reset_href: chips is empty ? null : path('admin_crm_companies'),
        reset_label: 'list.filter.reset'|trans({}, 'crm'),
        chips: chips,
        filter_form: form,
        sort: sort,
        dir: dir,
    } only %}
        {% block filters %}
            {% for field in ['stage', 'owner', 'venues'] %}
                <label class="visually-hidden" for="{{ filter_form[field].vars.id }}">{{ filter_form[field].vars.label|trans({}, 'crm') }}</label>
                {{ form_widget(filter_form[field], {attr: {class: 'filter-bar__control'}}) }}
            {% endfor %}
            <input type="hidden" name="sort" value="{{ sort }}">
            <input type="hidden" name="dir" value="{{ dir }}">
        {% endblock %}
    {% endembed %}
    {% if form.vars.submitted and not form.vars.valid %}
        <p class="form-error" role="alert">{{ 'list.filter.invalid'|trans({}, 'crm') }}</p>
    {% endif %}

    {% embed 'admin/components/_table.html.twig' with {
        label: 'list.companies.table_label'|trans({}, 'crm'),
        id: 'company-list',
        columns: [
            {label: 'list.companies.column.company'|trans({}, 'crm'), sort_key: 'name'},
            {label: 'list.companies.column.stage'|trans({}, 'crm'), sort_key: 'stage'},
            {label: 'list.companies.column.owner'|trans({}, 'crm')},
            {label: 'list.companies.column.venues'|trans({}, 'crm'), sort_key: 'venues'},
            {label: 'list.companies.column.created'|trans({}, 'crm'), sort_key: 'created'},
        ],
        sort: sort,
        dir: dir,
        list: list,
    } only %}
        {% block rows %}
            {% for row in list.rows %}
                {% embed 'admin/components/_table_row.html.twig' with {row: row} only %}
                    {% block cells %}
                        <td>
                            <div class="crm-list__name">
                                {{ include('admin/components/_avatar.html.twig', {initials: row.initials, square: true}, with_context = false) }}
                                <span class="crm-list__text">
                                    <a class="crm-list__link" href="{{ path('admin_crm_companies_show', {id: row.id}) }}">{{ row.name }}</a>
                                    {% if row.website %}<span class="crm-list__detail">{{ row.website|replace({'https://': '', 'http://': ''})|trim('/', 'right') }}</span>{% endif %}
                                </span>
                            </div>
                        </td>
                        <td>{{ include('admin/components/_pill.html.twig', {label: row.stage|trans, tone: crm_tone(row.stage)}, with_context = false) }}</td>
                        <td>{{ row.ownerName ?? '—' }}</td>
                        <td>{{ row.venueCount|swiss_number }}</td>
                        <td class="muted">{{ row.createdAt|swiss_date }}</td>
                    {% endblock %}
                {% endembed %}
            {% endfor %}
        {% endblock %}
        {% block empty %}
            {{ include('admin/components/_empty.html.twig', {icon: 'building-2', title: 'list.companies.empty.title'|trans({}, 'crm'), text: 'list.companies.empty.text'|trans({}, 'crm')}, with_context = false) }}
        {% endblock %}
        {% block foot %}
            {{ include('admin/components/_pagination.html.twig', {
                page: list.page,
                last_page: list.lastPage,
                total: list.total,
                per_page: list.perPage,
                label: 'list.pagination.label'|trans({}, 'crm'),
                previous_label: 'list.pagination.previous'|trans({}, 'crm'),
                next_label: 'list.pagination.next'|trans({}, 'crm'),
            }, with_context = false) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
