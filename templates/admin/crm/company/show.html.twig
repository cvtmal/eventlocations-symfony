{% extends 'admin/crm/_record_layout.html.twig' %}

{% form_theme link_form 'admin/form/theme.html.twig' %}

{% set record_type = 'company' %}
{% set record_id = company.id %}
{% set record_title = company.name %}
{% set list_route = 'admin_crm_companies' %}
{% set list_label = 'list.companies.title'|trans({}, 'crm') %}

{% block record_crumb %}<span data-crm-follow="name">{{ company.name }}</span>{% endblock %}

{% block record_identity %}{{ include('admin/crm/company/_identity.html.twig', {company: company}, with_context = false) }}{% endblock %}

{% block record_properties %}{{ include('admin/crm/company/_properties.html.twig', {company: company, owners: owners}, with_context = false) }}{% endblock %}

{% block record_actions %}
    {%- if delete_form -%}
        <li><button class="dropdown__item dropdown__item--danger" type="button" commandfor="company-delete" command="show-modal">{{ 'record.delete.action'|trans({}, 'crm') }}</button></li>
    {%- endif -%}
{% endblock %}

{% block record_dialogs %}
    {% if company.venue is null %}
    {% embed 'admin/components/_modal.html.twig' with {
        id: 'link-venue',
        title: 'record.venues.link_title'|trans({}, 'crm'),
        close_label: 'record.venues.close'|trans({}, 'crm'),
        link_form: link_form,
    } only %}
        {% block body %}
            {{ form_start(link_form, {attr: {id: 'link-venue-form', class: 'form', novalidate: 'novalidate'}}) }}
                {{ form_row(link_form.venue, {help: 'record.venues.link_help'}) }}
            {{ form_end(link_form) }}
        {% endblock %}
        {% block footer %}
            <form method="dialog"><button class="btn">{{ 'record.venues.cancel'|trans({}, 'crm') }}</button></form>
            {{ include('admin/components/_button.html.twig', {label: 'record.venues.link_submit'|trans({}, 'crm'), variant: 'primary', type: 'submit', attributes: {form: 'link-venue-form'}}, with_context = false) }}
        {% endblock %}
    {% endembed %}
    {% endif %}
    {% embed 'admin/components/_modal.html.twig' with {
        id: 'contact-new',
        title: 'record.contacts.add_title'|trans({}, 'crm'),
        close_label: 'record.contacts.close'|trans({}, 'crm'),
        contact_form: contact_new_form,
    } only %}
        {% block body %}{{ include('admin/crm/company/_contact_form.html.twig', {form: contact_form, form_id: 'contact-new-form'}, with_context = false) }}{% endblock %}
        {% block footer %}
            <form method="dialog"><button class="btn">{{ 'record.contacts.cancel'|trans({}, 'crm') }}</button></form>
            {{ include('admin/components/_button.html.twig', {label: 'record.contacts.save'|trans({}, 'crm'), variant: 'primary', type: 'submit', attributes: {form: 'contact-new-form'}}, with_context = false) }}
        {% endblock %}
    {% endembed %}
    {% for contact in company.contacts %}
        {% embed 'admin/components/_modal.html.twig' with {
            id: 'contact-' ~ contact.id,
            title: 'record.contacts.edit_title'|trans({}, 'crm'),
            close_label: 'record.contacts.close'|trans({}, 'crm'),
            contact_form: contact_forms[contact.id],
            remove_action: path('admin_crm_companies_contacts_remove', {id: company.id, contactId: contact.id}),
            remove_token: remove_token,
            form_id: 'contact-' ~ contact.id ~ '-form',
        } only %}
            {% block body %}{{ include('admin/crm/company/_contact_form.html.twig', {form: contact_form, form_id: form_id}, with_context = false) }}{% endblock %}
            {% block footer %}
                <form class="crm-contact__remove" method="post" action="{{ remove_action }}">
                    <input type="hidden" name="_token" value="{{ csrf_token(remove_token) }}">
                    {{ include('admin/components/_button.html.twig', {label: 'record.contacts.remove'|trans({}, 'crm'), variant: 'danger', type: 'submit'}, with_context = false) }}
                </form>
                <form method="dialog"><button class="btn">{{ 'record.contacts.cancel'|trans({}, 'crm') }}</button></form>
                {{ include('admin/components/_button.html.twig', {label: 'record.contacts.save'|trans({}, 'crm'), variant: 'primary', type: 'submit', attributes: {form: form_id}}, with_context = false) }}
            {% endblock %}
        {% endembed %}
    {% endfor %}
    {% if delete_form %}
        {% embed 'admin/components/_modal.html.twig' with {
            id: 'company-delete',
            title: 'record.delete.title'|trans({}, 'crm'),
            close_label: 'record.delete.close'|trans({}, 'crm'),
            danger: true,
            company: company,
            delete_form: delete_form,
        } only %}
            {% block body %}<p>{{ 'record.delete.text'|trans({name: company.name}, 'crm') }}</p>{% endblock %}
            {% block footer %}
                <form method="dialog"><button class="btn" autofocus>{{ 'record.delete.cancel'|trans({}, 'crm') }}</button></form>
                {{ form_start(delete_form) }}
                    {{ include('admin/components/_button.html.twig', {label: 'record.delete.confirm'|trans({}, 'crm'), variant: 'danger', type: 'submit'}, with_context = false) }}
                {{ form_end(delete_form) }}
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}

{% block record_center %}{{ include('admin/crm/_timeline.html.twig', {props: timeline}, with_context = false) }}{% endblock %}

{% block record_aside %}
    <section class="card crm-side" id="locations" aria-labelledby="crm-venues-title">
        <div class="card__head">
            <h2 id="crm-venues-title">{{ 'record.venues.title'|trans({}, 'crm') }}</h2>
            {% if company.venue is null %}
                {{ include('admin/components/_button.html.twig', {
                    label: 'record.venues.link'|trans({}, 'crm'),
                    icon: 'plus',
                    variant: 'ghost',
                    size: 'sm',
                    type: 'button',
                    attributes: {commandfor: 'link-venue', command: 'show-modal', 'aria-label': 'record.venues.link_label'|trans({}, 'crm')},
                }, with_context = false) }}
            {% endif %}
        </div>
        <div class="card__body">
            {% set venue = company.venue %}
            {% if venue is null %}
                <p class="crm-side__empty">{{ 'record.venues.empty'|trans({}, 'crm') }}</p>
            {% else %}
                <ul class="crm-side__list">
                    <li class="crm-side__item">
                        <span class="crm-side__thumb">{{ admin_icon('landmark') }}</span>
                        <span class="crm-side__text">
                            <a class="crm-side__link" href="{{ path('admin_locations_edit', {number: venue.number}) }}">{{ venue.name }}</a>
                            <span class="crm-side__detail">{{ venue.tier|trans }}{% if venue.place.isKnown %} · {{ venue.place|trans }}{% endif %}</span>
                        </span>
                        <form class="crm-side__form" method="post" action="{{ path('admin_crm_companies_unlink_venue', {id: company.id, venueId: venue.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token(unlink_token) }}">
                            {{ include('admin/components/_button.html.twig', {
                                label: 'record.venues.unlink'|trans({}, 'crm'),
                                variant: 'ghost',
                                size: 'sm',
                                type: 'submit',
                                attributes: {'aria-label': 'record.venues.unlink_label'|trans({name: venue.name}, 'crm')},
                            }, with_context = false) }}
                        </form>
                    </li>
                </ul>
            {% endif %}
        </div>
    </section>

    <section class="card crm-side" id="kontakte" aria-labelledby="crm-contacts-title">
        <div class="card__head">
            <h2 id="crm-contacts-title">{{ 'record.contacts.title'|trans({}, 'crm') }} <span class="crm-side__count">({{ company.contacts|length }})</span></h2>
            {{ include('admin/components/_button.html.twig', {
                label: 'record.contacts.add'|trans({}, 'crm'),
                icon: 'plus',
                variant: 'ghost',
                size: 'sm',
                type: 'button',
                attributes: {commandfor: 'contact-new', command: 'show-modal', 'aria-label': 'record.contacts.add_label'|trans({}, 'crm')},
            }, with_context = false) }}
        </div>
        <div class="card__body">
            {% if company.contacts is empty %}
                <p class="crm-side__empty">{{ 'record.contacts.empty'|trans({}, 'crm') }}</p>
            {% else %}
                <ul class="crm-side__list">
                    {% for contact in company.contacts %}
                        <li class="crm-side__item">
                            {{ include('admin/components/_avatar.html.twig', {initials: contact.initials}, with_context = false) }}
                            <span class="crm-side__text">
                                <span class="crm-side__name">{{ contact.fullName }}</span>
                                {% if contact.position %}<span class="crm-side__detail">{{ contact.position }}</span>{% endif %}
                                {% if contact.email %}<a class="crm-side__detail crm-side__reach" href="mailto:{{ contact.email }}">{{ contact.email }}</a>{% endif %}
                                {% if contact.phone %}<a class="crm-side__detail crm-side__reach" href="tel:{{ contact.phone|replace({' ': ''}) }}">{{ contact.phone }}</a>{% endif %}
                            </span>
                            {{ include('admin/components/_button.html.twig', {
                                label: 'record.contacts.edit'|trans({}, 'crm'),
                                variant: 'ghost',
                                size: 'sm',
                                type: 'button',
                                attributes: {commandfor: 'contact-' ~ contact.id, command: 'show-modal', 'aria-label': 'record.contacts.edit_label'|trans({name: contact.fullName}, 'crm')},
                            }, with_context = false) }}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </section>

    {{ include('admin/crm/deal/_card.html.twig', {deals: deals, add_href: path('admin_crm_deals_new', {company: company.id}), all_href: path('admin_crm_companies_deals', {id: company.id})}, with_context = false) }}

    {{ include('admin/crm/task/_card.html.twig', {tasks: tasks, return_to: path('admin_crm_companies_show', {id: company.id})}, with_context = false) }}
{% endblock %}
