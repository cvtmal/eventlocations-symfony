{% extends 'admin/crm/_record_layout.html.twig' %}

{% set record_type = 'company' %}
{% set record_id = company.id %}
{% set record_title = company.name %}
{% set list_route = 'admin_crm_companies' %}
{% set list_label = 'list.companies.title'|trans({}, 'crm') %}

{% block record_crumb %}<span data-crm-follow="name">{{ company.name }}</span>{% endblock %}

{% block record_identity %}{{ include('admin/crm/company/_identity.html.twig', {company: company}, with_context = false) }}{% endblock %}

{# The quick actions open the timeline's composer, which this tab does not have. #}
{% block record_quick_actions %}{% endblock %}

{% block record_properties %}{{ include('admin/crm/company/_properties.html.twig', {company: company, owners: owners}, with_context = false) }}{% endblock %}

{% block record_center %}
    <div class="deal-tab__head">
        {{ include('admin/components/_button.html.twig', {label: 'deal.card.add'|trans({}, 'crm'), icon: 'plus', variant: 'secondary', size: 'sm', href: path('admin_crm_deals_new', {company: company.id})}, with_context = false) }}
    </div>
    {% embed 'admin/components/_table.html.twig' with {
        label: 'record.tab.deals'|trans({}, 'crm'),
        columns: [
            {label: 'deal.card.table.name'|trans({}, 'crm')},
            {label: 'deal.card.table.stage'|trans({}, 'crm')},
            {label: 'deal.card.table.venue'|trans({}, 'crm')},
            {label: 'deal.card.table.amount'|trans({}, 'crm')},
            {label: 'deal.card.table.contract_end'|trans({}, 'crm')},
        ],
        deals: deals,
    } only %}
        {% block rows %}
            {% for deal in deals %}
                {% embed 'admin/components/_table_row.html.twig' with {deal: deal} only %}
                    {% block cells %}
                        <td><a class="crm-list__link" href="{{ path('admin_crm_deals_show', {id: deal.id}) }}">{{ deal.name }}</a></td>
                        <td>{{ include('admin/components/_pill.html.twig', {label: ('deal.stage.' ~ deal.stage)|trans({}, 'crm'), tone: crm_deal_tone(deal.stage)}, with_context = false) }}</td>
                        <td>{{ deal.venueName ?? '—' }}</td>
                        <td>{{ deal.amountRappen is null ? '—' : deal.amountRappen|chf }}</td>
                        <td class="muted">{{ deal.contractEndOn ? deal.contractEndOn|swiss_date : '—' }}</td>
                    {% endblock %}
                {% endembed %}
            {% endfor %}
        {% endblock %}
        {% block empty %}
            {{ include('admin/components/_empty.html.twig', {icon: 'square-kanban', title: 'deal.card.empty'|trans({}, 'crm')}, with_context = false) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
