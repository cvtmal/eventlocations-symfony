        {{ include('admin/components/_tabs.html.twig', {
            label: 'ui.styleguide.sample.status_label'|trans({}, 'admin'),
            items: [
                {label: 'ui.styleguide.sample.tab_all'|trans({}, 'admin'), href: path('admin_styleguide'), count: 1758, active: true},
                {label: 'ui.styleguide.sample.tab_published'|trans({}, 'admin'), href: path('admin_styleguide'), count: 742},
                {label: 'ui.styleguide.sample.tab_draft'|trans({}, 'admin'), href: path('admin_styleguide'), count: 16, tone: 'pink'},
            ],
        }, with_context = false) }}
    </div>
</section>

{{ sg.section_open('record-tabs', 'record_tabs') }}
    <div class="card__body">
        {{ include('admin/components/_record_tabs.html.twig', {
            label: 'ui.styleguide.sample.sections_label'|trans({}, 'admin'),
            current_route: 'admin_styleguide',
            tabs: [
                {label: t('ui.styleguide.sample.tab_overview', {}, 'admin'), route: 'admin_styleguide', routeParameters: {}},
                {label: t('ui.styleguide.sample.tab_photos', {}, 'admin'), route: 'admin_audit_log', routeParameters: {}},
                {label: t('ui.styleguide.sample.tab_rooms', {}, 'admin'), route: 'admin_users', routeParameters: {}},
            ],
        }, with_context = false) }}
    </div>
</section>

<div class="card table-card" data-component="record-header">
    {% embed 'admin/components/_record_header.html.twig' with {
        title: 'ui.styleguide.sample.venue'|trans({}, 'admin'),
        subtitle: 'ui.styleguide.sample.detail'|trans({}, 'admin'),
    } only %}
        {% block media %}<span class="record-header__placeholder">{{ admin_icon('landmark') }}</span>{% endblock %}
        {% block meta %}
            {{ include('admin/components/_tier_badge.html.twig', {tier: 'beliebte_location', label: 'tier.beliebte_location'|trans({}, 'venues')}, with_context = false) }}
            {{ include('admin/components/_pill.html.twig', {label: 'styleguide.pill_green'|trans({}, 'admin'), tone: 'green', dot: true}, with_context = false) }}
        {% endblock %}
        {% block actions %}
            {{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.open'|trans({}, 'admin')}, with_context = false) }}
            {{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.more'|trans({}, 'admin'), icon: 'ellipsis', icon_only: true}, with_context = false) }}
        {% endblock %}
        {% block tabs %}
            {{ include('admin/components/_record_tabs.html.twig', {
                label: 'ui.styleguide.sample.sections_label'|trans({}, 'admin'),
                current_route: 'admin_styleguide',
                tabs: [{label: t('ui.styleguide.sample.tab_overview', {}, 'admin'), route: 'admin_styleguide', routeParameters: {}}],
            }, with_context = false) }}
        {% endblock %}
    {% endembed %}
</div>

{{ sg.section_open('property', 'property') }}
    <div class="card__body">
        {{ include('admin/components/_property.html.twig', {label: 'ui.styleguide.sample.property_label'|trans({}, 'admin'), value: 'ui.styleguide.sample.property_value'|trans({}, 'admin'), edit_href: path('admin_styleguide'), edit_label: 'ui.styleguide.sample.edit'|trans({}, 'admin')}, with_context = false) }}
        {{ include('admin/components/_property.html.twig', {label: 'ui.styleguide.sample.column_town'|trans({}, 'admin'), value: 'ui.styleguide.sample.town'|trans({}, 'admin')}, with_context = false) }}
    </div>
</section>

{{ sg.section_open('modal', 'modal') }}
    <div class="card__body styleguide__row">
        {{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.modal_open'|trans({}, 'admin'), attributes: {commandfor: 'sg-modal', command: 'show-modal'}}, with_context = false) }}
        {{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.confirm_open'|trans({}, 'admin'), variant: 'danger', attributes: {commandfor: 'sg-confirm', command: 'show-modal'}}, with_context = false) }}
        {% embed 'admin/components/_modal.html.twig' with {id: 'sg-modal', title: 'ui.styleguide.sample.modal_title'|trans({}, 'admin'), close_label: 'ui.styleguide.sample.close'|trans({}, 'admin')} only %}
            {% block body %}<p>{{ 'ui.styleguide.sample.modal_body'|trans({}, 'admin') }}</p>{% endblock %}
            {% block footer %}
                <form method="dialog">{{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.cancel'|trans({}, 'admin'), type: 'submit'}, with_context = false) }}</form>
                <form method="dialog">{{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.save'|trans({}, 'admin'), variant: 'primary', type: 'submit'}, with_context = false) }}</form>
            {% endblock %}
        {% endembed %}
        {% embed 'admin/components/_modal.html.twig' with {id: 'sg-confirm', title: 'ui.styleguide.sample.confirm_title'|trans({}, 'admin'), close_label: 'ui.styleguide.sample.close'|trans({}, 'admin'), danger: true} only %}
            {% block body %}<p>{{ 'ui.styleguide.sample.confirm_body'|trans({}, 'admin') }}</p>{% endblock %}
            {% block footer %}
                <form method="dialog">{{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.cancel'|trans({}, 'admin'), type: 'submit', attributes: {autofocus: 'autofocus'}}, with_context = false) }}</form>
                <form method="dialog">{{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.delete'|trans({}, 'admin'), variant: 'danger', type: 'submit'}, with_context = false) }}</form>
            {% endblock %}
        {% endembed %}
    </div>
</section>

{{ sg.section_open('drawer', 'drawer') }}
    <div class="card__body">
        {{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.drawer_open'|trans({}, 'admin'), attributes: {commandfor: 'sg-drawer', command: 'show-modal'}}, with_context = false) }}
        {% embed 'admin/components/_drawer.html.twig' with {id: 'sg-drawer', title: 'ui.styleguide.sample.drawer_title'|trans({}, 'admin'), close_label: 'ui.styleguide.sample.close'|trans({}, 'admin')} only %}
            {% block body %}<p>{{ 'ui.styleguide.sample.drawer_body'|trans({}, 'admin') }}</p>{% endblock %}
            {% block footer %}
                <form method="dialog">{{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.save'|trans({}, 'admin'), variant: 'primary', type: 'submit'}, with_context = false) }}</form>
            {% endblock %}
        {% endembed %}
    </div>
</section>

{{ sg.section_open('dropdown', 'dropdown') }}
    <div class="card__body">
        {% embed 'admin/components/_dropdown.html.twig' with {id: 'sg-menu', label: 'ui.styleguide.sample.actions'|trans({}, 'admin'), icon: 'chevron-down', icon_only: false, variant: 'secondary'} only %}
            {% block items %}
                <li><a class="dropdown__item" href="{{ path('admin_styleguide') }}">{{ 'ui.styleguide.sample.edit'|trans({}, 'admin') }}</a></li>
                <li><a class="dropdown__item" href="{{ path('admin_styleguide') }}">{{ 'ui.styleguide.sample.open'|trans({}, 'admin') }}</a></li>
                <li><button class="dropdown__item dropdown__item--danger" type="button">{{ 'ui.styleguide.sample.delete'|trans({}, 'admin') }}</button></li>
            {% endblock %}
        {% endembed %}
    </div>
</section>

{{ sg.section_open('toast', 'toast') }}
    <div class="card__body styleguide__row">
        <div class="toast toast--success">
            {{ admin_icon('check') }}
            <span class="toast__message">{{ 'ui.styleguide.sample.toast_success'|trans({}, 'admin') }}</span>
            <button class="toast__dismiss" type="button" aria-label="{{ 'ui.styleguide.sample.dismiss'|trans({}, 'admin') }}">{{ admin_icon('x') }}</button>
        </div>
        <div class="toast toast--error">
            {{ admin_icon('x') }}
            <span class="toast__message">{{ 'ui.styleguide.sample.toast_error'|trans({}, 'admin') }}</span>
            <button class="toast__dismiss" type="button" aria-label="{{ 'ui.styleguide.sample.dismiss'|trans({}, 'admin') }}">{{ admin_icon('x') }}</button>
        </div>
    </div>
</section>

{{ form_start(form, {attr: {class: 'styleguide__stack', novalidate: 'novalidate'}}) }}
    {{ sg.section_open('combobox', 'combobox') }}
        <div class="card__body form-grid">
            {{ form_row(form.town) }}
            {{ form_row(form.owner) }}
        </div>
    </section>

    {{ sg.section_open('date-input', 'date_input') }}
        <div class="card__body">{{ form_row(form.date) }}</div>
    </section>

    {{ sg.section_open('money-input', 'money_input') }}
        <div class="card__body">{{ form_row(form.amount) }}</div>
    </section>

    {{ sg.section_open('markdown', 'markdown') }}
        <div class="card__body">{{ form_row(form.description) }}</div>
    </section>

    {{ sg.section_open('form', 'form') }}
        <div class="card__body form-grid">
            <div class="field--wide">{{ include('admin/components/_required_hint.html.twig', with_context = false) }}</div>
            {{ form_row(form.name, {row_attr: {class: 'field--wide'}}) }}
            {{ form_row(form.street) }}
            {{ form_row(form.daylight) }}
            {{ form_row(form.summary, {row_attr: {class: 'field--wide'}}) }}
            {{ form_row(form.setting) }}
            {{ form_row(form.newsletter) }}
        </div>
    </section>
{{ form_end(form) }}

{{ sg.section_open('form-errors', 'form_errors') }}
    <div class="card__body">
        {{ form_start(invalid_form, {attr: {class: 'form-grid', novalidate: 'novalidate'}}) }}
            <div class="field--wide">{{ form_errors(invalid_form) }}</div>
            {{ form_row(invalid_form.name) }}
            {{ form_row(invalid_form.summary) }}
            {{ form_rest(invalid_form) }}
        {{ form_end(invalid_form) }}
    </div>
</section>

{{ sg.section_open('dropzone', 'dropzone') }}
    <div class="card__body">
        {{ include('admin/components/_dropzone.html.twig', {id: 'sg-dropzone', name: 'files[]', label: 'ui.styleguide.sample.dropzone_label'|trans({}, 'admin'), hint: 'ui.styleguide.sample.dropzone_hint'|trans({}, 'admin'), accept: 'image/*', multiple: true}, with_context = false) }}
    </div>
</section>

