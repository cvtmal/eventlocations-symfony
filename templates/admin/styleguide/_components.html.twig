{#- One section per kit component with every variant (#23, S11). `ComponentStyleguideTest` lists the data-component names. -#}
{% form_theme form 'admin/form/theme.html.twig' %}
{% form_theme invalid_form 'admin/form/theme.html.twig' %}

{% macro section_open(name, key) %}
    <section class="card" data-component="{{ name }}" aria-labelledby="sg-c-{{ name }}">
        <div class="card__head"><h2 id="sg-c-{{ name }}">{{ ('ui.styleguide.section.' ~ key)|trans({}, 'admin') }}</h2></div>
{% endmacro %}

{% import _self as sg %}

{{ sg.section_open('button', 'button') }}
    <div class="card__body styleguide__stack">
        <div class="styleguide__row">
            {{ include('admin/components/_button.html.twig', {label: 'styleguide.button_primary'|trans({}, 'admin'), variant: 'primary'}, with_context = false) }}
            {{ include('admin/components/_button.html.twig', {label: 'styleguide.button_secondary'|trans({}, 'admin')}, with_context = false) }}
            {{ include('admin/components/_button.html.twig', {label: 'styleguide.button_ghost'|trans({}, 'admin'), variant: 'ghost'}, with_context = false) }}
            {{ include('admin/components/_button.html.twig', {label: 'styleguide.button_danger'|trans({}, 'admin'), variant: 'danger'}, with_context = false) }}
            {{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.more'|trans({}, 'admin'), icon: 'ellipsis', icon_only: true}, with_context = false) }}
        </div>
        <div class="styleguide__row">
            {{ include('admin/components/_button.html.twig', {label: 'styleguide.button_primary'|trans({}, 'admin'), variant: 'primary', icon: 'plus'}, with_context = false) }}
            {{ include('admin/components/_button.html.twig', {label: 'styleguide.button_small'|trans({}, 'admin'), size: 'sm'}, with_context = false) }}
            {{ include('admin/components/_button.html.twig', {label: 'styleguide.button_small'|trans({}, 'admin'), size: 'xs', variant: 'ghost'}, with_context = false) }}
            {{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.more'|trans({}, 'admin'), icon: 'ellipsis', icon_only: true, size: 'sm'}, with_context = false) }}
            {{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.open'|trans({}, 'admin'), href: path('admin_styleguide')}, with_context = false) }}
            {{ include('admin/components/_button.html.twig', {label: 'styleguide.button_secondary'|trans({}, 'admin'), attributes: {'aria-disabled': 'true'}}, with_context = false) }}
        </div>
    </div>
</section>

{{ sg.section_open('pill', 'pill') }}
    <div class="card__body styleguide__stack">
        <div class="styleguide__row">
            {% for tone, key in {green: 'pill_green', grey: 'pill_grey', pink: 'pill_pink', blue: 'pill_blue', amber: 'pill_amber', red: 'pill_red', dark: 'pill_dark'} %}
                {{ include('admin/components/_pill.html.twig', {label: ('styleguide.' ~ key)|trans({}, 'admin'), tone: tone}, with_context = false) }}
            {% endfor %}
        </div>
        <div class="styleguide__row">
            {{ include('admin/components/_pill.html.twig', {label: 'styleguide.pill_green'|trans({}, 'admin'), tone: 'green', dot: true}, with_context = false) }}
            {{ include('admin/components/_pill.html.twig', {label: 'styleguide.pill_grey'|trans({}, 'admin'), dot: true}, with_context = false) }}
        </div>
    </div>
</section>

{{ sg.section_open('tier-badge', 'tier_badge') }}
    <div class="card__body styleguide__row">
        {% for tier in ['beliebte_location', 'empfehlung', 'top_premium', 'premium', 'basic'] %}
            {{ include('admin/components/_tier_badge.html.twig', {tier: tier, label: ('tier.' ~ tier)|trans({}, 'venues')}, with_context = false) }}
        {% endfor %}
    </div>
</section>

{{ sg.section_open('avatar', 'avatar') }}
    <div class="card__body styleguide__row">
        {{ include('admin/components/_avatar.html.twig', {initials: 'AK', size: 24}, with_context = false) }}
        {{ include('admin/components/_avatar.html.twig', {initials: 'AK'}, with_context = false) }}
        {{ include('admin/components/_avatar.html.twig', {initials: 'AK', size: 56}, with_context = false) }}
        {{ include('admin/components/_avatar.html.twig', {initials: 'SE', square: true}, with_context = false) }}
        {{ include('admin/components/_avatar.html.twig', {initials: 'AK', size: 24, label: 'ui.styleguide.sample.deal_owner'|trans({}, 'admin')}, with_context = false) }}
    </div>
</section>

<div data-component="card">
    {% embed 'admin/components/_card.html.twig' with {title: 'ui.styleguide.section.card'|trans({}, 'admin'), id: 'sg-c-card'} only %}
        {% block actions %}{{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.edit'|trans({}, 'admin'), size: 'sm'}, with_context = false) }}{% endblock %}
        {% block body %}<p>{{ 'styleguide.text_sample'|trans({}, 'admin') }}</p>{% endblock %}
        {% block foot %}{{ include('admin/components/_button.html.twig', {label: 'ui.styleguide.sample.save'|trans({}, 'admin'), variant: 'primary'}, with_context = false) }}{% endblock %}
    {% endembed %}
</div>

<div class="styleguide__section" data-component="table">
    <h2>{{ 'ui.styleguide.section.table'|trans({}, 'admin') }}</h2>
    {% embed 'admin/components/_table.html.twig' with {
        label: 'ui.styleguide.sample.table_label'|trans({}, 'admin'),
        columns: [
            {label: 'ui.styleguide.sample.column_venue'|trans({}, 'admin'), sort_key: 'name'},
            {label: 'ui.styleguide.sample.column_town'|trans({}, 'admin'), sort_key: 'town'},
            {label: 'ui.styleguide.sample.column_guests'|trans({}, 'admin')},
        ],
        sort: 'name',
        dir: 'asc',
        select_label: 'ui.styleguide.sample.selection'|trans({}, 'admin'),
        actions_label: 'ui.styleguide.sample.actions'|trans({}, 'admin'),
    } only %}
        {% block rows %}
            {% for number in [1042, 1043] %}
                {% embed 'admin/components/_table_row.html.twig' with {select_name: 'venue[]', select_value: number, select_label: 'ui.styleguide.sample.select_row'|trans({}, 'admin') ~ ' ' ~ number, actions_column: true, number: number} only %}
                    {% block cells %}
                        <td><a class="table__name" href="{{ path('admin_styleguide') }}">{{ 'ui.styleguide.sample.venue'|trans({}, 'admin') }}</a></td>
                        <td>{{ 'ui.styleguide.sample.town'|trans({}, 'admin') }}</td>
                        <td>{{ swiss_range(40, 220) }}</td>
                    {% endblock %}
                    {% block actions %}
                        {% embed 'admin/components/_dropdown.html.twig' with {id: 'sg-row-menu-' ~ number, label: 'ui.styleguide.sample.menu_label'|trans({}, 'admin')} only %}
                            {% block items %}
                                <li><a class="dropdown__item" href="{{ path('admin_styleguide') }}">{{ 'ui.styleguide.sample.edit'|trans({}, 'admin') }}</a></li>
                                <li><button class="dropdown__item dropdown__item--danger" type="button">{{ 'ui.styleguide.sample.delete'|trans({}, 'admin') }}</button></li>
                            {% endblock %}
                        {% endembed %}
                    {% endblock %}
                {% endembed %}
            {% endfor %}
        {% endblock %}
        {% block foot %}
            {{ include('admin/components/_pagination.html.twig', {
                page: 3, last_page: 12, total: 574, per_page: 50,
                label: 'ui.styleguide.sample.pagination_label'|trans({}, 'admin'),
                previous_label: 'ui.styleguide.sample.previous'|trans({}, 'admin'),
                next_label: 'ui.styleguide.sample.next'|trans({}, 'admin'),
            }, with_context = false) }}
        {% endblock %}
    {% endembed %}
    {% embed 'admin/components/_table.html.twig' with {
        label: 'ui.styleguide.sample.table_label'|trans({}, 'admin'),
        columns: [{label: 'ui.styleguide.sample.column_venue'|trans({}, 'admin')}, {label: 'ui.styleguide.sample.column_town'|trans({}, 'admin')}],
    } only %}
        {% block empty %}
            {{ include('admin/components/_empty.html.twig', {icon: 'search', title: 'ui.styleguide.sample.empty_title'|trans({}, 'admin'), text: 'ui.styleguide.sample.empty_text'|trans({}, 'admin')}, with_context = false) }}
        {% endblock %}
    {% endembed %}
</div>

{{ sg.section_open('pagination', 'pagination') }}
    <div class="card__body">
        {{ include('admin/components/_pagination.html.twig', {
            page: 1, last_page: 3, total: 120, per_page: 50,
            label: 'ui.styleguide.sample.pagination_label'|trans({}, 'admin'),
            previous_label: 'ui.styleguide.sample.previous'|trans({}, 'admin'),
            next_label: 'ui.styleguide.sample.next'|trans({}, 'admin'),
        }, with_context = false) }}
    </div>
</section>

{{ sg.section_open('filter-bar', 'filter_bar') }}
    <div class="card__body">
        {% embed 'admin/components/_filter_bar.html.twig' with {
            action: path('admin_styleguide'),
            id: 'sg-filter',
            search_label: 'ui.styleguide.sample.search'|trans({}, 'admin'),
            search_placeholder: 'ui.styleguide.sample.search_placeholder'|trans({}, 'admin'),
            submit_label: 'ui.styleguide.sample.filter'|trans({}, 'admin'),
            reset_href: path('admin_styleguide'),
            reset_label: 'ui.styleguide.sample.reset_filters'|trans({}, 'admin'),
            chips: [{
                label: 'ui.styleguide.sample.canton_chip'|trans({}, 'admin'),
                remove_href: path('admin_styleguide'),
                remove_label: 'ui.styleguide.sample.remove_filter'|trans({}, 'admin'),
            }],
        } only %}
            {% block filters %}
                <label class="visually-hidden" for="sg-filter-canton">{{ 'ui.styleguide.sample.canton'|trans({}, 'admin') }}</label>
                <select class="filter-bar__control" id="sg-filter-canton" name="canton">
                    <option value="">{{ 'ui.styleguide.sample.all_cantons'|trans({}, 'admin') }}</option>
                    <option value="zh" selected>{{ 'ui.styleguide.sample.canton_zh'|trans({}, 'admin') }}</option>
                    <option value="be">{{ 'ui.styleguide.sample.canton_be'|trans({}, 'admin') }}</option>
                </select>
            {% endblock %}
        {% endembed %}
    </div>
</section>

{{ sg.section_open('tabs', 'tabs') }}
