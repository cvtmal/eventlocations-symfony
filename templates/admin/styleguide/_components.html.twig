            {{ include('admin/components/_timeline_item.html.twig', {variant: 'system', icon: 'history', title: 'ui.styleguide.sample.timeline_system'|trans({}, 'admin'), meta: 'ui.styleguide.sample.timeline_meta'|trans({}, 'admin')}, with_context = false) }}
