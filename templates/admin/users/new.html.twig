{% extends 'admin/base.html.twig' %}

{% form_theme form 'admin/form/theme.html.twig' %}

{% block title %}{{ 'users.new'|trans({}, 'admin') }} – {{ 'shell.backoffice'|trans({}, 'admin') }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumbs__item"><a href="{{ path('admin_users') }}">{{ 'users.title'|trans({}, 'admin') }}</a></li>
    <li class="breadcrumbs__item" aria-current="page">{{ 'users.new'|trans({}, 'admin') }}</li>
{% endblock %}

{% block page_header %}
    <div class="page-header"><h1>{{ 'users.new'|trans({}, 'admin') }}</h1></div>
{% endblock %}

{% block main %}
    <div class="card card__body">
        {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
            {{ include('admin/components/_required_hint.html.twig', with_context = false) }}
            {{ form_row(form.email) }}
            {{ form_row(form.displayName) }}
            {{ form_row(form.role) }}
            {{ form_row(form.plainPassword.first) }}
            {{ form_row(form.plainPassword.second) }}
            <div><button class="btn btn--primary" type="submit">{{ 'users.form.create'|trans({}, 'admin') }}</button></div>
        {{ form_end(form) }}
    </div>
{% endblock %}
