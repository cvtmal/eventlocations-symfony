{#
    Preview of a venue's public page (CMS-9): the public detail template, published or not, with a banner above the
    hero. Nothing here may reach a search engine or a guest: no canonical, hreflang, JSON-LD or social tags, robots
    `noindex` (the `/admin` response headers say the same), and a note in place of the inquiry form and of Google's
    rating (#53). It loads the
    public `app.css`, so the banner is styled by `venues/_preview-banner.scss` with `--c-*` tokens (P18).
    Optional context: back_url, the banner link's target (default: the staff editor).
#}
{% extends 'venues/detail/show.html.twig' %}

{% block title %}{{ 'preview.title'|trans({name: venue.name}, 'cms') }}{% endblock %}

{% block meta %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block canonical %}{% endblock %}

{% block hreflang %}{% endblock %}

{% block jsonld %}{% endblock %}

{# A staff or manager look is no visit (Wave G §4a.4). #}
{% block stats_beacon %}{% endblock %}

{% block hero %}
    <div class="preview-banner">
        <div class="preview-banner__inner container">
            <p class="preview-banner__text">{{ 'preview.banner'|trans({}, 'cms') }}</p>
            <a class="preview-banner__link" href="{{ back_url|default(path('admin_locations_edit', {number: venue.number})) }}">{{ 'preview.back'|trans({}, 'cms') }}</a>
        </div>
    </div>
    {{ parent() }}
{% endblock %}

{# Google's element never loads here (#53): the preview keeps the site CSP and names where the rating would be. #}
{% block google_rating %}{% if venue.googlePlaceId %}<p class="preview-banner__note">{{ (not venue_google_rating_enabled() ? 'preview.google_rating_off' : (venue.googleRatingHidden ? 'preview.google_rating_hidden' : 'preview.google_rating'))|trans({}, 'cms') }}</p>{% endif %}{% endblock %}

{# D12, places-photos: no Google call behind a login (/admin, /konto); the public page shows the photos. #}
{% block google_photos %}{% endblock %}

{% block inquiry %}<p class="preview-banner__note">{{ 'preview.inquiry_note'|trans({}, 'cms') }}</p>{% endblock %}
