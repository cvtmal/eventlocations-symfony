{#
    Preview of a venue's public page (CMS-9): the public detail template, published or not, with a banner above the
    hero. Nothing here may reach a search engine or a guest: no canonical, hreflang, JSON-LD or social tags, robots
    `noindex` (the `/admin` response headers say the same), and a note in place of the inquiry form. It loads the
    public `app.css`, so the banner is styled by `venues/_preview-banner.scss` with `--c-*` tokens (P18).
#}
{% extends 'venues/detail/show.html.twig' %}

{% block title %}{{ 'preview.title'|trans({name: venue.name}, 'cms') }}{% endblock %}

{% block meta %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block canonical %}{% endblock %}

{% block hreflang %}{% endblock %}

{% block jsonld %}{% endblock %}

{% block hero %}
    <div class="preview-banner">
        <div class="preview-banner__inner container">
            <p class="preview-banner__text">{{ 'preview.banner'|trans({}, 'cms') }}</p>
            <a class="preview-banner__link" href="{{ path('admin_locations_edit', {number: venue.number}) }}">{{ 'preview.back'|trans({}, 'cms') }}</a>
        </div>
    </div>
    {{ parent() }}
{% endblock %}

{% block inquiry %}<p class="preview-banner__note">{{ 'preview.inquiry_note'|trans({}, 'cms') }}</p>{% endblock %}
