{#
    Card "Bewertung". Include with `with_context = false`: form, card, number, stale.
#}
{% embed 'admin/cms/venue/_card_shell.html.twig' with {form: form, card: card, number: number, stale: stale} only %}
    {% block fields %}
        <div class="field-row">
            {{ form_row(form.score) }}
            {{ form_row(form.count) }}
        </div>
        {{ form_row(form.highlights) }}
    {% endblock %}
{% endembed %}
