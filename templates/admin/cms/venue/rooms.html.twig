{#
    The Räume tab (#25, CMS-5): the `room-editor` island. Context from `VenueRoomsController`: venue (VenueHeader),
    rooms (`ManagedRoom::toArray()` each), locale_codes, default_locale, id_placeholder (`VenueMediaApi::ID_PLACEHOLDER`,
    the `{id}` in the id endpoints that the island replaces), floor_materials and seating_types (enum cases, labelled
    from the `venues` catalogue here), name_max, description_max.
    Labels with `%name` tokens are filled in by the island (as UiSortableList's `movedLabel`).
#}
{% extends 'admin/cms/venue/_layout.html.twig' %}

{% set record_crumb = 'rooms.tab'|trans({}, 'cms') %}

{% block record_main %}
    {% set id_route = {number: venue.number, id: id_placeholder} %}
    {{ admin_island('room-editor', {
        rooms: rooms,
        locales: locale_codes|map(code => {code: code, label: ('editor.locale.' ~ code)|trans({}, 'cms')}),
        defaultLocale: default_locale,
        floorMaterials: floor_materials|map(material => {value: material.value, label: material|trans}),
        seatingTypes: seating_types|map(type => {value: type.value, label: type|trans}),
        nameMax: name_max,
        descriptionMax: description_max,
        idPlaceholder: id_placeholder,
        endpoints: {
            add: path('admin_api_cms_rooms_add', {number: venue.number}),
            order: path('admin_api_cms_rooms_order', {number: venue.number}),
            change: path('admin_api_cms_rooms_change', id_route),
            remove: path('admin_api_cms_rooms_remove', id_route),
        },
        reloadUrl: path('admin_locations_rooms', {number: venue.number}),
        labels: {
            title: 'rooms.title'|trans({}, 'cms'),
            add: 'rooms.add'|trans({}, 'cms'),
            edit: 'rooms.edit'|trans({}, 'cms'),
            listLabel: 'rooms.list_label'|trans({}, 'cms'),
            moveUp: 'rooms.move_up'|trans({}, 'cms'),
            moveDown: 'rooms.move_down'|trans({}, 'cms'),
            moved: 'rooms.moved'|trans({}, 'cms'),
            emptyTitle: 'rooms.empty.title'|trans({}, 'cms'),
            emptyText: 'rooms.empty.text'|trans({}, 'cms'),
            capacityRange: 'rooms.summary.capacity_range'|trans({}, 'cms'),
            capacityMax: 'rooms.summary.capacity_max'|trans({}, 'cms'),
            area: 'rooms.summary.area'|trans({}, 'cms'),
            photoCountOne: 'rooms.summary.photos_one'|trans({}, 'cms'),
            photoCountOther: 'rooms.summary.photos_other'|trans({}, 'cms'),
            fromContent: 'rooms.summary.from_content'|trans({}, 'cms'),
            addTitle: 'rooms.drawer.add_title'|trans({}, 'cms'),
            editTitle: 'rooms.drawer.edit_title'|trans({}, 'cms'),
            save: 'rooms.drawer.save'|trans({}, 'cms'),
            cancel: 'rooms.drawer.cancel'|trans({}, 'cms'),
            close: 'rooms.drawer.close'|trans({}, 'cms'),
            requiredHint: 'ui.form.required_hint'|trans({}, 'admin'),
            name: 'rooms.field.name'|trans({}, 'cms'),
            description: 'rooms.field.description'|trans({}, 'cms'),
            capacityMin: 'rooms.field.capacity_min'|trans({}, 'cms'),
            capacityMaxField: 'rooms.field.capacity_max'|trans({}, 'cms'),
            areaField: 'rooms.field.area'|trans({}, 'cms'),
            height: 'rooms.field.height'|trans({}, 'cms'),
            heightHelp: 'rooms.help.height'|trans({}, 'cms'),
            floor: 'rooms.field.floor'|trans({}, 'cms'),
            floorNone: 'rooms.field.floor_none'|trans({}, 'cms'),
            seating: 'rooms.field.seating'|trans({}, 'cms'),
            seatingMin: 'rooms.field.seating_min'|trans({}, 'cms'),
            seatingMax: 'rooms.field.seating_max'|trans({}, 'cms'),
            remove: 'rooms.remove.action'|trans({}, 'cms'),
            removeTitle: 'rooms.remove.title'|trans({}, 'cms'),
            removeText: 'rooms.remove.text'|trans({}, 'cms'),
            removePhotos: 'rooms.remove.photos'|trans({}, 'cms'),
            removeConfirm: 'rooms.remove.confirm'|trans({}, 'cms'),
            added: 'rooms.flash.added'|trans({}, 'cms'),
            saved: 'rooms.flash.saved'|trans({}, 'cms'),
            removed: 'rooms.flash.removed'|trans({}, 'cms'),
            orderFailed: 'rooms.flash.order_failed'|trans({}, 'cms'),
            failed: 'rooms.flash.failed'|trans({}, 'cms'),
            sessionGone: 'rooms.flash.session_gone'|trans({}, 'cms'),
            stale: 'error.stale'|trans({}, 'cms'),
            reload: 'error.stale_reload'|trans({}, 'cms'),
            notFound: 'error.not_found'|trans({}, 'cms'),
        },
    }, '<p class="island-required">' ~ ('rooms.needs_js'|trans({}, 'cms')|e) ~ '</p>') }}
{% endblock %}
