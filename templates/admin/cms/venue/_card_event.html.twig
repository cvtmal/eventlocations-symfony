{#
    Card "Veranstaltung" (the event facts). Include with `with_context = false`: form, card, number, stale, locales.
    The texts have a tab per locale with a translation row; after a 422 the first locale with an error is open (L2).
#}
{% embed 'admin/cms/venue/_card_shell.html.twig' with {form: form, card: card, number: number, stale: stale, locales: locales, submit_label: submit_label|default(null)} only %}
    {% block fields %}
        {{ form_row(form.priceLevel) }}
        <div class="field-row">
            {{ form_row(form.capacitySeated) }}
            {{ form_row(form.capacityStanding) }}
        </div>
        {% set text_locales = locales|filter(locale => form.texts[locale.code] is defined) %}
        {% if text_locales is not empty %}
            {% set panels = {} %}
            {% for locale in text_locales %}
                {% set texts = form.texts[locale.code] %}
                {% set panel %}
                    {{ form_row(texts.ambience) }}
                    {{ form_row(texts.capacityNote) }}
                    {{ form_row(texts.openingHours) }}
                {% endset %}
                {% set panels = panels|merge({(locale.code): panel}) %}
            {% endfor %}
            {{ include('admin/components/_locale_tabs.html.twig', {
                id: 'venue-event',
                label: 'editor.locales_label'|trans({}, 'cms'),
                locales: text_locales,
                panels: panels,
                active: text_locales|filter(locale => not form.texts[locale.code].vars.valid)|map(locale => locale.code)|first|default(null),
            }, with_context = false) }}
        {% endif %}
        {% do form.texts.setRendered() %}
        {% for group in constant('App\\Cms\\Form\\VenueEventData::GROUPS')|map(group => group.value) %}
            {{ form_row(form[group]) }}
        {% endfor %}
    {% endblock %}
{% endembed %}
