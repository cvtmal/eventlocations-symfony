{#
    Card "Veranstaltung" (the event facts). Include with `with_context = false`: form, card, number, stale, locales,
    optional event_types_limit `{max, text, full_text, link_label, link_href}` (the manager's plan, D40: `text` under the
    event types; `full_text` and the link, when `link_href` is set, once the selection reaches `max`; staff pass none).
    Event types, catering and technology come first (F11: what the wizard's event step asks), amenity and language last.
    The texts have a tab per locale with a translation row; after a 422 the first locale with an error is open (L2).
#}
{% embed 'admin/cms/venue/_card_shell.html.twig' with {form: form, card: card, number: number, stale: stale, locales: locales, submit_label: submit_label|default(null), event_types_limit: event_types_limit|default(null)} only %}
    {% block fields %}
        {{ form_row(form.suitable_for, event_types_limit ? {attr: {'aria-describedby': 'event-types-limit'}} : {}) }}
        {% if event_types_limit %}
            <p class="field__help" id="event-types-limit">
                {{- event_types_limit.text -}}
                {%- if event_types_limit.link_href and form.suitable_for|filter(chip => chip.vars.checked)|length >= event_types_limit.max %}
                    {{ event_types_limit.full_text }} <a href="{{ event_types_limit.link_href }}">{{ event_types_limit.link_label }}</a>
                {%- endif -%}
            </p>
        {% endif %}
        {{ form_row(form.catering) }}
        {{ form_row(form.technology) }}
        {{ form_row(form.priceLevel) }}
        <div class="field-row">
            {{ form_row(form.capacitySeated) }}
            {{ form_row(form.capacityStanding) }}
        </div>
        {% set text_locales = locales|filter(locale => form.texts[locale.code] is defined) %}
        {% if text_locales is not empty %}
            {% set panels = {} %}
            {% for locale in text_locales %}
                {% set texts = form.texts[locale.code] %}
                {% set panel %}
                    {{ form_row(texts.ambience) }}
                    {{ form_row(texts.capacityNote) }}
                    {{ form_row(texts.openingHours) }}
                {% endset %}
                {% set panels = panels|merge({(locale.code): panel}) %}
            {% endfor %}
            {{ include('admin/components/_locale_tabs.html.twig', {
                id: 'venue-event',
                label: 'editor.locales_label'|trans({}, 'cms'),
                locales: text_locales,
                panels: panels,
                active: text_locales|filter(locale => not form.texts[locale.code].vars.valid)|map(locale => locale.code)|first|default(null),
            }, with_context = false) }}
        {% endif %}
        {% do form.texts.setRendered() %}
        {{ form_row(form.amenity) }}
        {{ form_row(form.language) }}
    {% endblock %}
{% endembed %}
