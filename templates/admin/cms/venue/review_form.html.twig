{#
    Add or edit a review (#25, CMS-8). Context from `VenueReviewsController`: venue (VenueHeader), review (ManagedReview,
    null when adding), form (`ReviewType`; with the row token when editing), stale (bool: a 409 re-render).
#}
{% extends 'admin/cms/venue/_layout.html.twig' %}

{% set record_route = 'admin_locations_reviews' %}
{% set record_crumb = 'reviews.tab'|trans({}, 'cms') %}

{% block record_main %}
    <div class="venue-media">
        {% form_theme form 'admin/form/theme.html.twig' %}
        {{ form_start(form, {attr: {class: 'venue-media__form', novalidate: 'novalidate', 'data-unsaved-guard': ''}}) }}
            {% embed 'admin/components/_card.html.twig' with {
                title: (review ? 'reviews.edit_title' : 'reviews.new_title')|trans({name: review.firstName|default('')}, 'cms'),
                id: 'venue-review-form',
                review_form: form,
                stale: stale,
                reload_url: review ? path('admin_locations_reviews_edit', {number: venue.number, id: review.id}) : null,
                back_url: path('admin_locations_reviews', {number: venue.number}),
            } only %}
                {% block body %}
                    {{ form_errors(review_form) }}
                    {% if stale %}
                        <p class="venue-card__stale"><a href="{{ reload_url }}">{{ 'error.stale_reload'|trans({}, 'cms') }}</a></p>
                    {% endif %}
                    {{ include('admin/components/_required_hint.html.twig', with_context = false) }}
                    {{ form_rest(review_form) }}
                {% endblock %}
                {% block foot %}
                    {{ include('admin/components/_button.html.twig', {label: 'reviews.back'|trans({}, 'cms'), variant: 'ghost', href: back_url}, with_context = false) }}
                    {{ include('admin/components/_button.html.twig', {label: 'editor.save'|trans({}, 'cms'), variant: 'primary', type: 'submit'}, with_context = false) }}
                {% endblock %}
            {% endembed %}
        {{ form_end(form) }}
    </div>
{% endblock %}
