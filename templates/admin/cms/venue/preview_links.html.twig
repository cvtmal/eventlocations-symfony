{#
    The Vorschau-Links tab (G5). Context from `VenuePreviewLinksController`: venue (VenueHeader), form (PreviewLinkType),
    links (list of {link: VenuePreviewLink, state: open|expired|revoked, url: the public link while open, else null}),
    csrf_id. Each link row has the anchor `link-<id>` (the redirect after "Link erstellen" lands there); the list card's
    is `vorschau-links`. An open link shows its address (read-only, to copy), its QR code (an SVG file to print) and
    "Zurückziehen" with a confirm dialog; a closed one shows only when it closed.
#}
{% extends 'admin/cms/venue/_layout.html.twig' %}

{% form_theme form 'admin/form/theme.html.twig' %}

{% set record_crumb = 'preview_links.tab'|trans({}, 'cms') %}

{% block record_main %}
    {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
        {% embed 'admin/components/_card.html.twig' with {title: 'preview_links.new'|trans({}, 'cms'), id: 'neuer-vorschau-link', link_form: form} only %}
            {% block body %}
                <p class="muted">{{ 'preview_links.intro'|trans({}, 'cms') }}</p>
                {{ include('admin/components/_required_hint.html.twig', with_context = false) }}
                {{ form_errors(link_form) }}
                <div class="field-row">
                    {{ form_row(link_form.campaignCode) }}
                    {{ form_row(link_form.lifetimeDays) }}
                </div>
            {% endblock %}
            {% block foot %}
                {{ include('admin/components/_button.html.twig', {label: 'preview_links.submit'|trans({}, 'cms'), variant: 'primary', type: 'submit'}, with_context = false) }}
            {% endblock %}
        {% endembed %}
    {{ form_end(form) }}

    {% embed 'admin/components/_card.html.twig' with {title: 'preview_links.list'|trans({}, 'cms'), id: 'vorschau-links', links: links, number: venue.number, csrf: csrf_token(csrf_id)} only %}
        {% block body %}
            {% if links is empty %}
                <p class="muted">{{ 'preview_links.empty'|trans({}, 'cms') }}</p>
            {% else %}
                <div class="table-wrap" tabindex="0" role="region" aria-label="{{ 'preview_links.table_label'|trans({}, 'cms') }}">
                    <table class="table preview-links">
                        <thead>
                            <tr>
                                <th scope="col">{{ 'preview_links.column.campaign'|trans({}, 'cms') }}</th>
                                <th scope="col">{{ 'preview_links.column.status'|trans({}, 'cms') }}</th>
                                <th scope="col">{{ 'preview_links.column.link'|trans({}, 'cms') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in links %}
                                {% set link = row.link %}
                                {% set campaign = link.campaignCode ?? 'preview_links.no_campaign'|trans({}, 'cms') %}
                                <tr id="link-{{ link.id }}">
                                    <td>
                                        <strong>{{ campaign }}</strong>
                                        <span class="muted preview-links__meta">{{ 'preview_links.detail.created'|trans({date: link.createdAt|swiss_date}, 'cms') }}</span>
                                    </td>
                                    <td>
                                        {{ include('admin/components/_pill.html.twig', {
                                            label: ('preview_links.state.' ~ row.state)|trans({}, 'cms'),
                                            tone: {open: 'green', expired: 'grey', revoked: 'red'}[row.state],
                                            dot: true,
                                        }, with_context = false) }}
                                        <span class="muted preview-links__meta">{{ ('preview_links.detail.' ~ row.state)|trans({date: (row.state == 'revoked' ? link.revokedAt : link.expiresAt)|swiss_date}, 'cms') }}</span>
                                    </td>
                                    <td>
                                        {% if row.url %}
                                            <div class="preview-links__link">
                                                <label class="visually-hidden" for="link-url-{{ link.id }}">{{ 'preview_links.field.link'|trans({campaign: campaign}, 'cms') }}</label>
                                                <input class="field__input preview-links__url" id="link-url-{{ link.id }}" type="text" readonly value="{{ row.url }}">
                                                {% if row.short_url %}
                                                    <label class="visually-hidden" for="link-short-{{ link.id }}">{{ 'preview_links.field.short'|trans({campaign: campaign}, 'cms') }}</label>
                                                    <input class="field__input preview-links__url preview-links__short" id="link-short-{{ link.id }}" type="text" readonly value="{{ row.short_url }}">
                                                {% endif %}
                                                <div class="preview-links__actions">
                                                    {% set qr_url = path('admin_locations_preview_links_qr', {number: number, id: link.id}) %}
                                                    <img class="preview-links__qr" src="{{ qr_url }}" width="96" height="96" alt="{{ 'preview_links.qr_alt'|trans({campaign: campaign}, 'cms') }}" loading="lazy">
                                                    {{ include('admin/components/_button.html.twig', {label: 'preview_links.qr_download'|trans({}, 'cms'), size: 'sm', variant: 'ghost', href: qr_url, attributes: {download: 'vorschau-' ~ number ~ '-' ~ (link.campaignCode ?? 'email') ~ '.svg'}}, with_context = false) }}
                                                    {{ include('admin/components/_button.html.twig', {
                                                        label: 'preview_links.revoke.action'|trans({}, 'cms'),
                                                        size: 'sm',
                                                        attributes: {
                                                            'aria-label': 'preview_links.revoke.action_for'|trans({campaign: campaign}, 'cms'),
                                                            commandfor: 'preview-revoke-' ~ link.id,
                                                            command: 'show-modal',
                                                        },
                                                    }, with_context = false) }}
                                                </div>
                                            </div>
                                        {% else %}
                                            <span class="muted">–</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% for row in links|filter(row => row.url) %}
                    {% embed 'admin/components/_modal.html.twig' with {
                        id: 'preview-revoke-' ~ row.link.id,
                        title: 'preview_links.revoke.title'|trans({campaign: row.link.campaignCode ?? 'preview_links.no_campaign'|trans({}, 'cms')}, 'cms'),
                        close_label: 'preview_links.revoke.close'|trans({}, 'cms'),
                        danger: true,
                        revoke_url: path('admin_locations_preview_links_revoke', {number: number, id: row.link.id}),
                        csrf: csrf,
                    } only %}
                        {% block body %}<p>{{ 'preview_links.revoke.text'|trans({}, 'cms') }}</p>{% endblock %}
                        {% block footer %}
                            <form method="dialog"><button class="btn" autofocus>{{ 'preview_links.revoke.cancel'|trans({}, 'cms') }}</button></form>
                            <form method="post" action="{{ revoke_url }}">
                                <input type="hidden" name="_token" value="{{ csrf }}">
                                {{ include('admin/components/_button.html.twig', {label: 'preview_links.revoke.confirm'|trans({}, 'cms'), variant: 'danger', type: 'submit'}, with_context = false) }}
                            </form>
                        {% endblock %}
                    {% endembed %}
                {% endfor %}
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
