{#
    One text block (#26). Context from `TextBlockEditController`: definition (ContentBlockDefinition), form, stale
    (a 409 re-render), locales list<{code, label}>, last_edit (?AuditLogRow).
#}
{% extends 'admin/base.html.twig' %}

{% form_theme form 'admin/form/theme.html.twig' %}

{% block title %}{{ 'blocks.editor.title'|trans({name: definition.label|trans}, 'cms') }} – {{ 'shell.backoffice'|trans({}, 'admin') }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumbs__item">{{ 'nav.section'|trans({}, 'cms') }}</li>
    <li class="breadcrumbs__item"><a href="{{ path('admin_text_blocks') }}">{{ 'blocks.list.title'|trans({}, 'cms') }}</a></li>
    <li class="breadcrumbs__item" aria-current="page">{{ definition.label|trans }}</li>
{% endblock %}

{% block page_header %}
    {%- set parts = [definition.placement|trans] -%}
    {%- if last_edit -%}
        {%- set when = last_edit.createdAt|swiss_date ~ ', ' ~ last_edit.createdAt|date('H:i', 'Europe/Zurich') -%}
        {%- set parts = parts|merge([last_edit.actorName
            ? 'editor.meta.edited_by'|trans({name: last_edit.actorName, date: when}, 'cms')
            : 'editor.meta.edited_at'|trans({date: when}, 'cms')]) -%}
    {%- endif -%}
    {% embed 'admin/components/_record_header.html.twig' with {title: definition.label|trans, subtitle: parts|join(' · ')} only %}{% endembed %}
{% endblock %}

{% block main %}
    {{ form_start(form, {attr: {id: 'text-block-form', class: 'content-editor', novalidate: 'novalidate', 'aria-labelledby': 'text-block', 'data-unsaved-guard': ''}}) }}
        {% embed 'admin/components/_card.html.twig' with {title: 'blocks.editor.card'|trans({}, 'cms'), id: 'text-block', editor_form: form, stale: stale, locales: locales, definition: definition} only %}
            {% block body %}
                {{ form_errors(editor_form) }}
                {% if stale %}
                    <p class="content-editor__stale"><a href="{{ path('admin_text_blocks_edit', {key: definition.key}) }}">{{ 'text.error.stale_reload'|trans({}, 'cms') }}</a></p>
                {% endif %}
                {% if definition.fallback %}
                    <p class="muted">{{ 'blocks.editor.fallback'|trans({text: definition.fallback|trans}, 'cms') }}</p>
                {% else %}
                    <p class="muted">{{ 'blocks.editor.no_fallback'|trans({}, 'cms') }}</p>
                {% endif %}
                {% set panels = {} %}
                {% for locale in locales %}
                    {% set panel %}{{ form_row(editor_form.locales[locale.code].body) }}{% endset %}
                    {% set panels = panels|merge({(locale.code): panel}) %}
                {% endfor %}
                {{ include('admin/components/_locale_tabs.html.twig', {
                    id: 'text-block-locales',
                    label: 'editor.locales_label'|trans({}, 'cms'),
                    locales: locales,
                    panels: panels,
                    active: locales|filter(locale => not editor_form.locales[locale.code].vars.valid)|map(locale => locale.code)|first|default(null),
                }, with_context = false) }}
            {% endblock %}
            {% block foot %}
                {{ include('admin/components/_button.html.twig', {label: 'editor.save'|trans({}, 'cms'), variant: 'primary', type: 'submit'}, with_context = false) }}
            {% endblock %}
        {% endembed %}
    {{ form_end(form) }}
{% endblock %}
