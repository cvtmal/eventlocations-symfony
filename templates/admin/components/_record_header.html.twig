{#
    Head of a record page (LocationEdit). Embed with `{% embed 'admin/components/_record_header.html.twig' with {…} only %}` in `{% block page_header %}`:
      title, subtitle. Blocks: media (a thumbnail before the title; empty by default), meta (pills next to the title), actions,
      tabs (`_record_tabs`).
#}
{%- set media_markup %}{% block media %}{% endblock %}{% endset -%}
<div class="record-header">
    <div class="record-header__top">
        {% if media_markup|trim is not empty %}<div class="record-header__media">{{ media_markup }}</div>{% endif %}
        <div class="record-header__main">
            <div class="record-header__title">
                <h1>{{ title }}</h1>
                {% block meta %}{% endblock %}
            </div>
            {% if subtitle|default(false) %}<span class="record-header__subtitle">{{ subtitle }}</span>{% endif %}
        </div>
        <div class="record-header__actions">{% block actions %}{% endblock %}</div>
    </div>
    {% block tabs %}{% endblock %}
</div>
