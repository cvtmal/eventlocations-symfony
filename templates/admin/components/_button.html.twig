{#
    Button, or a link that looks like one. `{{ include('admin/components/_button.html.twig', {…}, with_context = false) }}`:
      label (translated), variant primary|secondary|ghost|danger (default secondary), size sm|xs|lg, icon,
      icon_only (the label becomes aria-label), href (renders <a>), type (default button), attributes (map).
#}
{%- set variant = variant|default('secondary') -%}
{%- set icon_only = icon_only|default(false) -%}
{%- set classes = ['btn']
    |merge(variant != 'secondary' ? ['btn--' ~ variant] : [])
    |merge(size|default(false) ? ['btn--' ~ size] : [])
    |merge(icon_only ? ['btn--icon'] : []) -%}
{%- set extra = (icon_only ? {'aria-label': label} : {})|merge(attributes|default({})) -%}
{%- set extra_attributes %}{% for name, value in extra %} {{ name }}="{{ value }}"{% endfor %}{% endset -%}
{%- set content %}{% if icon|default(false) %}{{ admin_icon(icon) }}{% endif %}{% if not icon_only %}{{ label }}{% endif %}{% endset -%}
{%- if href|default(false) -%}
    <a class="{{ classes|join(' ') }}" href="{{ href }}"{{ extra_attributes }}>{{ content }}</a>
{%- else -%}
    <button class="{{ classes|join(' ') }}" type="{{ type|default('button') }}"{{ extra_attributes }}>{{ content }}</button>
{%- endif -%}
