{#
    The cancellation link of the reminder mail (G9, CancelSubscriptionController): the question, or, once cancelled,
    the answer; `renewed` (optional) when a later term is already paid. `term` is a `Venues\ReadModel\SubscriptionTerm`; `failed` is true after a POST with a bad token.
#}
{% extends 'portal/base_auth.html.twig' %}

{% block title %}{{ 'subscription.cancel.title'|trans({}, 'portal') }} – {{ 'shell.account'|trans({}, 'portal') }}{% endblock %}

{% block form %}
    <div class="auth__form">
        {% if renewed|default(false) %}
            <h1>{{ 'subscription.cancel.renewed.title'|trans({}, 'portal') }}</h1>
            <p class="auth__intro">{{ 'subscription.cancel.renewed.text'|trans({tier: term.tierName, venue: term.venueName, end: term.endsOn}, 'portal') }}</p>
            <a class="btn btn--primary btn--lg" href="{{ path('portal_login') }}">{{ 'subscription.cancel.done.link'|trans({}, 'portal') }}</a>
        {% elseif term.cancelled %}
            <h1>{{ 'subscription.cancel.done.title'|trans({}, 'portal') }}</h1>
            <p class="auth__intro">{{ 'subscription.cancel.done.text'|trans({tier: term.tierName, venue: term.venueName, end: term.endsOn}, 'portal') }}</p>
            <a class="btn btn--primary btn--lg" href="{{ path('portal_login') }}">{{ 'subscription.cancel.done.link'|trans({}, 'portal') }}</a>
        {% else %}
            <h1>{{ 'subscription.cancel.title'|trans({}, 'portal') }}</h1>
            <p class="auth__intro">{{ 'subscription.cancel.intro'|trans({tier: term.tierName, venue: term.venueName, end: term.endsOn}, 'portal') }}</p>
            <p class="auth__intro">{{ 'subscription.cancel.after'|trans({}, 'portal') }}</p>
            {% if failed %}
                <p class="form-error" role="alert">{{ 'subscription.cancel.failed'|trans({}, 'portal') }}</p>
            {% endif %}
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                <button class="btn btn--primary btn--lg" type="submit">{{ 'subscription.cancel.submit'|trans({}, 'portal') }}</button>
            </form>
        {% endif %}
    </div>
{% endblock %}
