{% extends 'portal/base.html.twig' %}

{% block title %}{{ 'overview.title'|trans({}, 'portal') }} – {{ 'shell.account'|trans({}, 'portal') }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumbs__item" aria-current="page">{{ 'overview.title'|trans({}, 'portal') }}</li>
{% endblock %}

{% block page_actions %}
    {{ include('admin/components/_button.html.twig', {label: 'claims.overview_link'|trans({}, 'portal'), href: path('portal_claims_search'), variant: 'primary', size: 'sm', icon: 'search'}, with_context = false) }}
    {{ include('admin/components/_button.html.twig', {label: 'onboarding.overview.new'|trans({}, 'portal'), href: path('portal_locations_new'), size: 'sm', icon: 'plus'}, with_context = false) }}
{% endblock %}

{% block page_header %}
    <div class="page-header">
        <h1>{{ 'overview.title'|trans({}, 'portal') }}</h1>
    </div>
{% endblock %}

{% block main %}
    <div class="card">
        {% if locations is empty %}
            {{ include('admin/components/_empty.html.twig', {icon: 'building-2', title: 'overview.empty.title'|trans({}, 'portal'), text: 'overview.empty.text'|trans({}, 'portal')}, with_context = false) }}
        {% else %}
            <ul class="venue-widget">
                {% for location in locations %}
                    {% set review = location.isPublished ? null : (statuses[location.number].value ?? null) %}
                    {% set is_frozen = location.number in frozen %}
                    <li class="venue-widget__row">
                        {% if is_frozen %}
                            <span class="venue-widget__name">{{ location.name }}</span>
                        {% else %}
                            <a class="venue-widget__name" href="{{ path('portal_location', {number: location.number}) }}">{{ location.name }}</a>
                        {% endif %}
                        <span class="venue-widget__pills">
                            {{ include('admin/components/_pill.html.twig', {
                                label: ('list.status.' ~ location.status.value)|trans({}, 'cms'),
                                tone: location.isPublished ? 'green' : 'grey',
                                dot: true,
                            }, with_context = false) }}
                            {% for code in location.missing %}
                                {{ include('admin/components/_pill.html.twig', {label: ('dashboard.incomplete.missing.' ~ code)|trans({}, 'cms'), tone: 'grey'}, with_context = false) }}
                            {% endfor %}
                            {% if is_frozen %}
                                {{ include('admin/components/_pill.html.twig', {label: 'claim.overview.frozen'|trans({}, 'portal'), tone: 'amber'}, with_context = false) }}
                            {% endif %}
                            {% if review == 'rejected' %}
                                {{ include('admin/components/_pill.html.twig', {label: 'onboarding.overview.rejected'|trans({}, 'portal'), tone: 'red'}, with_context = false) }}
                            {% elseif review == 'submitted' %}
                                {{ include('admin/components/_pill.html.twig', {label: 'onboarding.overview.in_review'|trans({}, 'portal'), tone: 'amber'}, with_context = false) }}
                            {% endif %}
                        </span>
                        {% if review in ['draft', 'rejected'] and not is_frozen %}
                            {{ include('admin/components/_button.html.twig', {label: 'onboarding.overview.resume'|trans({}, 'portal'), href: path('portal_location_setup', {number: location.number}), size: 'sm'}, with_context = false) }}
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
