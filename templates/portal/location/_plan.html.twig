{#
    The plan card (F12): the location's tier, how much of each limit it uses and, below Pro, "Pro anfragen". Include with
    `with_context = false`: plan (`Portal\ReadModel\LocationPlan`), number (the location's number), optional back (the
    route of the tab to return to after «Pro anfragen»; `ProRequestController` takes Fotos, Räume and Dokumente).
    The button posts to `ProRequestController` with the stateless `submit` token, like the claim form.
#}
<section class="card" aria-labelledby="location-plan">
    <div class="card__head">
        <h2 id="location-plan">{{ 'plan.title'|trans({tier: plan.tierName}, 'portal') }}</h2>
        {% if plan.promoted %}
            {{ include('admin/components/_pill.html.twig', {label: 'tier.promoted'|trans({}, 'venues'), tone: 'green'}, with_context = false) }}
        {% endif %}
    </div>
    <ul class="venue-widget">
        {% if plan.paidUntil %}
            <li class="venue-widget__row">{{ (plan.cancelled ? 'plan.term.cancelled' : (plan.freeOfCharge ? 'plan.term.free_until' : 'plan.term.paid_until'))|trans({end: plan.paidUntil}, 'portal') }}</li>
        {% endif %}
        <li class="venue-widget__row">{{ (plan.photosUsed > plan.photosMax ? 'plan.limit.photos_over' : 'plan.limit.photos')|trans({used: plan.photosUsed|swiss_number, max: plan.photosMax|swiss_number}, 'portal') }}</li>
        <li class="venue-widget__row">{{ (plan.roomsUsed > plan.roomsMax ? 'plan.limit.rooms_over' : 'plan.limit.rooms')|trans({used: plan.roomsUsed|swiss_number, max: plan.roomsMax|swiss_number}, 'portal') }}</li>
        <li class="venue-widget__row">{{ (plan.documentsUsed > plan.documentsMax ? 'plan.limit.documents_over' : 'plan.limit.documents')|trans({used: plan.documentsUsed|swiss_number, max: plan.documentsMax|swiss_number}, 'portal') }}</li>
        <li class="venue-widget__row">{{ (plan.contactVisible ? 'plan.limit.contact_visible' : 'plan.limit.contact_hidden')|trans({}, 'portal') }}</li>
        <li class="venue-widget__row">
            {%- if plan.eventTypesMax is null -%}
                {{ 'plan.limit.event_types_all'|trans({}, 'portal') }}
            {%- else -%}
                {{ 'plan.limit.event_types'|trans({max: plan.eventTypesMax|swiss_number}, 'portal') }}
            {%- endif -%}
        </li>
    </ul>
    {% if plan.canRequestPro %}
        {% set francs = plan.proPriceRappen / 100 %}
        <p class="card__body muted">{{ (plan.proVatLine ? 'plan.pro.price_plus_vat' : 'plan.pro.price')|trans({price: francs|swiss_number(plan.proPriceRappen % 100 == 0 ? 0 : 2)}, 'portal') }}</p>
        <div class="card__foot">
            <form method="post" action="{{ path('portal_location_pro_request', {number: number}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                {% if back|default(null) %}<input type="hidden" name="back" value="{{ back }}">{% endif %}
                {{ include('admin/components/_button.html.twig', {label: 'plan.pro.request'|trans({}, 'portal'), variant: 'primary', type: 'submit'}, with_context = false) }}
            </form>
        </div>
    {% endif %}
</section>
