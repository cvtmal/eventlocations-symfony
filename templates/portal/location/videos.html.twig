{#
    The manager's Videos tab (G15): staff's list and link card. Context from `VenueVideoPages` with
    `LocationVideosController`'s setup: what `admin/cms/venue/_videos.html.twig` lists, plus submission, offline_form
    (for `_layout`) and plan (the plan card, F12).
#}
{% extends 'portal/location/_layout.html.twig' %}

{% block location_main %}
    {{ include('admin/cms/venue/_videos.html.twig') }}
{% endblock %}

{% block aside %}
    {{ include('portal/location/_plan.html.twig', {plan: plan, number: venue.number}, with_context = false) }}
{% endblock %}
