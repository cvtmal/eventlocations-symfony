{#
    The manager's editor (POR-8): one card per `Portal\ValueObject\LocationCard`, each its own form. Context from
    `LocationEditController`: venue (VenueHeader), edit (VenueEdit), forms (card value → FormView), bound_card, stale,
    cards (the LocationCard cases), locales list<{code, label}>, offline_form, plan (LocationPlan, F12).
#}
{% extends 'portal/location/_layout.html.twig' %}

{% block location_main %}
    {# D40: the event types' limit under the Veranstaltung card's chips, with «Pro anfragen» once it is reached. #}
    {% set event_types_limit = plan.eventTypesMax is not null ? {
        max: plan.eventTypesMax,
        text: 'plan.event_types.limit'|trans({tier: plan.tierName, max: plan.eventTypesMax}, 'portal'),
        full_text: 'plan.event_types.full'|trans({}, 'portal'),
        link_label: 'plan.event_types.link'|trans({}, 'portal'),
        link_href: plan.canRequestPro ? '#location-plan' : null,
    } : null %}
    <div class="venue-editor">
        {% for card in cards %}
            {{ include(card.template, {
                form: forms[card.value],
                card: card,
                number: venue.number,
                stale: stale and bound_card == card.value,
                locales: locales,
                town_centre_hint: edit.townCentreHint,
                event_types_limit: event_types_limit,
            }, with_context = false) }}
        {% endfor %}
    </div>
{% endblock %}
