{#
    G6 step 3 (`ClaimFlowController::code`): the mailed code. Context: form (ClaimCodeType), email (as typed).
#}
{% extends 'portal/base_auth.html.twig' %}
{% form_theme form 'admin/form/theme.html.twig' %}

{% block title %}{{ 'claim.code.title'|trans({}, 'portal') }} – {{ 'shell.account'|trans({}, 'portal') }}{% endblock %}

{% block form %}
    {{ form_start(form, {attr: {class: 'auth__form', novalidate: 'novalidate'}}) }}
        <h1>{{ 'claim.code.title'|trans({}, 'portal') }}</h1>
        <p class="auth__intro">{{ 'claim.code.intro'|trans({email: email}, 'portal') }}</p>
        <p class="auth__intro">{{ 'claim.code.domain_note'|trans({}, 'portal') }}</p>
        {{ form_errors(form) }}
        {{ form_row(form.code) }}
        {{ form_rest(form) }}
        <button class="btn btn--primary btn--lg" type="submit">{{ 'claim.code.submit'|trans({}, 'portal') }}</button>
        <a class="auth__help" href="{{ path('portal_claim') }}">{{ 'claim.code.again'|trans({}, 'portal') }}</a>
    {{ form_end(form) }}
{% endblock %}
