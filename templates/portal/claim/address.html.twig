{#
    G6 step 2 (`ClaimFlowController::address`): who takes over the entry. The code goes to this address; the answer is
    the same for every address. Context: form (RegisterType), venue_name, correct (came from "Angaben korrigieren").
#}
{% extends 'portal/base_auth.html.twig' %}
{% form_theme form 'admin/form/theme.html.twig' %}

{% block title %}{{ 'claim.address.title'|trans({}, 'portal') }} – {{ 'shell.account'|trans({}, 'portal') }}{% endblock %}

{% block form %}
    {{ form_start(form, {attr: {class: 'auth__form', novalidate: 'novalidate'}}) }}
        <h1>{{ 'claim.address.heading'|trans({venue: venue_name}, 'portal') }}</h1>
        {% if correct %}
            <p class="auth__intro">{{ 'claim.address.correct'|trans({}, 'portal') }}</p>
        {% endif %}
        <p class="auth__intro">{{ 'claim.address.intro'|trans({}, 'portal') }}</p>
        {{ form_errors(form) }}
        {{ include('admin/components/_required_hint.html.twig') }}
        {{ form_row(form.firstName) }}
        {{ form_row(form.lastName) }}
        {{ form_row(form.email, {help: 'claim.address.email_help'}) }}
        <div class="visually-hidden">{{ form_row(form.website) }}</div>
        {{ form_rest(form) }}
        <button class="btn btn--primary btn--lg" type="submit">{{ 'claim.address.submit'|trans({}, 'portal') }}</button>
    {{ form_end(form) }}
{% endblock %}
