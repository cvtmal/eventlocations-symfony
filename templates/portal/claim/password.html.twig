{#
    G6 step 4 (`ClaimFlowController::password`): a first password for an account that has none.
#}
{% extends 'portal/base_auth.html.twig' %}
{% form_theme form 'admin/form/theme.html.twig' %}

{% block title %}{{ 'claim.password.title'|trans({}, 'portal') }} – {{ 'shell.account'|trans({}, 'portal') }}{% endblock %}

{% block form %}
    {{ form_start(form, {attr: {class: 'auth__form', novalidate: 'novalidate'}}) }}
        <h1>{{ 'claim.password.title'|trans({}, 'portal') }}</h1>
        <p class="auth__intro">{{ 'claim.password.intro'|trans({}, 'portal') }}</p>
        {{ form_errors(form) }}
        {{ include('admin/components/_required_hint.html.twig') }}
        {{ form_row(form.plainPassword.first) }}
        {{ form_row(form.plainPassword.second) }}
        {{ form_rest(form) }}
        <button class="btn btn--primary btn--lg" type="submit">{{ 'claim.password.submit'|trans({}, 'portal') }}</button>
    {{ form_end(form) }}
{% endblock %}
