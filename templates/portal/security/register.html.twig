{% extends 'portal/base_auth.html.twig' %}
{% form_theme form 'admin/form/theme.html.twig' %}

{% block title %}{{ 'register.title'|trans({}, 'portal') }} – {{ 'shell.account'|trans({}, 'portal') }}{% endblock %}

{% block form %}
    {{ form_start(form, {attr: {class: 'auth__form', novalidate: 'novalidate'}}) }}
        <h1>{{ 'register.title'|trans({}, 'portal') }}</h1>
        <p class="auth__intro">{{ 'register.intro'|trans({}, 'portal') }}</p>
        {{ form_errors(form) }}
        {{ include('admin/components/_required_hint.html.twig') }}
        {{ form_row(form.firstName) }}
        {{ form_row(form.lastName) }}
        {{ form_row(form.email) }}
        <div class="visually-hidden">{{ form_row(form.website) }}</div>
        {{ form_rest(form) }}
        <button class="btn btn--primary btn--lg" type="submit">{{ 'register.submit'|trans({}, 'portal') }}</button>
        <a class="auth__help" href="{{ path('portal_login') }}">{{ 'register.login'|trans({}, 'portal') }}</a>
    {{ form_end(form) }}
{% endblock %}
