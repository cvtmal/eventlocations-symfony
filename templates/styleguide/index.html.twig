{% extends 'base.html.twig' %}

{#
    Dev/test-only gallery of every #1 component (config/routes/styleguide.yaml). Every |trans names its domain (PD-5).
    The composition follows docs/reference/public/Tokens.png and Tokens-390.png, section by section. The board draws the
    dialog and two overlays open, so those are static drawings under `inert`, with no popover, data-dialog or data-overlay.
    The real shells sit in the last section, with everything else the board does not draw.
#}

{% block title %}{{ 'styleguide.page_title'|trans({}, 'styleguide') }}{% endblock %}

{% block meta %}<meta name="robots" content="noindex">{% endblock %}

{% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/styleguide.scss') }}">{% endblock %}

{% block scripts %}
    <script type="module" src="{{ asset('js/carousel.js') }}"></script>
    <script type="module" src="{{ asset('js/overlay.js') }}"></script>
    <script type="module" src="{{ asset('js/dialog.js') }}"></script>
{% endblock %}

{% block main %}
{# [label on the board, token, hex]. The notes are `styleguide.colors.notes.<label>`. #}
{% set color_groups = [
    {key: 'surfaces', colors: [['surface', 'surface', '#F6F7FB'], ['surface-raised', 'surface-raised', '#FFFFFF'], ['surface-alt', 'surface-alt', '#ECEEF7'], ['placeholder', 'placeholder-ground', '#DDE1F0']]},
    {key: 'text', colors: [['ink', 'ink', '#262B3F'], ['ink-strong', 'ink-strong', '#000000'], ['muted', 'ink-muted', '#5A6078'], ['line', 'line', '#262B3F'], ['line-soft', 'line-soft', '#D8DCEC']]},
    {key: 'accent', colors: [['accent', 'accent', '#E0501A'], ['accent-strong', 'accent-strong', '#3A3FB0'], ['accent-strong-hover', 'accent-strong-hover', '#2D3190'], ['accent-strong-active', 'accent-strong-active', '#232673'], ['accent-soft', 'accent-soft', '#E6E8FB'], ['on-accent', 'on-accent', '#FFFFFF']]},
    {key: 'states', colors: [['focus', 'focus', '#000000'], ['error', 'error', '#B3261E'], ['error-soft', 'error-soft', '#FBE9E7'], ['success', 'success', '#1B6E45'], ['success-soft', 'success-soft', '#E2F1E8'], ['disabled', 'disabled-ground', '#E3E6F0'], ['disabled-ink', 'disabled-ink', '#5A5F77']]},
    {key: 'overlay', colors: [['overlay', 'overlay-ground', '#ECEEF7'], ['overlay-circle', 'overlay-circle', '#DFE3F3']]},
] %}
{# [role, desktop, phone] #}
{% set type_roles = [
    ['display', '52/58 · 700', '36/44 · 700'], ['h1', '40/48 · 700', '30/38 · 700'], ['h2', '26/34 · 700', '24/32 · 700'], ['h3', '18/26 · 700', '18/26 · 700'],
    ['body', '16/26 · 400', '16/26 · 400'], ['small', '14/22 · 400', '14/22 · 400'], ['button', '14/20 · 700', '14/20 · 700'], ['tag', '13/18 · 600', '13/18 · 600'],
] %}
{% set icons = [
    'binoculars', 'building-2', 'calendar', 'camera', 'car', 'check', 'chevron-down', 'chevron-left', 'chevron-right', 'coins', 'file-text',
    'globe', 'heart', 'house', 'info', 'landmark', 'mail', 'map-pin', 'maximize', 'menu', 'mountain-snow', 'music', 'phone',
    'plane', 'printer', 'route', 'sailboat', 'search', 'share-2', 'smile', 'sofa', 'sparkles', 'thumbs-up', 'train-front',
    'trees', 'user', 'utensils', 'waves', 'x',
] %}
{% set lage = [
    ['am_fluss', 'waves'], ['am_see', 'sailboat'], ['auf_dem_land', 'trees'], ['in_den_bergen', 'mountain-snow'], ['in_der_stadt', 'building-2'],
] %}
{# The board's two placeholder photos, redrawn in tokens through classes: `use` is reserved for the sprite, and no colour here may skip a token. #}
{% set castle %}<svg class="sg-photo" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect class="sg-photo__sky" width="1200" height="800"/><circle class="sg-photo__sun" cx="240" cy="170" r="64"/><path class="sg-photo__hill" d="M0 620 Q400 500 800 590 T1200 560 V800 H0Z"/><g class="sg-photo__wall"><rect x="520" y="300" width="300" height="300"/><rect x="470" y="220" width="90" height="380"/><rect x="790" y="240" width="90" height="360"/><path d="M460 220 L515 130 L570 220Z"/><path d="M780 240 L835 150 L890 240Z"/></g><g class="sg-photo__door"><rect x="640" y="470" width="70" height="130" rx="35"/><rect x="590" y="360" width="40" height="60" rx="20"/><rect x="720" y="360" width="40" height="60" rx="20"/></g><path class="sg-photo__ground" d="M0 680 Q500 620 1200 700 V800 H0Z"/></svg>{% endset %}
{% set mountain %}<svg class="sg-photo" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect class="sg-photo__sky" width="1200" height="800"/><circle class="sg-photo__sun" cx="300" cy="160" r="64"/><path class="sg-photo__hill" d="M0 560 L340 200 L560 450 L800 150 L1200 560 V800 H0Z"/><path class="sg-photo__sun" d="M270 275 L340 200 L415 285 L370 265 L340 300 L300 265Z"/><path class="sg-photo__sun" d="M720 245 L800 150 L880 233 L830 225 L800 262 L770 230Z"/><path class="sg-photo__ground" d="M0 610 Q400 520 800 600 T1200 590 V800 H0Z"/><rect class="sg-photo__door" x="880" y="540" width="170" height="90"/><path class="sg-photo__door" d="M860 545 L965 480 L1070 545Z"/></svg>{% endset %}
<div class="sg-page">
    <h1>{{ 'styleguide.title'|trans({}, 'styleguide') }}</h1>

    <section class="sg" id="sg-colors" data-component="colors" aria-labelledby="sg-colors-h">
        <h2 id="sg-colors-h">{{ 'styleguide.colors.heading'|trans({}, 'styleguide') }}</h2>
        <div class="sg-groups">
            {% for group in color_groups %}
                <div class="sg-color-group">
                    <h3 class="sg-state__label">{{ ('styleguide.colors.groups.' ~ group.key)|trans({}, 'styleguide') }}</h3>
                    <ul class="sg-colors">
                        {% for color in group.colors %}
                            <li class="sg-color">
                                <span class="sg-swatch sg-swatch--{{ color[1] }}"></span>
                                <span class="sg-color__text"><strong>{{ color[0] }}</strong>{{ color[2] }}<span class="sg-color__note">{{ ('styleguide.colors.notes.' ~ color[0])|trans({}, 'styleguide') }}</span></span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="sg" id="sg-typography" data-component="typography" aria-labelledby="sg-typography-h">
        <h2 id="sg-typography-h">{{ 'styleguide.typography.heading'|trans({}, 'styleguide') }}</h2>
        <div class="sg-type">
            <div class="sg-type__head">
                <span class="sg-state__label">{{ 'styleguide.typography.role'|trans({}, 'styleguide') }}</span>
                <span class="sg-state__label">{{ 'styleguide.typography.desktop'|trans({}, 'styleguide') }}</span>
                <span class="sg-state__label">{{ 'styleguide.typography.phone'|trans({}, 'styleguide') }}</span>
            </div>
            {% for role in type_roles %}
                {% set note = ('styleguide.typography.roles.' ~ role[0])|trans({}, 'styleguide') %}
                <div class="sg-type__row">
                    <div class="sg-type__role">
                        <strong>{{ role[0] }}</strong>
                        <span class="sg-state__label sg-from-md">{{ note }}</span>
                        <span class="sg-state__label sg-below-md">{{ 'styleguide.typography.phone_line'|trans({phone: role[2], desktop: role[1], note: note}, 'styleguide') }}</span>
                    </div>
                    <div class="sg-from-md">
                        <span class="sg-type__sample sg-type__sample--{{ role[0] }}">{{ 'styleguide.typography.sample'|trans({}, 'styleguide') }}</span>
                        <span class="sg-state__label">{{ role[1] }}</span>
                    </div>
                    <div>
                        <span class="sg-type__sample sg-type__sample--{{ role[0] }} sg-type__sample--phone">{{ 'styleguide.typography.sample'|trans({}, 'styleguide') }}</span>
                        <span class="sg-state__label sg-from-md">{{ role[2] }}</span>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    <div class="sg-pair">
        <section class="sg" id="sg-spacing" data-component="spacing" aria-labelledby="sg-spacing-h">
            <h2 id="sg-spacing-h">{{ 'styleguide.spacing.heading'|trans({}, 'styleguide') }}</h2>
            <ul class="sg-spaces">
                {% for step in ['4', '8', '12', '16', '24', '32', '40', '64'] %}
                    <li><span>{{ step }}</span><span class="sg-space sg-space--{{ step }}"></span></li>
                {% endfor %}
            </ul>
        </section>

        <section class="sg" id="sg-radii-shadows" data-component="radii-shadows" aria-labelledby="sg-radii-shadows-h">
            <h2 id="sg-radii-shadows-h">{{ 'styleguide.radii_shadows.heading'|trans({}, 'styleguide') }}</h2>
            <ul class="sg-radii">
                {% for radius in [['small', '12'], ['image', '24'], ['card', '40'], ['pill', '999']] %}
                    <li><span class="sg-box sg-box--radius-{{ radius[0] }}"></span><span><strong>{{ 'radius-' ~ radius[0] }}</strong> {{ radius[1] }}</span></li>
                {% endfor %}
            </ul>
        </section>
    </div>

    <section class="sg" id="sg-shadow" data-component="shadow" aria-labelledby="sg-shadow-h">
        <h2 id="sg-shadow-h">{{ 'styleguide.shadow.heading'|trans({}, 'styleguide') }}</h2>
        <div class="sg-surface sg-shadows">
            <div class="sg-shadow sg-shadow--card"><strong>{{ 'styleguide.shadow.card'|trans({}, 'styleguide') }}</strong><p>{{ 'styleguide.shadow.card_note'|trans({}, 'styleguide') }}</p></div>
            <div class="sg-shadow sg-shadow--float"><strong>{{ 'styleguide.shadow.float'|trans({}, 'styleguide') }}</strong><p>{{ 'styleguide.shadow.float_note'|trans({}, 'styleguide') }}</p></div>
        </div>
    </section>

    <section class="sg" id="sg-buttons" data-component="buttons" aria-labelledby="sg-buttons-h">
        <h2 id="sg-buttons-h">{{ 'styleguide.buttons.heading'|trans({}, 'styleguide') }}</h2>
        <div class="sg-groups" data-component="button-states">
            {% for variant in ['primary', 'secondary', 'ghost'] %}
                <div class="sg-group">
                    <h3 class="sg-subheading">{{ ('styleguide.button_states.' ~ variant)|trans({}, 'styleguide') }}</h3>
                    <div class="sg-row">
                        {% for state in ['normal', 'hover', 'active', 'focus'] %}
                            <div class="sg-state">
                                <span class="sg-state__label">{{ ('styleguide.states.' ~ state)|trans({}, 'styleguide') }}</span>
                                <button type="button" class="btn btn--{{ variant }} sg-force-{{ state }}">{{ 'styleguide.button_states.sample'|trans({}, 'styleguide') }}</button>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
            <div class="sg-group">
                <h3 class="sg-subheading">{{ 'styleguide.states.disabled'|trans({}, 'styleguide') }}</h3>
                <div class="sg-row">
                    <div class="sg-state">
                        <span class="sg-state__label">{{ 'styleguide.states.normal'|trans({}, 'styleguide') }}</span>
                        {{ include('components/_button.html.twig', {label: 'styleguide.button_states.sample'|trans({}, 'styleguide'), attributes: {disabled: 'disabled'}}, with_context = false) }}
                    </div>
                </div>
            </div>
            <div class="sg-group">
                <h3 class="sg-subheading">{{ 'styleguide.button_states.sizes'|trans({}, 'styleguide') }}</h3>
                <div class="sg-row">
                    <div class="sg-state">
                        <span class="sg-state__label">{{ 'styleguide.button_states.md'|trans({}, 'styleguide') }}</span>
                        {{ include('components/_button.html.twig', {label: 'styleguide.buttons.check_availability'|trans({}, 'styleguide'), icon: 'calendar'}, with_context = false) }}
                    </div>
                    <div class="sg-state">
                        <span class="sg-state__label">{{ 'styleguide.button_states.lg'|trans({}, 'styleguide') }}</span>
                        {{ include('components/_button.html.twig', {label: 'styleguide.button_states.search'|trans({}, 'styleguide'), size: 'lg'}, with_context = false) }}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="sg-pair">
        <section class="sg" id="sg-round-buttons" data-component="round-buttons" aria-labelledby="sg-round-buttons-h">
            <h2 id="sg-round-buttons-h">{{ 'styleguide.round_buttons.heading'|trans({}, 'styleguide') }}</h2>
            <div class="sg-row sg-surface">
                <div class="sg-state">
                    <span class="sg-state__label">{{ 'styleguide.round_buttons.close'|trans({}, 'styleguide') }}</span>
                    {{ include('components/_button.html.twig', {label: 'layout.close'|trans, variant: 'close', icon: 'x', label_hidden: true}, with_context = false) }}
                </div>
                {% for state in [{key: 'normal', pressed: 'false', class: ''}, {key: 'pressed', pressed: 'true', class: ''}, {key: 'hover', pressed: 'false', class: ' sg-force-hover'}, {key: 'focus', pressed: 'false', class: ' sg-force-focus'}] %}
                    <div class="sg-state">
                        <span class="sg-state__label">{{ ('styleguide.states.' ~ state.key)|trans({}, 'styleguide') }}</span>
                        <button type="button" class="merken__button sg-disc{{ state.class }}" aria-pressed="{{ state.pressed }}" aria-label="{{ 'styleguide.merken.label'|trans({}, 'styleguide') }}">{{ icon('heart') }}</button>
                    </div>
                {% endfor %}
            </div>
        </section>

        <section class="sg" id="sg-merken" data-component="merken" aria-labelledby="sg-merken-h">
            <h2 id="sg-merken-h">{{ 'styleguide.merken.heading'|trans({}, 'styleguide') }}</h2>
            <div class="sg-row sg-card sg-merken">
                <div class="sg-state">
                    <span class="sg-state__label">{{ 'styleguide.states.normal'|trans({}, 'styleguide') }}</span>
                    {{ include('favorites/_merken_button.html.twig', {number: 1, name: 'styleguide.merken.venue'|trans({}, 'styleguide'), variant: 'detail'}, with_context = false) }}
                </div>
                <div class="sg-state">
                    <span class="sg-state__label">{{ 'styleguide.merken.saved'|trans({}, 'styleguide') }}</span>
                    <button type="button" class="merken__button" aria-pressed="true" aria-label="{{ 'styleguide.merken.label'|trans({}, 'styleguide') }}">{{ icon('heart') }}<span class="merken__text">{{ 'styleguide.merken.label'|trans({}, 'styleguide') }}</span></button>
                </div>
                <div class="sg-state">
                    <span class="sg-state__label">{{ 'styleguide.merken.on_list'|trans({}, 'styleguide') }}</span>
                    {{ include('favorites/_remove_button.html.twig', {number: 1, name: 'styleguide.merken.venue'|trans({}, 'styleguide')}, with_context = false) }}
                </div>
            </div>
        </section>
    </div>

    <section class="sg" id="sg-chips" data-component="chips" aria-labelledby="sg-chips-h">
        <h2 id="sg-chips-h">{{ 'styleguide.chips.heading'|trans({}, 'styleguide') }}</h2>
        <div class="sg-stack">
            <div class="sg-row">
                <div class="sg-state">
                    <span class="sg-state__label">{{ 'styleguide.states.normal'|trans({}, 'styleguide') }}</span>
                    <button type="button" class="chip chip--neutral" aria-pressed="false">{{ 'styleguide.chips.castle'|trans({}, 'styleguide') }}</button>
                </div>
                <div class="sg-state">
                    <span class="sg-state__label">{{ 'styleguide.chips.selected'|trans({}, 'styleguide') }}</span>
                    <button type="button" class="chip chip--selected" aria-pressed="true">{{ 'styleguide.chips.castle'|trans({}, 'styleguide') }}{{ icon('check') }}</button>
                </div>
                <div class="sg-state">
                    <span class="sg-state__label">{{ 'styleguide.chips.active'|trans({}, 'styleguide') }}</span>
                    {{ include('components/_chip.html.twig', {label: 'styleguide.chips.zurich'|trans({}, 'styleguide'), href: path('_styleguide'), remove_label: 'styleguide.chips.remove_zurich'|trans({}, 'styleguide')}, with_context = false) }}
                </div>
                <div class="sg-state">
                    <span class="sg-state__label">{{ 'styleguide.chips.with_icon'|trans({}, 'styleguide') }}</span>
                    <button type="button" class="chip chip--neutral" aria-pressed="false">{{ icon('waves') }}{{ 'styleguide.lage.am_see'|trans({}, 'styleguide') }}</button>
                </div>
                <div class="sg-state">
                    <span class="sg-state__label">{{ 'styleguide.chips.canton_link'|trans({}, 'styleguide') }}</span>
                    {{ include('components/_chip.html.twig', {label: 'styleguide.chips.zurich'|trans({}, 'styleguide'), href: path('_styleguide'), variant: 'neutral'}, with_context = false) }}
                </div>
            </div>
            <div class="sg-row" data-component="tiles">
                <div class="sg-state">
                    <span class="sg-state__label">{{ 'styleguide.chips.tile'|trans({}, 'styleguide') }}</span>
                    <button type="button" class="tile" aria-pressed="false"><span class="tile__disc">{{ icon('waves') }}</span><span>{{ 'styleguide.lage.am_fluss'|trans({}, 'styleguide') }}</span></button>
                </div>
                <div class="sg-state">
                    <span class="sg-state__label">{{ 'styleguide.chips.tile_selected'|trans({}, 'styleguide') }}</span>
                    <button type="button" class="tile" aria-pressed="true"><span class="tile__disc">{{ icon('sailboat') }}<span class="tile__check">{{ icon('check') }}</span></span><span>{{ 'styleguide.lage.am_see'|trans({}, 'styleguide') }}</span></button>
                </div>
            </div>
        </div>
    </section>

    <section class="sg" id="sg-badge" data-component="badge" aria-labelledby="sg-badge-h">
        <h2 id="sg-badge-h">{{ 'styleguide.badge.heading'|trans({}, 'styleguide') }}</h2>
        <div class="sg-row">
            <div class="sg-state">
                <span class="sg-state__label">{{ 'styleguide.badge.tier'|trans({}, 'styleguide') }}</span>
                <div class="sg-row sg-row--tight">
                    {{ include('components/_badge.html.twig', {label: 'tier.promoted'|trans({}, 'venues')}, with_context = false) }}
                </div>
            </div>
            <div class="sg-state" data-component="tag">
                <span class="sg-state__label">{{ 'styleguide.badge.tag'|trans({}, 'styleguide') }}</span>
                <div class="sg-row sg-row--tight">
                    <span class="tag">{{ 'styleguide.badge.tag_price'|trans({}, 'styleguide') }}</span>
                    <span class="tag">{{ 'styleguide.badge.tag_sample'|trans({}, 'styleguide') }}</span>
                </div>
            </div>
        </div>
    </section>

    <section class="sg" id="sg-text-input" data-component="text-input" aria-labelledby="sg-text-input-h">
        <h2 id="sg-text-input-h">{{ 'styleguide.text_input.heading'|trans({}, 'styleguide') }}</h2>
        <div class="sg-fields" data-component="field-states">
            {{ include('components/_text_input.html.twig', {id: 'sg-first-name', name: 'first_name', label: 'styleguide.text_input.first_name'|trans({}, 'styleguide'), label_hidden: false, placeholder: 'styleguide.text_input.first_name_placeholder'|trans({}, 'styleguide'), help: 'styleguide.text_input.help'|trans({}, 'styleguide')}, with_context = false) }}
            <div class="text-input">
                <label class="text-input__label" for="sg-email-focus">{{ 'styleguide.text_input.email'|trans({}, 'styleguide') }}</label>
                <input class="text-input__field sg-force-focus" id="sg-email-focus" name="email_focus" type="text" value="{{ 'styleguide.text_input.email_value'|trans({}, 'styleguide') }}" autocomplete="off">
                <p class="text-input__help">{{ 'styleguide.text_input.focus_help'|trans({}, 'styleguide') }}</p>
            </div>
            {{ include('components/_text_input.html.twig', {id: 'sg-email-error', name: 'email_error', label: 'styleguide.text_input.email'|trans({}, 'styleguide'), label_hidden: false, value: 'styleguide.text_input.email_invalid'|trans({}, 'styleguide'), error: 'styleguide.text_input.error'|trans({}, 'styleguide')}, with_context = false) }}
            {{ include('components/_text_input.html.twig', {id: 'sg-guests', name: 'guests', type: 'number', label: 'styleguide.overlays.guests_label'|trans({}, 'styleguide'), label_hidden: false, placeholder: 'styleguide.text_input.guests_placeholder'|trans({}, 'styleguide'), icon: 'user'}, with_context = false) }}
            <div class="text-input">
                <label class="text-input__label" for="sg-occasion">{{ 'styleguide.text_input.occasion'|trans({}, 'styleguide') }}</label>
                <select class="text-input__field" id="sg-occasion" name="occasion">
                    {% for option in ['wedding', 'civil', 'apero', 'engagement', 'other'] %}
                        <option>{{ ('styleguide.text_input.occasion_' ~ option)|trans({}, 'styleguide') }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="text-input">
                <label class="text-input__label" for="sg-message">{{ 'styleguide.text_input.message'|trans({}, 'styleguide') }}</label>
                <textarea class="text-input__field" id="sg-message" name="message" rows="3">{{ 'styleguide.text_input.message_value'|trans({}, 'styleguide') }}</textarea>
            </div>
        </div>
    </section>

    <div class="sg-pair">
        <section class="sg sg-breadcrumb" id="sg-breadcrumb" data-component="breadcrumb" aria-labelledby="sg-breadcrumb-h">
            <h2 id="sg-breadcrumb-h">{{ 'styleguide.breadcrumb.heading'|trans({}, 'styleguide') }}</h2>
            {{ include('components/_breadcrumb.html.twig', {label: 'styleguide.breadcrumb.label'|trans({}, 'styleguide'), items: [{name: 'styleguide.breadcrumb.listing'|trans({}, 'styleguide'), url: path('_styleguide')}, {name: 'styleguide.breadcrumb.canton'|trans({}, 'styleguide'), url: path('_styleguide')}, {name: 'styleguide.breadcrumb.town'|trans({}, 'styleguide')}]}, with_context = false) }}
        </section>

        <section class="sg sg-toast-demo" id="sg-toast" data-component="toast" aria-labelledby="sg-toast-h">
            <h2 id="sg-toast-h">{{ 'styleguide.toast.heading'|trans({}, 'styleguide') }}</h2>
            {{ include('components/_toast.html.twig', {message: 'styleguide.toast.message'|trans({}, 'styleguide'), link_href: path('_styleguide'), link_label: 'styleguide.toast.link'|trans({}, 'styleguide')}, with_context = false) }}
        </section>
    </div>

    <div class="sg-pair">
        <section class="sg" id="sg-carousel" data-component="carousel" aria-labelledby="sg-carousel-h">
            <h2 id="sg-carousel-h">{{ 'styleguide.carousel.heading'|trans({}, 'styleguide') }}</h2>
            <div class="sg-carousel">
                {% embed 'components/_carousel.html.twig' with {id: 'sg-carousel-demo', label: 'styleguide.carousel.label'|trans({}, 'styleguide'), photo: castle, photo_label: 'styleguide.carousel.photo'|trans({}, 'styleguide')} only %}
                    {% block slides %}
                        {% for number in 1..8 %}
                            <li class="carousel__slide"><div class="sg-slide" role="img" aria-label="{{ photo_label }}">{{ photo }}</div></li>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
                <p class="sg-note sg-below-md">{{ 'styleguide.carousel.phone_note'|trans({}, 'styleguide') }}</p>
            </div>
        </section>

        <section class="sg" id="sg-dialog" data-component="dialog" aria-labelledby="sg-dialog-h">
            <h2 id="sg-dialog-h">{{ 'styleguide.dialog.heading'|trans({}, 'styleguide') }}</h2>
            <div class="sg-backdrop" inert>
                <div class="dialog" role="group" aria-label="{{ 'styleguide.dialog.heading'|trans({}, 'styleguide') }}">
                    <div class="dialog__header">
                        <h3 class="dialog__title">{{ 'styleguide.dialog.drawn_title'|trans({}, 'styleguide') }}</h3>
                        <button type="button" class="btn btn--close" aria-label="{{ 'layout.close'|trans }}">{{ icon('x') }}</button>
                    </div>
                    <p>{{ 'styleguide.dialog.drawn_body'|trans({}, 'styleguide') }}</p>
                    <div class="dialog__footer">{{ include('components/_button.html.twig', {label: 'layout.close'|trans, variant: 'secondary'}, with_context = false) }}</div>
                </div>
            </div>
        </section>
    </div>

    <section class="sg" id="sg-overlays" data-component="overlays" aria-labelledby="sg-overlays-h">
        <h2 id="sg-overlays-h">{{ 'styleguide.overlays.heading'|trans({}, 'styleguide') }}</h2>
        <div class="sg-stack" inert>
            {% for drawing in [{id: 'a', title: 'styleguide.overlays.drawn_region_title', bar: false}, {id: 'b', title: 'styleguide.overlays.drawn_more_title', bar: true}] %}
                <div class="sg-overlay">
                    {{ include('components/_button.html.twig', {label: 'layout.close'|trans, variant: 'close', icon: 'x', label_hidden: true}, with_context = false) }}
                    <h3 class="sg-overlay__title">{{ drawing.title|trans({}, 'styleguide') }}</h3>
                    <div class="sg-overlay__card text-input">
                        <label class="text-input__label" for="sg-drawn-canton-{{ drawing.id }}">{{ 'styleguide.overlays.canton_label'|trans({}, 'styleguide') }}</label>
                        <select class="text-input__field" id="sg-drawn-canton-{{ drawing.id }}">
                            {% for option in ['all_cantons', 'zurich', 'bern', 'lucerne'] %}
                                <option>{{ ('styleguide.overlays.option_' ~ option)|trans({}, 'styleguide') }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="sg-overlay__actions{{ drawing.bar ? ' sg-overlay__actions--bar' }}">
                        {{ include('components/_button.html.twig', {label: 'styleguide.overlays.drawn_results'|trans({}, 'styleguide'), size: 'lg'}, with_context = false) }}
                        <a class="overlay__clear" href="{{ path('_styleguide') }}">{{ 'styleguide.overlays.clear'|trans({}, 'styleguide') }}</a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>

    <section class="sg" id="sg-focus-ring" data-component="focus-ring" aria-labelledby="sg-focus-ring-h">
        <h2 id="sg-focus-ring-h">{{ 'styleguide.focus_ring.heading'|trans({}, 'styleguide') }}</h2>
        <div class="sg-focus">
            <div class="sg-focus-card">
                <p class="sg-subheading">{{ 'styleguide.focus_ring.light'|trans({}, 'styleguide') }}</p>
                <div class="sg-row sg-row--wide">
                    <button type="button" class="btn btn--primary sg-force-focus">{{ 'styleguide.button_states.sample'|trans({}, 'styleguide') }}</button>
                    <a class="sg-link sg-force-focus" href="{{ path('_styleguide') }}">{{ 'styleguide.focus_ring.link'|trans({}, 'styleguide') }}</a>
                    <button type="button" class="btn btn--close sg-force-focus sg-close-on-white" aria-label="{{ 'layout.close'|trans }}">{{ icon('x') }}</button>
                </div>
            </div>
            <div class="sg-focus-photo">
                {{ mountain }}
                <span class="tag sg-focus-photo__label">{{ 'styleguide.focus_ring.photo'|trans({}, 'styleguide') }}</span>
                <button type="button" class="btn btn--icon sg-force-focus sg-force-halo" aria-label="{{ 'layout.carousel.next'|trans }}">{{ icon('chevron-right') }}</button>
            </div>
        </div>
    </section>

    <section class="sg" id="sg-map" data-component="map" aria-labelledby="sg-map-h">
        <h2 id="sg-map-h">{{ 'styleguide.map.heading'|trans({}, 'styleguide') }}</h2>
        <div class="sg-map-row">
            {{ include('styleguide/_canton_map.html.twig', ignore_missing = true) }}
            <div class="sg-map-side">
                <ul class="sg-legend">
                    {% for item in [['map-land', '#FFFFFF'], ['map-line', '#757B95'], ['map-hover', '#E0501A'], ['map-selected', '#1E2160'], ['map-lake', '#6B8AA0']] %}
                        <li><span class="sg-legend__dot sg-swatch--{{ item[0] }}"></span><span><strong>{{ item[0] }}</strong> {{ [item[1], ('styleguide.map.legend.' ~ item[0])|trans({}, 'styleguide')]|join(', ') }}</span></li>
                    {% endfor %}
                </ul>
                <div class="sg-state" data-component="tooltip">
                    <span class="sg-state__label">{{ 'styleguide.map.tooltip'|trans({}, 'styleguide') }}</span>
                    <span class="region-filter__tooltip sg-tooltip">{{ 'styleguide.chips.zurich'|trans({}, 'styleguide') }}</span>
                </div>
            </div>
        </div>
    </section>

    <section class="sg" id="sg-icons" data-component="icons" aria-labelledby="sg-icons-h">
        <h2 id="sg-icons-h">{{ 'styleguide.icons.heading'|trans({}, 'styleguide') }}</h2>
        <ul class="sg-icon-grid">
            {% for name in icons %}
                <li>{{ icon(name) }}<span>{{ name }}</span></li>
            {% endfor %}
        </ul>
    </section>

    {# Below this line nothing is on the board: the shells that open for real, and what the board has no sample for. #}
    <section class="sg" id="sg-extras" data-component="extras" aria-labelledby="sg-extras-h">
        <h2 id="sg-extras-h">{{ 'styleguide.extras.heading'|trans({}, 'styleguide') }}</h2>
        <p class="sg-note">{{ 'styleguide.extras.intro'|trans({}, 'styleguide') }}</p>
        <div class="sg-groups">
            <div class="sg-group">
                <h3 class="sg-subheading">{{ 'styleguide.extras.live'|trans({}, 'styleguide') }}</h3>
                <div class="sg-row">
                    <button type="button" class="btn btn--secondary" commandfor="sg-dialog-demo" command="show-modal">{{ 'styleguide.dialog.open'|trans({}, 'styleguide') }}</button>
                    <button type="button" class="btn btn--secondary" popovertarget="sg-overlay-region">{{ 'styleguide.overlays.open_region'|trans({}, 'styleguide') }}</button>
                    <button type="button" class="btn btn--secondary" popovertarget="sg-overlay-guests">{{ 'styleguide.overlays.open_guests'|trans({}, 'styleguide') }}</button>
                    <button type="button" class="btn btn--secondary" popovertarget="sg-overlay-more">{{ 'styleguide.overlays.open_more'|trans({}, 'styleguide') }}</button>
                </div>
            </div>
            <div class="sg-group" data-component="count-badge">
                <h3 class="sg-subheading">{{ 'styleguide.count_badge.heading'|trans({}, 'styleguide') }}</h3>
                <div class="sg-row"><span class="btn btn--icon site-header__favorites">{{ icon('heart') }}<span class="count-badge">3</span></span></div>
            </div>
            <div class="sg-group" data-component="brand">
                <h3 class="sg-subheading">{{ 'styleguide.brand.heading'|trans({}, 'styleguide') }}</h3>
                <div class="sg-row">
                    <div class="sg-state">
                        <span class="sg-state__label">{{ 'styleguide.brand.logo'|trans({}, 'styleguide') }}</span>
                        {#- The page's header already prints the art once, so the sample reuses it. -#}
                        <div class="sg-logo">{{ include('components/_logo.html.twig', {label: 'layout.logo_alt'|trans, reuse: true}, with_context = false) }}</div>
                    </div>
                </div>
                <div class="sg-row" data-component="photo-placeholder">
                    {% for code in [null, 'seminar', 'birthday', 'apero', 'christmas_party', 'wedding', 'concert', 'corporate_event'] %}
                        <div class="sg-state">
                            <span class="sg-state__label">{{ code ?? 'styleguide.brand.placeholder'|trans({}, 'styleguide') }}</span>
                            {{ include('components/_photo_placeholder.html.twig', {event_type: code, class: 'sg-placeholder'}, with_context = false) }}
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="sg-group">
                <h3 class="sg-subheading">{{ 'styleguide.extras.variants'|trans({}, 'styleguide') }}</h3>
                <div class="sg-row">
                    {{ include('components/_button.html.twig', {label: 'styleguide.buttons.map'|trans({}, 'styleguide'), variant: 'round', icon: 'map-pin'}, with_context = false) }}
                    {{ include('components/_button.html.twig', {label: 'styleguide.buttons.favorites'|trans({}, 'styleguide'), variant: 'round', icon: 'heart'}, with_context = false) }}
                    {{ include('components/_button.html.twig', {label: 'styleguide.lage.am_fluss'|trans({}, 'styleguide'), variant: 'round-lg', icon: 'waves'}, with_context = false) }}
                    {{ include('components/_button.html.twig', {label: 'styleguide.buttons.save_location'|trans({}, 'styleguide'), variant: 'secondary', icon: 'heart'}, with_context = false) }}
                    {{ include('components/_button.html.twig', {label: 'styleguide.buttons.share'|trans({}, 'styleguide'), variant: 'secondary', icon: 'share-2'}, with_context = false) }}
                    {{ include('components/_button.html.twig', {label: 'styleguide.buttons.print'|trans({}, 'styleguide'), variant: 'secondary', icon: 'printer'}, with_context = false) }}
                    <div class="sg-state">
                        <span class="sg-state__label">{{ 'styleguide.button_states.static'|trans({}, 'styleguide') }}</span>
                        {{ include('components/_button.html.twig', {label: 'styleguide.button_states.static_sample'|trans({}, 'styleguide'), static: true}, with_context = false) }}
                    </div>
                </div>
            </div>
            <div class="sg-group">
                <h3 class="sg-subheading">{{ 'styleguide.extras.states'|trans({}, 'styleguide') }}</h3>
                <div class="sg-row">
                    <div class="sg-state">
                        <span class="sg-state__label">{{ 'styleguide.states.hover'|trans({}, 'styleguide') }}</span>
                        <button type="button" class="chip chip--neutral sg-force-hover" aria-pressed="false">{{ 'styleguide.chips.castle'|trans({}, 'styleguide') }}</button>
                    </div>
                    <div class="sg-state">
                        <span class="sg-state__label">{{ 'styleguide.states.disabled'|trans({}, 'styleguide') }}</span>
                        <span class="chip chip--neutral" aria-disabled="true">{{ 'styleguide.chips.castle'|trans({}, 'styleguide') }}</span>
                    </div>
                    {{ include('components/_text_input.html.twig', {id: 'sg-disabled', name: 'disabled_field', label: 'styleguide.states.disabled'|trans({}, 'styleguide'), label_hidden: false, value: 'styleguide.buttons.disabled'|trans({}, 'styleguide'), disabled: true}, with_context = false) }}
                </div>
            </div>
            <div class="sg-group">
                <h3 class="sg-subheading">{{ 'styleguide.extras.grounds'|trans({}, 'styleguide') }}</h3>
                <div class="sg-row">
                    <div class="sg-row sg-row--tight sg-card">
                        {{ include('components/_badge.html.twig', {label: 'tier.promoted'|trans({}, 'venues')}, with_context = false) }}
                        <span class="tag">{{ 'styleguide.badge.tag_sample'|trans({}, 'styleguide') }}</span>
                    </div>
                    <div class="sg-row sg-row--tight sg-surface">
                        {{ include('components/_badge.html.twig', {label: 'tier.promoted'|trans({}, 'venues')}, with_context = false) }}
                    </div>
                </div>
            </div>
            <div class="sg-group">
                <h3 class="sg-subheading">{{ 'styleguide.extras.single_image'|trans({}, 'styleguide') }}</h3>
                <div class="sg-carousel">
                    {% embed 'components/_carousel.html.twig' with {id: 'sg-carousel-single', label: 'styleguide.carousel.single_label'|trans({}, 'styleguide'), photo: castle, photo_label: 'styleguide.carousel.photo'|trans({}, 'styleguide')} only %}
                        {% block slides %}
                            <li class="carousel__slide"><div class="sg-slide" role="img" aria-label="{{ photo_label }}">{{ photo }}</div></li>
                        {% endblock %}
                    {% endembed %}
                </div>
            </div>
        </div>

        {% embed 'components/_dialog.html.twig' with {id: 'sg-dialog-demo', title: 'styleguide.dialog.title'|trans({}, 'styleguide')} only %}
            {% block dialog_body %}<p>{{ 'styleguide.dialog.body'|trans({}, 'styleguide') }}</p>{% endblock %}
            {% block dialog_footer %}<button type="button" class="btn btn--primary" commandfor="{{ id }}" command="close">{{ 'styleguide.dialog.confirm'|trans({}, 'styleguide') }}</button>{% endblock %}
        {% endembed %}

        {% for overlay in [
            {tone: 'region', title: 'styleguide.overlays.region_title', label: 'styleguide.overlays.canton_label', placeholder: 'styleguide.overlays.canton_placeholder'},
            {tone: 'guests', title: 'styleguide.overlays.guests_title', label: 'styleguide.overlays.guests_label', placeholder: 'styleguide.overlays.guests_placeholder'},
            {tone: 'more', title: 'styleguide.overlays.more_title', label: 'styleguide.text_input.label', placeholder: 'styleguide.text_input.placeholder'},
        ] %}
            {% embed 'components/_overlay.html.twig' with {
                id: 'sg-overlay-' ~ overlay.tone,
                tone: overlay.tone,
                title: overlay.title|trans({}, 'styleguide'),
                input_label: overlay.label|trans({}, 'styleguide'),
                input_placeholder: overlay.placeholder|trans({}, 'styleguide'),
                lage: overlay.tone == 'more' ? lage : [],
                back_href: path('_styleguide'),
            } only %}
                {% block overlay_body %}
                    {{ include('components/_text_input.html.twig', {id: id ~ '-input', name: 'q', label: input_label, placeholder: input_placeholder}, with_context = false) }}
                    {% if lage is not empty %}
                        <div class="sg-lage">
                            <h3>{{ 'styleguide.overlays.lage'|trans({}, 'styleguide') }}</h3>
                            <div class="sg-grid">
                                {% for item in lage %}
                                    {{ include('components/_button.html.twig', {label: ('styleguide.lage.' ~ item[0])|trans({}, 'styleguide'), variant: 'round-lg', icon: item[1]}, with_context = false) }}
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                {% endblock %}
                {% block overlay_footer %}
                    {{ include('components/_button.html.twig', {label: 'styleguide.buttons.show_results'|trans({}, 'styleguide'), variant: 'primary', size: 'lg', type: 'submit'}, with_context = false) }}
                    <a class="overlay__clear" href="{{ back_href }}">{{ 'styleguide.overlays.clear'|trans({}, 'styleguide') }}</a>
                {% endblock %}
            {% endembed %}
        {% endfor %}
    </section>
</div>
{% endblock %}
