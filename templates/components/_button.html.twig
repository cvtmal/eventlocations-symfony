{#
    Button. Include with `only`:
      label (required, translated), variant: primary|secondary|ghost|round|round-lg|icon|close (default primary),
      size: md|lg (default md), href (→ <a>, else <button>), type (default button), icon (sprite id), label_hidden
      (default false: label becomes aria-label), attributes (map of extra attributes; keys are developer-controlled,
      values are escaped), static (default false: a plain <span> that only looks like the button, with no href, type,
      icon or attributes).
#}
{%- set variant = variant|default('primary') -%}
{%- set classes = 'btn btn--' ~ variant ~ (size|default('md') == 'lg' ? ' btn--lg' : '') -%}
{%- set label_hidden = label_hidden|default(false) -%}
{%- set icon_name = icon|default(null) -%}
{%- set href = href|default(null) -%}
{%- set extra -%}
    {%- for key, value in attributes|default({}) %} {{ key }}="{{ value }}"{% endfor -%}
{%- endset -%}
{%- set content -%}
    {%- if icon_name %}{{ icon(icon_name) }}{% endif -%}
    {%- if not label_hidden %}<span>{{ label }}</span>{% endif -%}
{%- endset -%}
{%- if static|default(false) -%}
<span class="{{ classes }} btn--static">{{ label }}</span>
{%- elseif href is not null -%}
<a class="{{ classes }}" href="{{ href }}"{% if label_hidden %} aria-label="{{ label }}"{% endif %}{{ extra }}>{{ content }}</a>
{%- else -%}
<button type="{{ type|default('button') }}" class="{{ classes }}"{% if label_hidden %} aria-label="{{ label }}"{% endif %}{{ extra }}>{{ content }}</button>
{%- endif -%}
