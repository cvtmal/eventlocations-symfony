{#
    Venue detail page (#8, DP-1 to DP-16). Sections in the original's order (research D2).
    Slots for later cycles (final names, see CLAUDE.md "Venues"):
      - {% block map %} at the end of <section id="standort"> (#15 fills it with venue_map(); nothing without coordinates), which renders only on venue.hasLocation();
      - {% block inquiry %} inside <section id="anfrage"> (#14 fills it with inquiry_form(); `inquiry` is the bound form of a POST re-render, `inquiry_undelivered` its G7 "stored, not delivered" state, and no whitespace, so :empty hides the section);
      - {% block google_rating %} after the head (#53 fills it with venue_google_rating(); nothing without a place ID or when hidden; the previews override it with a note);
      - {% block google_photos %} beside the placeholder of a venue without public photos (D12, places-photos: venue_google_photos(); every preview overrides it empty);
      - the Merken button in _actions via favorites/_merken_button.html.twig (#7/#13).
    The blocks live in this file on purpose: a block inside an included partial cannot be overridden.
#}
{% extends 'base.html.twig' %}

{% set seo = venue_seo(venue) %}

{% block title %}{{ seo.title }}{% endblock %}

{% block meta %}{{ include('seo/_meta.html.twig', {seo: seo, picture: venue.photos[0] ?? null}, with_context = false) }}{% endblock %}

{% block canonical %}<link rel="canonical" href="{{ seo.canonical }}"><link rel="alternate" type="text/markdown" href="{{ url('venue_markdown', {slug: venue.slug}) }}">{% endblock %}

{% block jsonld %}{{ parent() }}{{ venue_jsonld(venue) }}{{ breadcrumb_jsonld([{name: 'breadcrumb.listing'|trans({}, 'seo'), url: url('listing')}, {name: venue.name}]) }}{% endblock %}

{# A class name, not text: set as a variable so the raw-text scanner does not read it as copy. #}
{% block body_class %}{% set page_class = 'page-venue' %}{{ page_class }}{% endblock %}

{# The page type and venue for stats.js (#47), set the same way. #}
{% block stats_page %}{% set page_type = 'detail' %}{{ page_type }}{% endblock %}
{% block stats_venue %}{{ venue.number }}{% endblock %}

{% block hero %}
    {% if venue.photos is not empty %}
        {{ include('venues/detail/_hero.html.twig', {venue: venue}, with_context = false) }}
        {{ include('venues/detail/_gallery.html.twig', {venue: venue}, with_context = false) }}
    {% else %}
        <div class="venue-placeholder">{{ include('components/_photo_placeholder.html.twig', {}, with_context = false) }}{% block google_photos %}{{ venue_google_photos(venue) }}{% endblock %}</div>
    {% endif %}
{% endblock %}

{% block main %}
    {{ include('venues/detail/_nav.html.twig', {venue: venue}, with_context = false) }}
    <div class="venue-layout">
        {{ include('venues/detail/_actions.html.twig', {venue: venue}, with_context = false) }}
        <div class="venue-content">
            {{ include('venues/detail/_head.html.twig', {venue: venue, unconfirmed: unconfirmed|default(false)}, with_context = false) }}
            {% block google_rating %}{{ venue_google_rating(venue) }}{% endblock %}
            {% if venue.hasFacts() %}{{ include('venues/detail/_facts.html.twig', {venue: venue}, with_context = false) }}{% endif %}
            {% if venue.hasLastMinuteOffers() %}{{ include('venues/detail/_last_minute.html.twig', {venue: venue}, with_context = false) }}{% endif %}
            {% if venue.event.hasAny() %}{{ include('venues/detail/_event.html.twig', {venue: venue}, with_context = false) }}{% endif %}
            {% if venue.rooms is not empty %}{{ include('venues/detail/_rooms.html.twig', {venue: venue}, with_context = false) }}{% endif %}
            {% if venue.videos is not empty %}{{ include('venues/detail/_videos.html.twig', {venue: venue}, with_context = false) }}{% endif %}
            {% if venue.hasFaq() %}{{ include('venues/detail/_faq.html.twig', {venue: venue}, with_context = false) }}{% endif %}
            {% if venue.hasLocation() %}
            <section id="standort" class="venue-section venue-location" aria-labelledby="standort-title">
                {{ include('venues/detail/_location.html.twig', {venue: venue}, with_context = false) }}
                {% block map %}{{ venue_map(venue) }}{% endblock %}
            </section>
            {% endif %}
            {% if venue.hasContact() %}{{ include('venues/detail/_contact.html.twig', {venue: venue}, with_context = false) }}{% endif %}
            {% if venue.documents is not empty %}{{ include('venues/detail/_documents.html.twig', {venue: venue}, with_context = false) }}{% endif %}
            <section id="anfrage" class="venue-inquiry">{% block inquiry %}{{ inquiry_form(venue, inquiry ?? null, inquiry_undelivered ?? false) }}{% endblock %}</section>
            <p class="venue-report"><a href="{{ path('venue_report', {location: venue.number}) }}" rel="nofollow">{{ 'report.detail_link'|trans({}, 'venues') }}</a></p>
        </div>
    </div>
    {{ render(controller('App\\Search\\Controller\\SimilarVenuesController', {venueId: venue.id})) }}
{% endblock %}

{% block scripts %}
    <script type="module" src="{{ asset('js/carousel.js') }}"></script>
    <script type="module" src="{{ asset('js/dialog.js') }}"></script>
    <script type="module" src="{{ asset('js/share.js') }}"></script>
    <script type="module" src="{{ asset('js/print.js') }}"></script>
    <script type="module" src="{{ asset('js/phone-reveal.js') }}"></script>
    <script type="module" src="{{ asset('js/venue-map.js') }}"></script>
    {% if venue.videos is not empty %}<script type="module" src="{{ asset('js/venue-video.js') }}"></script>{% endif %}
    {# D48: both Google features are off by default, so their loaders ship only while they have something to do (f16). #}
    {% if venue_google_rating_live() %}<script type="module" src="{{ asset('js/google-rating.js') }}"></script>{% endif %}
    {% if venue_google_photos_enabled() %}<script type="module" src="{{ asset('js/google-photos.js') }}"></script>{% endif %}
{% endblock %}
