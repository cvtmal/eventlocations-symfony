{#
    Hochzeit (DP-17, S14): the owner facts, after the fact lists. Every row has its own condition, so an unknown fact
    shows nothing. Rendered only when venue.wedding.hasAny(). Instagram is in Kontakt. Params: venue.
#}
{% macro term_row(label, terms) %}
    {% if terms is not empty %}
        <div class="venue-facts__row">
            <dt>{{ label }}</dt>
            <dd>
                <ul class="venue-facts__values">
                    {% for term in terms %}
                        <li>{{ icon('check') }}<span>{{ term|trans }}</span></li>
                    {% endfor %}
                </ul>
            </dd>
        </div>
    {% endif %}
{% endmacro %}
{% set wedding = venue.wedding %}
<section class="venue-section venue-wedding" aria-labelledby="venue-wedding-title">
    <h2 id="venue-wedding-title" class="venue-section__title">{{ 'detail.wedding.heading'|trans({}, 'venues') }}</h2>
    <dl class="venue-facts__list">
        {% if wedding.priceLevel %}
            <div class="venue-facts__row">
                <dt>{{ 'detail.wedding.price_level'|trans({}, 'venues') }}</dt>
                <dd>{{ wedding.priceLevel|trans }}</dd>
            </div>
        {% endif %}
        {% if wedding.ambience %}
            <div class="venue-facts__row">
                <dt>{{ 'detail.wedding.ambience'|trans({}, 'venues') }}</dt>
                <dd>{{ wedding.ambience }}</dd>
            </div>
        {% endif %}
        {% if wedding.capacitySeated or wedding.capacityStanding or wedding.capacityNote %}
            <div class="venue-facts__row">
                <dt>{{ 'detail.wedding.capacity'|trans({}, 'venues') }}</dt>
                <dd>
                    {% if wedding.capacitySeated %}<div>{{ 'detail.wedding.seated'|trans({count: wedding.capacitySeated|swiss_number}, 'venues') }}</div>{% endif %}
                    {% if wedding.capacityStanding %}<div>{{ 'detail.wedding.standing'|trans({count: wedding.capacityStanding|swiss_number}, 'venues') }}</div>{% endif %}
                    {% if wedding.capacityNote %}<div>{{ wedding.capacityNote }}</div>{% endif %}
                </dd>
            </div>
        {% endif %}
        {{ _self.term_row('term_group.ceremony'|trans({}, 'venues'), wedding.ceremony) }}
        {% if wedding.party or wedding.hasCurfew is not null or wedding.partyNote %}
            <div class="venue-facts__row">
                <dt>{{ 'detail.wedding.party'|trans({}, 'venues') }}</dt>
                <dd>
                    {% if wedding.party %}<div>{{ wedding.party|trans }}</div>{% endif %}
                    {% if wedding.hasCurfew is same as(false) %}
                        <div>{{ 'detail.wedding.no_curfew'|trans({}, 'venues') }}</div>
                    {% elseif wedding.hasCurfew is same as(true) and wedding.curfewAt %}
                        <div>{{ 'detail.wedding.curfew_at'|trans({time: wedding.curfewAt}, 'venues') }}</div>
                    {% elseif wedding.hasCurfew is same as(true) %}
                        <div>{{ 'detail.wedding.curfew_unknown_time'|trans({}, 'venues') }}</div>
                    {% endif %}
                    {% if wedding.partyNote %}<div>{{ wedding.partyNote }}</div>{% endif %}
                </dd>
            </div>
        {% endif %}
        {{ _self.term_row('term_group.amenity'|trans({}, 'venues'), wedding.amenities) }}
        {{ _self.term_row('term_group.dining'|trans({}, 'venues'), wedding.dining) }}
        {{ _self.term_row('term_group.usage'|trans({}, 'venues'), wedding.usage) }}
        {{ _self.term_row('term_group.vendor'|trans({}, 'venues'), wedding.vendors) }}
        {{ _self.term_row('term_group.language'|trans({}, 'venues'), wedding.languages) }}
        {% if wedding.openingHours %}
            <div class="venue-facts__row">
                <dt>{{ 'detail.wedding.opening_hours'|trans({}, 'venues') }}</dt>
                <dd>{{ wedding.openingHours }}</dd>
            </div>
        {% endif %}
    </dl>
</section>
