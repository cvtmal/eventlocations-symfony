{#
    Videos (G15): one click-to-load facade per video, the same way as the Standort map (#15). Params: venue.
    The player iframe waits inert inside <template>, so nothing reaches YouTube or Vimeo before "Video laden (YouTube)" clones it
    (assets/js/venue-video.js); the loader is hidden until that script runs, and the provider link works without it.
    No thumbnail: a preview image would come from the provider before the click.
#}
<section id="videos" class="venue-section venue-videos" aria-labelledby="venue-videos-title">
    <h2 id="venue-videos-title" class="venue-section__title">{{ 'detail.videos.heading'|trans({}, 'venues') }}</h2>
    <ul class="venue-videos__list">
        {% for video in venue.videos %}
            {% set provider = video.provider.label() %}
            <li class="venue-video" data-venue-video>
                <div class="venue-video__facade" data-venue-video-facade>
                    {{ icon('play', {class: 'venue-video__icon'}) }}
                    <p class="venue-video__caption">{{ 'detail.videos.caption'|trans({position: loop.index, provider: provider}, 'venues') }}</p>
                    <div class="venue-video__loader" data-venue-video-loader hidden>
                        <button type="button" class="btn btn--primary" data-venue-video-load>{{ icon('play') }}<span>{{ 'detail.videos.load'|trans({provider: provider}, 'venues') }}</span></button>
                        <p class="venue-video__notice">{{ 'detail.videos.notice'|trans({provider: provider}, 'venues') }}</p>
                    </div>
                    <a class="btn btn--secondary venue-video__link" href="{{ video.watchUrl }}" target="_blank" rel="noopener">{{ 'detail.videos.open'|trans({provider: provider}, 'venues') }}<span class="visually-hidden">{{ 'detail.videos.new_tab'|trans({}, 'venues') }}</span></a>
                </div>
                <template data-venue-video-frame><iframe class="venue-video__frame" src="{{ video.embedUrl }}" title="{{ 'detail.videos.frame_title'|trans({position: loop.index, name: venue.name}, 'venues') }}" referrerpolicy="strict-origin-when-cross-origin" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen></iframe></template>
            </li>
        {% endfor %}
    </ul>
</section>
