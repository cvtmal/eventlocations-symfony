{# Bewertung (DP-6): "{label} ({score}) | {count}" and up to three highlights. Rendered only with a score. Params: venue. #}
<section id="bewertung" class="venue-section venue-rating" aria-labelledby="bewertung-title">
    <h2 id="bewertung-title" class="venue-section__title">{{ 'detail.rating.heading'|trans({}, 'venues') }}</h2>
    <p class="venue-rating__summary">
        {{ icon('thumbs-up') }}
        <span>{% if venue.ratingLabel %}{{ 'detail.rating.summary_labelled'|trans({label: venue.ratingLabel|trans, score: venue.ratingScore|swiss_number(1), count: venue.ratingCount|swiss_number}, 'venues') }}{% else %}{{ 'detail.rating.summary'|trans({score: venue.ratingScore|swiss_number(1), count: venue.ratingCount|swiss_number}, 'venues') }}{% endif %}</span>
    </p>
    {% if venue.highlights is not empty %}
        <p class="venue-rating__intro">{{ 'detail.rating.highlights_intro'|trans({}, 'venues') }}</p>
        <ul class="venue-rating__highlights">
            {% for highlight in venue.highlights %}
                <li>{{ icon(highlight.icon()) }}<q>{{ highlight|trans }}</q></li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
