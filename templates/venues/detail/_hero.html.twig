{# Hero (DP-2): full-width carousel of the venue-level photos; the first is the page's only LCP image. Params: venue. #}
{% if venue.photos is not empty %}
    <div id="bilder" class="venue-hero">
        {% embed 'components/_carousel.html.twig' with {id: 'venue-hero', label: 'detail.hero.label'|trans({name: venue.name}, 'venues'), photos: venue.photos} only %}
            {% block slides %}
                {% for photo in photos %}
                    <li class="carousel__slide">{{ loop.first
                        ? venue_picture(photo, sizes='100vw', priority=true, class='venue-hero__picture')
                        : venue_picture(photo, sizes='100vw', loading='lazy', class='venue-hero__picture') }}</li>
                {% endfor %}
            {% endblock %}
        {% endembed %}
        <div class="venue-hero__actions container">
            <button type="button" class="btn btn--black venue-hero__open" commandfor="venue-gallery" command="show-modal">{{ icon('maximize') }}<span>{{ 'detail.hero.open_gallery'|trans({}, 'venues') }}</span></button>
        </div>
    </div>
{% else %}
    <div class="venue-hero venue-hero--empty"></div>
{% endif %}
