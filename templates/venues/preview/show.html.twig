{#
    The private preview of an entry (G5, `VenuePreviewLinkController`): the public detail page, published or not, with
    the photos the public may see (`VenueDetailQuery::preview()`; without one, F6's placeholder) and a banner on top.
    Whoever holds the link may open it, so nothing here may reach a search engine, a statistic or a Referer: robots
    `noindex` (the response says the same), no canonical, hreflang, JSON-LD or social tags, no stats beacon, no Google element
    (its key check would send the address with the token to Google), and a note in place of the inquiry form (a preview
    takes no inquiries). The banner's two actions write to the site's address
    with the entry's number until G6 (claim) and G2 (corrections) give them their own pages.
#}
{% extends 'venues/detail/show.html.twig' %}

{% block title %}{{ 'preview.title'|trans({name: venue.name}, 'venues') }}{% endblock %}

{% block meta %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block canonical %}{% endblock %}

{% block hreflang %}{% endblock %}

{% block jsonld %}{% endblock %}

{% block stats_beacon %}{% endblock %}

{% block hero %}
    {% set claim_subject = 'preview.claim_subject'|trans({number: venue.number, name: venue.name}, 'venues') %}
    {% set correct_subject = 'preview.correct_subject'|trans({number: venue.number, name: venue.name}, 'venues') %}
    <div class="preview-banner preview-banner--public">
        <div class="preview-banner__inner container">
            <div class="preview-banner__body">
                <p class="preview-banner__label">{{ icon('info') }}<strong>{{ 'preview.unconfirmed'|trans({}, 'venues') }}</strong></p>
                <p class="preview-banner__text">{{ 'preview.intro'|trans({}, 'venues') }}</p>
            </div>
            <div class="preview-banner__actions">
                {{ include('components/_button.html.twig', {label: 'preview.claim'|trans({}, 'venues'), variant: 'primary', href: 'mailto:' ~ site_contact_email ~ '?subject=' ~ claim_subject|url_encode}, with_context = false) }}
                <a class="preview-banner__link" href="mailto:{{ site_contact_email }}?subject={{ correct_subject|url_encode }}">{{ 'preview.correct'|trans({}, 'venues') }}</a>
            </div>
        </div>
    </div>
    {{ parent() }}
{% endblock %}

{# Google's element would send the page address (and so the token) to Google with its key check (Wave G §4a.4). #}
{% block google_rating %}{% endblock %}

{% block inquiry %}<p class="preview-banner__note">{{ 'preview.inquiry_note'|trans({}, 'venues') }}</p>{% endblock %}
