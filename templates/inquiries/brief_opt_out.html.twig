{#
    The venue's opt-out of briefs (F13, BriefOptOutController). `state`: `ask` (one button that POSTs here), `done`
    or `unknown`. Private: robots `noindex`, no canonical, no stats beacon, no session.
#}
{% extends 'base.html.twig' %}

{% set name = venue ? venue.name : '' %}

{% block title %}{{ 'brief.opt_out.title'|trans({}, 'inquiries') }} | {{ 'layout.site_name'|trans }}{% endblock %}

{% block meta %}<meta name="robots" content="noindex, nofollow">{% endblock %}

{% block hreflang %}{% endblock %}

{% block jsonld %}{% endblock %}

{% block stats_beacon %}{% endblock %}

{% block body_class %}{% set page_class = 'page-error' %}{{ page_class }}{% endblock %}

{% block main %}
    <div class="error-page container">
        <span class="error-page__icon">{{ icon('mail') }}</span>
        {% if state == 'ask' %}
            <h1 class="error-page__heading">{{ 'brief.opt_out.heading'|trans({venue: name}, 'inquiries') }}</h1>
            <p class="error-page__text">{{ 'brief.opt_out.text'|trans({}, 'inquiries') }}</p>
            <form method="post" action="{{ path('inquiry_brief_opt_out', {token: token}) }}">
                {% include 'components/_button.html.twig' with {label: 'brief.opt_out.confirm'|trans({}, 'inquiries'), variant: 'primary', size: 'lg', type: 'submit'} only %}
            </form>
        {% elseif state == 'done' %}
            <h1 class="error-page__heading">{{ 'brief.opt_out.done_heading'|trans({}, 'inquiries') }}</h1>
            <p class="error-page__text">{{ 'brief.opt_out.done'|trans({venue: name}, 'inquiries') }}</p>
        {% else %}
            <h1 class="error-page__heading">{{ 'brief.opt_out.unknown_heading'|trans({}, 'inquiries') }}</h1>
            <p class="error-page__text">{{ 'brief.opt_out.unknown'|trans({}, 'inquiries') }}</p>
            {% include 'components/_button.html.twig' with {label: 'brief.opt_out.to_home'|trans({}, 'inquiries'), variant: 'secondary', size: 'lg', href: path('home')} only %}
        {% endif %}
    </div>
{% endblock %}
