{#
    "{Name} kontaktieren" (DP-13), rendered by inquiry_form() into the detail page's #anfrage. Params: venue, form, anchor.
    inquiry.js moves the caret of the prefilled message (F16 N4) and focuses the error summary of a re-render, which is
    also the POST's fragment target (`anchor`), so a screen reader reads it (F16). The fields are _fields.html.twig, shared with the brief page (F13).
#}
<div class="inquiry-form venue-section">
    <h2 class="venue-section__title">{{ 'form.heading'|trans({name: venue.name}, 'inquiries') }}</h2>
    <ul class="inquiry-form__promises">
        <li>{{ icon('check') }}<span>{{ 'form.promise.free'|trans({}, 'inquiries') }}</span></li>
        <li>{{ icon('check') }}<span>{{ 'form.promise.noncommittal'|trans({}, 'inquiries') }}</span></li>
        <li>{{ icon('check') }}<span>{{ 'form.promise.direct'|trans({}, 'inquiries') }}</span></li>
    </ul>
    {% if not form.vars.valid %}
        <div class="inquiry-form__summary" role="alert" id="{{ anchor }}" tabindex="-1" data-inquiry-focus>
            {{ icon('info') }}
            <div>
                <p>{{ 'form.error.summary'|trans({}, 'inquiries') }}</p>
                {% if form.vars.errors|length > 0 %}
                    <ul>{% for error in form.vars.errors %}<li>{{ error.message }}</li>{% endfor %}</ul>
                {% endif %}
            </div>
        </div>
    {% endif %}
    {{ form_start(form, {attr: {class: 'inquiry-form__form'}}) }}
        {{ include('inquiries/_fields.html.twig', {form: form}, with_context = false) }}
        {{ form_rest(form) }}
        <div class="inquiry-form__actions">
            {{ include('components/_button.html.twig', {label: 'form.submit'|trans({}, 'inquiries'), type: 'submit', size: 'lg'}, with_context = false) }}
            <p class="inquiry-form__privacy">{{ 'form.privacy'|trans({name: venue.name}, 'inquiries') }} <a href="{{ path('datenschutz') }}">{{ 'form.privacy_link'|trans({}, 'inquiries') }}</a></p>
        </div>
    {{ form_end(form) }}
</div>
