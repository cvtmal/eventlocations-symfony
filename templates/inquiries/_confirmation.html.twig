{# The confirmation state of DP-13, on the signed ?anfrage=gesendet URL. Constant per venue: no personal data, so it stays cacheable. Params: venue. #}
<div class="inquiry-form inquiry-form--sent venue-section">
    <h2 class="venue-section__title">{{ 'confirmation.heading'|trans({}, 'inquiries') }}</h2>
    <p>{{ 'confirmation.text'|trans({name: venue.name}, 'inquiries') }}</p>
    <p><a href="{{ path('venue_show', {slug: venue.slug}) }}#anfrage">{{ 'confirmation.again'|trans({}, 'inquiries') }}</a></p>
</div>
