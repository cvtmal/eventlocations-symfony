{#
    "Ähnliche Locations" (DP-15), rendered by App\Search\Controller\SimilarVenuesController and embedded by the
    Venues detail page. Params: venues (list<SimilarVenue>). Photos via #7's card_picture(), facts via
    search/_card_facts, the tier via components/_badge (D19).
#}
<section class="similar-venues" aria-labelledby="similar-venues-title">
    <div class="container">
        <div class="similar-venues__header">
            <h2 id="similar-venues-title" class="similar-venues__title">{{ 'similar.heading'|trans({}, 'search') }}</h2>
            <a class="similar-venues__all" href="{{ path('listing') }}">{{ 'similar.all'|trans({}, 'search') }}</a>
        </div>
        {% embed 'components/_carousel.html.twig' with {id: 'similar-venues', label: 'similar.label'|trans({}, 'search'), venues: venues} only %}
            {% block slides %}
                {% for venue in venues %}
                    {% set picture = venue.photo ? card_picture(venue.photo, venue.name) : null %}
                    <li class="carousel__slide similar-card">
                        {% if picture %}
                            {{ venue_picture(picture, sizes='(min-width: 1024px) 280px, 70vw', widths=[360, 640], class='similar-card__picture') }}
                        {% else %}
                            <span class="similar-card__placeholder"></span>
                        {% endif %}
                        <div class="similar-card__body">
                            {% if venue.tier.value != 'basic' %}{{ include('components/_badge.html.twig', {label: venue.tier|trans}, with_context = false) }}{% endif %}
                            <h3 class="similar-card__name"><a href="{{ path('venue_show', {slug: venue.slug}) }}">{{ venue.name }}</a></h3>
                            {{ include('search/_card_facts.html.twig', {capacity_min: venue.capacityMin, capacity_max: venue.capacityMax, place: venue.place}, with_context = false) }}
                        </div>
                    </li>
                {% endfor %}
            {% endblock %}
        {% endembed %}
    </div>
</section>
