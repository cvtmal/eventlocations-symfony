{% extends 'base.html.twig' %}

{% set seo = listing_seo(criteria, page, landing) %}
{#- #17: a landing page has its own h1, intro and breadcrumb; the plain listing keeps listing.heading. -#}
{% set count = {count: landing.venues ?? 0} %}
{% if landing is null %}
    {% set heading = 'listing.heading'|trans({}, 'search') %}
    {% set intro = null %}
{% elseif landing.type.value == 'building' %}
    {% set heading = ('landing.building.' ~ landing.building ~ '.heading')|trans({}, 'search') %}
    {% set intro = ('landing.building.' ~ landing.building ~ '.intro')|trans(count, 'search') %}
{% else %}
    {% set place = {canton: landing.canton ? landing.canton|trans : '', town: landing.townName ?? ''} %}
    {% set heading = ('landing.' ~ landing.type.value ~ '.heading')|trans(place, 'search') %}
    {% set intro = ('landing.' ~ landing.type.value ~ '.intro')|trans(place|merge(count), 'search') %}
{% endif %}
{#- #26: staff text replaces the intro (Markdown); without one #17's sentence stays. The plain listing's own block shows on its clean page 1 only (P12). -#}
{#- A captured set is Markup when it is not empty, so the safe HTML survives the include unescaped; empty it is ''. -#}
{% set intro_html -%}
    {%- if landing is not null -%}
        {{- content_block(landing.blockKey('intro'), intro) -}}
    {%- elseif not seo.noindex and page.page == 1 -%}
        {{- content_block('listing.intro') -}}
    {%- endif -%}
{%- endset %}
{% set breadcrumb = landing_breadcrumb(landing) %}
{% set share_photo = page.cards[0].photos[0] ?? null %}
{% set share_picture = share_photo ? card_picture(share_photo, page.cards[0].name) : null %}

{% block title %}{{ seo.title }}{% endblock %}

{% block meta %}{{ include('seo/_meta.html.twig', {seo: seo, picture: share_picture}, with_context = false) }}{% endblock %}

{% block canonical %}<link rel="canonical" href="{{ seo.canonical }}">{% endblock %}

{% block hreflang %}{% if not seo.noindex %}{{ include('shared/_hreflang.html.twig', {query: page.page > 1 ? {page: page.page} : {}}, with_context = false) }}{% endif %}{% endblock %}

{% block jsonld %}{{ parent() }}{% if not seo.noindex %}{{ listing_jsonld(page) }}{% endif %}{% if breadcrumb %}{{ breadcrumb_jsonld(breadcrumb) }}{% endif %}{% endblock %}

{% block hero %}
    {{ include('search/_hero.html.twig', {heading: heading, intro_html: intro_html, breadcrumb: breadcrumb, total: page.total, criteria: criteria}, with_context = false) }}
{% endblock %}

{% block main %}
    <div class="listing container">
        {%- if page.total > 0 %}
        <ol class="listing__results" aria-label="{{ 'listing.results_label'|trans({}, 'search') }}">
            {%- for card in page.cards %}
            <li class="listing__item">{{ include('search/_card.html.twig', {card: card, index: loop.index0}, with_context = false) }}</li>
            {%- endfor %}
        </ol>
        {{ include('search/_pagination.html.twig', {criteria: criteria, page: page, links: page_links}, with_context = false) }}
        {%- else %}
        {{ include('search/_empty.html.twig', with_context = false) }}
        {%- endif %}
        {{ include('search/_related_searches.html.twig', {links: landing_links(landing)}, with_context = false) }}
    </div>
{% endblock %}

{% block scripts %}
    <script type="module" src="{{ asset('js/carousel.js') }}"></script>
    <script type="module" src="{{ asset('js/live-count.js') }}"></script>
    <script type="module" src="{{ asset('js/region-filter.js') }}"></script>
    <script type="module" src="{{ asset('js/overlay-form.js') }}"></script>
    <script type="module" src="{{ asset('js/guests-filter.js') }}"></script>
{% endblock %}
