{#
    The home page's search (#36, HP-2; F5: Kanton, Anlass, Anzahl Gäste): a plain GET form to the listing, no script, so
    it works without JS. The selects are written out: `_text_input` has no select. Include with `only`:
      regions (list of {code, label}: the live cantons), events (list of suitable_for codes with data, vocabulary order).
    An empty choice submits `event[]=` or `guests=`, which SearchCriteria drops.
#}
<form class="home-search" method="get" action="{{ path('listing') }}" aria-label="{{ 'home.search.label'|trans({}, 'search') }}">
    <div class="text-input">
        <label class="text-input__label" for="home-canton">{{ 'home.search.canton'|trans({}, 'search') }}</label>
        <div class="text-input__control">
            <select class="text-input__field" id="home-canton" name="canton">
                <option value="">{{ 'home.search.canton_all'|trans({}, 'search') }}</option>
                {%- for region in regions %}
                <option value="{{ region.code }}">{{ region.label }}</option>
                {%- endfor %}
            </select>
        </div>
    </div>
    <div class="home-search__row">
        <div class="text-input">
            <label class="text-input__label" for="home-event">{{ 'home.search.event'|trans({}, 'search') }}</label>
            <div class="text-input__control">
                <select class="text-input__field" id="home-event" name="event[]">
                    <option value="">{{ 'home.search.event_all'|trans({}, 'search') }}</option>
                    {%- for code in events %}
                    <option value="{{ code }}">{{ ('term.suitable_for.' ~ code)|trans({}, 'venues') }}</option>
                    {%- endfor %}
                </select>
            </div>
        </div>
        {{ include('components/_text_input.html.twig', {id: 'home-guests', name: 'guests', type: 'number', label: 'home.search.guests'|trans({}, 'search'), label_hidden: false, placeholder: 'home.search.guests_placeholder'|trans({}, 'search'), icon: 'user'}, with_context = false) }}
    </div>
    {% include 'components/_button.html.twig' with {label: 'home.search.submit'|trans({}, 'search'), type: 'submit', size: 'lg'} only %}
</form>
