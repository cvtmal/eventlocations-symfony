{#
    The owner's facts in the "weitere Filter" overlay (#33, FI-7, S14): Preisniveau, Trauung, then Feier und Ausstattung
    (no curfew, exclusive use, the FILTER_CODES amenities). Include with `only`: criteria (SearchCriteria). Same hiding rule
    as _more_form.html.twig, per value: a chip shows when a published venue carries it or it is active, and a section
    without chips disappears with its legend, so with no facts at all this renders nothing. The chip macro takes its label,
    because _more_terms's macro builds `term.<group>.<code>` and the price and curfew labels are not terms.
#}
{%- macro chip(name, value, label, checked) -%}
    {%- set id = 'filter-more-' ~ name|trim('[]', 'right') ~ '-' ~ value -%}
    <li class="filter-more__chip">
        <input class="visually-hidden" type="checkbox" id="{{ id }}" name="{{ name }}" value="{{ value }}"{% if checked %} checked{% endif %}>
        <label for="{{ id }}">{{ label }}</label>
    </li>
{%- endmacro -%}
{%- import _self as wedding -%}
{%- set query = criteria.toQuery() -%}
{%- set groups = constant('App\\Search\\ReadModel\\SearchCriteria::PARAMS') -%}
{%- set active_price = query.price|default([]) -%}
{%- set prices = enum_cases('App\\Venues\\ValueObject\\PriceLevel')|filter(level => filter_has_data('price.' ~ level.value) or level.value in active_price) -%}
{%- if prices is not empty %}
<fieldset class="filter-more__section">
    <legend class="filter-more__title">{{ 'filter.more_price'|trans({}, 'search') }}</legend>
    <ul class="filter-more__chips">
        {%- for level in prices %}
        {{ wedding.chip('price[]', level.value, level|trans, level.value in active_price) }}
        {%- endfor %}
    </ul>
</fieldset>
{%- endif -%}
{{- include('search/filter/_more_terms.html.twig', {param: 'ceremony', group: groups.ceremony, criteria: criteria}, with_context = false) -}}
{%- set curfew = filter_has_data('curfew') or criteria.noCurfew -%}
{%- set usage = filter_terms(groups.usage, criteria) -%}
{%- set amenity = filter_terms(groups.amenity, criteria) -%}
{%- if curfew or usage is not empty or amenity is not empty %}
<fieldset class="filter-more__section">
    <legend class="filter-more__title">{{ 'filter.more_wedding'|trans({}, 'search') }}</legend>
    <ul class="filter-more__chips">
        {%- if curfew %}
        {{ wedding.chip('curfew', 'none', 'detail.wedding.no_curfew'|trans({}, 'venues'), criteria.noCurfew) }}
        {%- endif %}
        {%- for param, codes in {usage: usage, amenity: amenity} %}
            {%- set active = criteria.termCodes(groups[param]) %}
            {%- for code in codes %}
        {{ wedding.chip(param ~ '[]', code, ('term.' ~ groups[param].value ~ '.' ~ code)|trans({}, 'venues'), code in active) }}
            {%- endfor %}
        {%- endfor %}
    </ul>
</fieldset>
{%- endif -%}
