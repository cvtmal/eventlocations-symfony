{#
    Filter-bar slot "Anzahl Gäste" (#11, FI-3). Included twice with `with_context = false`: criteria (SearchCriteria),
    part: chips|trigger. Renders <li class="filter-bar__item">s: one chip per active value (part chips), or the trigger
    plus its overlay (part trigger). The form lives in search/filter/_guests_form.html.twig; the footer's submit button
    joins it by its `form` attribute, and "Filter löschen" is js/overlay-form.js's clear link. The chip shows the
    guest number ("80 Gäste", F5).
#}
{%- if part == 'chips' -%}
    {%- if criteria.guests is not null -%}
        {%- set label = 'filter.guests_chip'|trans({count: criteria.guests, formatted: criteria.guests|swiss_number}, 'search') -%}
        <li class="filter-bar__item">{{ include('components/_chip.html.twig', {label: label, href: listing_path_without(criteria, 'guests'), remove_label: 'chip.remove'|trans({label: label}, 'search'), variant: 'active'}, with_context = false) }}</li>
    {%- endif -%}
{%- elseif part == 'trigger' -%}
    <li class="filter-bar__item">
        {#- Below md the first word hides as .visually-hidden does, so "Gäste" shows and "Anzahl Gäste" stays the name (F7b). -#}
        {%- set words = 'filter.guests'|trans({}, 'search')|split(' ', 2) -%}
        <button type="button" class="btn btn--secondary" popovertarget="filter-guests"><span>{% if words|length > 1 %}<span class="filter-bar__wide">{{ words[0] }} </span>{{ words[1] }}{% else %}{{ words[0] }}{% endif %}</span></button>
        {% embed 'components/_overlay.html.twig' with {id: 'filter-guests', tone: 'guests', title: 'filter.guests_title'|trans({}, 'search'), criteria: criteria} only %}
            {% block overlay_body %}{{ include('search/filter/_guests_form.html.twig', {criteria: criteria}, with_context = false) }}{% endblock %}
            {% block overlay_footer %}
                {{- include('components/_button.html.twig', {label: 'filter.show_results_plain'|trans({}, 'search'), variant: 'primary', size: 'lg', type: 'submit', attributes: {
                    form: 'filter-guests-form',
                    'data-live-count-label': '',
                    'data-count-zero': 'filter.show_results'|trans({count: 0, formatted: '0'}, 'search'),
                    'data-count-one': 'filter.show_results'|trans({count: 1, formatted: '1'}, 'search'),
                    'data-count-other': 'filter.show_results'|trans({count: 2, formatted: '%n'}, 'search'),
                }}, with_context = false) -}}
                <a class="overlay__clear" href="{{ listing_path_without(criteria, ['guests']) }}" data-overlay-clear>{{ 'filter.reset'|trans({}, 'search') }}</a>
            {%- endblock %}
        {% endembed %}
    </li>
{%- endif -%}
