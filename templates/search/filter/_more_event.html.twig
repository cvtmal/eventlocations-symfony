{#
    The venue's event facts in the "weitere Filter" overlay (#33, FI-7, S14): Preisniveau, then Ausstattung (the FILTER_CODES
    amenities). Include with `only`: criteria (SearchCriteria). Same hiding rule as _more_form.html.twig, per value: a chip
    shows when a published venue carries it or it is active, and a section without chips disappears with its legend, so with
    no facts at all this renders nothing. The chip macro takes its label, because _more_terms's macro builds
    `term.<group>.<code>` and the price label is not a term.
#}
{%- macro chip(name, value, label, checked) -%}
    {%- set id = 'filter-more-' ~ name|trim('[]', 'right') ~ '-' ~ value -%}
    <li class="filter-more__chip">
        <input class="visually-hidden" type="checkbox" id="{{ id }}" name="{{ name }}" value="{{ value }}"{% if checked %} checked{% endif %}>
        <label for="{{ id }}">{{ label }}</label>
    </li>
{%- endmacro -%}
{%- import _self as event -%}
{%- set query = criteria.toQuery() -%}
{%- set groups = constant('App\\Search\\ReadModel\\SearchCriteria::PARAMS') -%}
{%- set active_price = query.price|default([]) -%}
{%- set prices = enum_cases('App\\Venues\\ValueObject\\PriceLevel')|filter(level => filter_has_data('price.' ~ level.value) or level.value in active_price) -%}
{%- if prices is not empty %}
<fieldset class="filter-more__section">
    <legend class="filter-more__title">{{ 'filter.more_price'|trans({}, 'search') }}</legend>
    <ul class="filter-more__chips">
        {%- for level in prices %}
        {{ event.chip('price[]', level.value, level|trans, level.value in active_price) }}
        {%- endfor %}
    </ul>
</fieldset>
{%- endif -%}
{%- set amenities = filter_terms(groups.amenity, criteria) -%}
{%- if amenities is not empty %}
    {%- set active = criteria.termCodes(groups.amenity) %}
<fieldset class="filter-more__section">
    <legend class="filter-more__title">{{ 'filter.more_amenity'|trans({}, 'search') }}</legend>
    <ul class="filter-more__chips">
        {%- for code in amenities %}
        {{ event.chip('amenity[]', code, ('term.' ~ groups.amenity.value ~ '.' ~ code)|trans({}, 'venues'), code in active) }}
        {%- endfor %}
    </ul>
</fieldset>
{%- endif -%}
