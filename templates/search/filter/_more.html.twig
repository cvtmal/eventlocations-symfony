{#
    Filter-bar slot "weitere Filter" (name search, property terms, access, room facts; #12, FI-4). Included twice with
    `with_context = false`: criteria (SearchCriteria), part: chips|trigger. Renders nothing for `chips`; for `trigger` one
    <li class="filter-bar__item"> with the overlay and either the trigger or, with an active filter here, the pill
    "weitere Filter (N)", where N counts params, not values, as on the original.
    `params` drives the pill's N, its × link, the reset link and _hidden_state; #33 appends its params here once.
    The form lives in search/filter/_more_form.html.twig; the footer's submit button joins it by its `form` attribute.
#}
{%- set params = ['q', 'setting', 'access', 'building', 'infra', 'furniture', 'tech', 'surroundings', 'rooms', 'area', 'height'] -%}
{%- if part == 'trigger' -%}
    {%- set query = criteria.toQuery() -%}
    {%- set active = params|filter(param => query[param] is defined)|length -%}
    <li class="filter-bar__item">
        {%- if active > 0 -%}
            <span class="chip chip--more"><button type="button" class="chip__open" popovertarget="filter-more">{{ 'filter.more_active'|trans({count: active}, 'search') }}</button><a class="chip__remove" href="{{ listing_path_without(criteria, params) }}" aria-label="{{ 'filter.more_remove'|trans({}, 'search') }}">{{ icon('x', {class: 'icon--sm'}) }}</a></span>
        {%- else -%}
            {{- include('components/_button.html.twig', {label: 'filter.more'|trans({}, 'search'), variant: 'outline', attributes: {popovertarget: 'filter-more'}}, with_context = false) -}}
        {%- endif -%}
        {% embed 'components/_overlay.html.twig' with {id: 'filter-more', tone: 'more', title: 'filter.more_title'|trans({}, 'search'), criteria: criteria, params: params} only %}
            {% block overlay_body %}{{ include('search/filter/_more_form.html.twig', {criteria: criteria, params: params}, with_context = false) }}{% endblock %}
            {% block overlay_footer %}
                {{- include('components/_button.html.twig', {label: 'filter.show_results_plain'|trans({}, 'search'), variant: 'black', type: 'submit', attributes: {
                    form: 'filter-more-form',
                    'data-live-count-label': '',
                    'data-count-zero': 'filter.show_results'|trans({count: 0, formatted: '0'}, 'search'),
                    'data-count-one': 'filter.show_results'|trans({count: 1, formatted: '1'}, 'search'),
                    'data-count-other': 'filter.show_results'|trans({count: 2, formatted: '%n'}, 'search'),
                }}, with_context = false) -}}
                <a class="overlay__clear" href="{{ listing_path_without(criteria, params) }}" data-overlay-clear>{{ 'filter.reset'|trans({}, 'search') }}</a>
            {%- endblock %}
        {% endembed %}
    </li>
{%- endif -%}
