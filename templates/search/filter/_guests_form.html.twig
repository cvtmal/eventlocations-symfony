{#
    The guests overlay's GET form (#11, #51, FI-3). Include with `with_context = false`: criteria (SearchCriteria).
    Four radios, one per GuestBand (bands on capacity_max), drawn as bubbles; each input sits inside its label, so the
    visually hidden radio is positioned inside its bubble and a Tab stop scrolls to the bubble. The form holds no submit
    button: the overlay footer's joins through form="filter-guests-form", so Enter on a radio and the footer button
    both apply the band, with or without JS. No script of its own; js/overlay-form.js clears it.
    listing_form() gives the action, hidden state and count URL (#17), so a landing page keeps its path.
#}
{%- set target = listing_form(criteria, ['guests']) -%}
<form id="filter-guests-form" class="guests-filter" method="get" action="{{ target.action }}" autocomplete="off" data-live-count data-live-count-url="{{ target.count }}" data-overlay-form>
    {{- include('search/filter/_hidden_state.html.twig', {criteria: criteria, except: target.except}, with_context = false) -}}
    <fieldset class="guests-bands">
        <legend class="visually-hidden">{{ 'filter.guests'|trans({}, 'search') }}</legend>
        <div class="guests-bubbles">
            {%- for band in enum_cases('App\\Search\\ValueObject\\GuestBand') %}
            <label class="guests-bubble guests-bubble--{{ band.value }}"><input class="visually-hidden" type="radio" name="guests" value="{{ band.value }}"{% if criteria.guests is same as(band) %} checked{% endif %}><span class="guests-bubble__label">{{ band|trans }}</span></label>
            {%- endfor %}
        </div>
    </fieldset>
</form>
