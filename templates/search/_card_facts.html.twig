{#
    The card's facts line: guests and town. Shared (the listing card; #8 may reuse it for compact cards).
    Include with `only`: capacity_min (int|null), capacity_max (int), town_name.
#}
<ul class="card-facts">
    <li class="card-facts__item">{{ icon('user') }}{{ swiss_range(capacity_min ?? capacity_max, capacity_max) }}</li>
    <li class="card-facts__item">{{ icon('map-pin') }}{{ town_name }}</li>
</ul>
