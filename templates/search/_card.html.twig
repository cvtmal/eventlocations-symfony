{#
    One venue card (LP-2, LP-3). Owned by #7; #13 reuses it on /merkliste. Include with `only`:
      card (a ListingCard, or anything with its public properties: number, slug, name, promoted, capacityMin, capacityMax,
      place, summary, priceLevel, ambience, photos; eventType optional),
      index (0-based position on the page; 0 = the LCP image, 1 = eager; default 99 = lazy),
      action: merken|remove|none (default merken),
      heading: the title's element, h1 to h6 (default h2; a page with its own h2 above the cards passes h3),
      distance: an already-translated distance ("4 km") for the facts line (#52), default none,
      event_type: the code that picks the icon of the photo placeholder of a card without photos (components/_photo_placeholder), default
        card.eventType (F5b: the venue's first event type), else none (F6).
    The title link stretches over the card (.card__link::after) and is the card's one accessible link. The photo column
    sits above that overlay so the carousel can be swiped and its arrows clicked; each slide therefore carries its own
    link to the detail page (tabindex="-1", aria-hidden="true": no extra tab stop or screen-reader link), the placeholder
    of a venue without photos is the same link (#21: without one the whole column would be dead), and the
    Merken form sits above both. No interactive content is nested in the title link. A card with one photo sets
    scrollable false: its track would be a tab stop that scrolls nothing and has no name.
    The owner's price level and ambience are .tag pills under the summary (#33, LP-7), price first; a card without either
    has no .card__tags, so it stays exactly LP-2.
    `sizes` follows the photo column of _card.scss: 400 px from lg, 320 px from md, the page less 80 px of padding below.
    Only the first slide keeps its alt text: each slide's link is aria-hidden, so no reader meets them, and real alts are
    long and all different, about 19 KB gzip on a full listing (#41). The detail page shows every photo with its alt.
    The title prints `h` and the level apart because RawTextScanner reads a tag that starts with an expression as text.
    data-stats-venue lets stats.js (#47) count the card as an impression once half of it was in view.
#}
{%- set index = index|default(99) -%}
{%- set action = action|default('merken') -%}
{%- set level = heading|default('h2')|slice(1) -%}
{%- set pictures = card.photos|map(p => card_picture(p, card.name))|filter(p => p is not null) -%}
{%- set href = venue_path(card.slug) -%}
<article class="card" data-stats-venue="{{ card.number }}">
    <div class="card__media">
        {%- if pictures is not empty %}
        {% embed 'components/_carousel.html.twig' with {id: 'card-' ~ card.number ~ '-photos', label: 'card.photos_label'|trans({name: card.name}, 'search'), pictures: pictures, index: index, href: href, scrollable: pictures|length > 1} only %}
            {% block slides %}
                {%- for pic in pictures -%}
                <li class="carousel__slide"><a class="card__photo-link" href="{{ href }}" tabindex="-1" aria-hidden="true">{{ venue_picture(pic, sizes='(min-width: 1024px) 400px, (min-width: 768px) 320px, calc(100vw - 80px)', loading=(index == 1 and loop.first ? 'eager' : 'lazy'), priority=(index == 0 and loop.first), widths=[360, 640, 960], class='card__picture', decorative=not loop.first) }}</a></li>
                {%- endfor -%}
            {% endblock %}
        {% endembed %}
        {%- else %}
        <a class="card__photo-link card__placeholder" href="{{ href }}" tabindex="-1" aria-hidden="true">{{ include('components/_photo_placeholder.html.twig', {event_type: event_type ?? card.eventType ?? null}, with_context = false) }}</a>
        {%- endif %}
    </div>
    <div class="card__body">
        <div class="card__top">
            {{ include('search/_card_facts.html.twig', {capacity_min: card.capacityMin, capacity_max: card.capacityMax, place: card.place, distance: distance|default(null)}, with_context = false) }}
            {%- if action == 'merken' %}
            {{ include('favorites/_merken_button.html.twig', {number: card.number, name: card.name, variant: 'card'}, with_context = false) }}
            {%- elseif action == 'remove' %}
            {{ include('favorites/_remove_button.html.twig', {number: card.number, name: card.name}, with_context = false) }}
            {%- endif %}
        </div>
        <h{{ level }} class="card__title">
            {%- if card.promoted -%}
                {{ include('components/_badge.html.twig', {label: 'tier.promoted'|trans({}, 'venues'), title: 'promoted_note.title'|trans({}, 'venues')}, with_context = false) }}
            {%- endif -%}
            {%- if card.lastMinute -%}
                {{ include('components/_badge.html.twig', {label: 'card.last_minute'|trans({}, 'search')}, with_context = false) }}
            {%- endif -%}
            <a class="card__link" href="{{ href }}">{{ card.name }}</a>
        </h{{ level }}>
        <p class="card__summary">{{ card.summary }}</p>
        {%- if card.priceLevel is not null or card.ambience is not null %}
        <ul class="card__tags">
            {%- if card.priceLevel is not null %}
            <li><span class="visually-hidden">{{ 'card.price_level'|trans({}, 'search') }} </span><span class="tag">{{ card.priceLevel|trans }}</span></li>
            {%- endif %}
            {%- if card.ambience is not null %}
            <li><span class="tag">{{ card.ambience }}</span></li>
            {%- endif %}
        </ul>
        {%- endif %}
    </div>
</article>
