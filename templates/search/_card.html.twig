{#
    One venue card (LP-2, LP-3). Owned by #7; #13 reuses it on /merkliste. Include with `only`:
      card (a ListingCard, or anything with its public properties: number, slug, name, tier, capacityMin, capacityMax,
      townName, summary, ratingScore, ratingCount, highlights, photos),
      index (0-based position on the page; 0 = the LCP image, 1 = eager; default 99 = lazy),
      action: merken|none (default merken).
    The title link stretches over the card (.card__link::after) and is the card's one accessible link. The photo column
    sits above that overlay so the carousel can be swiped and its arrows clicked; each slide therefore carries its own
    link to the detail page (tabindex="-1", aria-hidden="true": no extra tab stop or screen-reader link), and the
    Merken form sits above both. No interactive content is nested in the title link.
#}
{%- set index = index|default(99) -%}
{%- set action = action|default('merken') -%}
{%- set pictures = card.photos|map(p => card_picture(p, card.name))|filter(p => p is not null) -%}
{%- set href = venue_path(card.slug) -%}
<article class="card">
    <div class="card__media">
        {%- if pictures is not empty %}
        {% embed 'components/_carousel.html.twig' with {id: 'card-' ~ card.number ~ '-photos', label: 'card.photos_label'|trans({name: card.name}, 'search'), pictures: pictures, index: index, href: href} only %}
            {% block slides %}
                {%- for pic in pictures -%}
                <li class="carousel__slide"><a class="card__photo-link" href="{{ href }}" tabindex="-1" aria-hidden="true">{{ venue_picture(pic, sizes='(min-width: 1440px) 448px, (min-width: 768px) 348px, 100vw', loading=(index == 1 and loop.first ? 'eager' : 'lazy'), priority=(index == 0 and loop.first), widths=[360, 640, 960], class='card__picture') }}</a></li>
                {%- endfor -%}
            {% endblock %}
        {% endembed %}
        {%- else %}
        <div class="card__placeholder"></div>
        {%- endif %}
    </div>
    <div class="card__body">
        <div class="card__top">
            {{ include('search/_card_facts.html.twig', {capacity_min: card.capacityMin, capacity_max: card.capacityMax, town_name: card.townName}, with_context = false) }}
            {%- if action == 'merken' %}
            {{ include('favorites/_merken_button.html.twig', {number: card.number, name: card.name, variant: 'card'}, with_context = false) }}
            {%- endif %}
        </div>
        <h2 class="card__title">
            {%- if card.tier != enum('App\\Venues\\ValueObject\\Tier').Basic -%}
                {{ include('components/_badge.html.twig', {label: card.tier|trans}, with_context = false) }}
            {%- endif -%}
            <a class="card__link" href="{{ href }}">{{ card.name }}</a>
        </h2>
        <p class="card__summary">{{ card.summary }}</p>
        {%- if card.ratingScore is not null %}
        <div class="card__rating">
            {{ include('search/_card_rating.html.twig', {score: card.ratingScore, count: card.ratingCount ?? 0, highlights: card.highlights}, with_context = false) }}
        </div>
        {%- endif %}
    </div>
</article>
