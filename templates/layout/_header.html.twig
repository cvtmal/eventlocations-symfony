{# An error page can have no route at all, so the name may be null. #}
{% set current_route = app.request.attributes.get('_canonical_route', app.request.attributes.get('_route')) %}
{% set on_listing = current_route in ['listing', 'listing_landing', 'listing_town'] %}
<header class="site-header">
    <div class="site-header__inner">
        <a class="site-header__wordmark" href="{{ path('home') }}"><img src="{{ asset('images/logo-hzl.png') }}" alt="{{ 'layout.logo_alt'|trans }}" width="135" height="30"></a>
        <nav class="site-header__actions" aria-label="{{ 'layout.header.menu_label'|trans }}">
            <a class="site-header__link" href="{{ path('listing') }}"{% if on_listing %} aria-current="page"{% endif %}>{{ 'layout.header.locations'|trans }}</a>
            <a class="site-header__link" href="{{ path('home') ~ '#regionen' }}">{{ 'layout.header.regions'|trans }}</a>
            {# merkliste.js fills and unhides the badge; these strings stand in for 48 repeated attributes on the cards. data-sync-token is the constant of the stateless check, so cached HTML stays identical #}
            <a class="btn btn--icon site-header__favorites" href="{{ path('merkliste') }}" data-merkliste-link data-sync-token="{{ csrf_token('submit') }}" data-toast-added="{{ 'toast.added'|trans({name: '__name__'}, 'favorites') }}" data-toast-removed="{{ 'toast.removed'|trans({name: '__name__'}, 'favorites') }}" data-toast-full="{{ 'toast.full'|trans({}, 'favorites') }}" data-toast-link="{{ 'toast.link'|trans({}, 'favorites') }}">{{ icon('heart') }}<span class="visually-hidden">{{ 'layout.header.favorites'|trans }} </span><span class="count-badge" data-merkliste-count hidden></span></a>
            {% include 'components/_button.html.twig' with {label: 'layout.header.add_location'|trans, href: path('portal_register')} only %}
        </nav>
        <button type="button" class="btn btn--icon site-header__menu" popovertarget="main-menu" aria-label="{{ 'layout.header.menu_open'|trans }}">{{ icon('menu') }}</button>
    </div>
    <div id="main-menu" class="main-menu" popover data-overlay>
        <nav class="main-menu__nav" aria-label="{{ 'layout.header.phone_menu_label'|trans }}">
            <button type="button" class="btn btn--close main-menu__close" popovertarget="main-menu" popovertargetaction="hide" aria-label="{{ 'layout.close'|trans }}">{{ icon('x') }}</button>
            <ul class="main-menu__list">{{ include('layout/_main_menu.html.twig') }}</ul>
            <div class="main-menu__add-location">{% include 'components/_button.html.twig' with {label: 'layout.header.add_location'|trans, size: 'lg', href: path('portal_register')} only %}</div>
        </nav>
    </div>
</header>
