<header class="site-header">
    <div class="site-header__inner">
        <button type="button" class="btn btn--icon site-header__menu" popovertarget="main-menu" aria-label="{{ 'layout.header.menu_open'|trans }}">{{ icon('menu') }}</button>
        <a class="site-header__wordmark" href="{{ path('home') }}">{{ 'layout.site_name'|trans }}</a>
        <nav class="site-header__actions" aria-label="{{ 'layout.header.actions_label'|trans }}">
            <a class="btn btn--icon" href="{{ path('listing') }}" aria-label="{{ 'layout.header.search'|trans }}">{{ icon('search') }}</a>
            {# merkliste.js fills and unhides the badge; these strings stand in for 48 repeated attributes on the cards. data-sync-token is the constant of the stateless check, so cached HTML stays identical #}
            <a class="btn btn--icon site-header__favorites" href="{{ path('merkliste') }}" aria-label="{{ 'layout.header.favorites'|trans }}" data-merkliste-link data-sync-token="{{ csrf_token('submit') }}" data-count-label="{{ 'header.count_label'|trans({count: '__count__'}, 'favorites') }}" data-toast-added="{{ 'toast.added'|trans({name: '__name__'}, 'favorites') }}" data-toast-removed="{{ 'toast.removed'|trans({name: '__name__'}, 'favorites') }}" data-toast-full="{{ 'toast.full'|trans({}, 'favorites') }}" data-toast-link="{{ 'toast.link'|trans({}, 'favorites') }}">{{ icon('heart') }}<span class="count-badge" data-merkliste-count hidden></span></a>
        </nav>
    </div>
    <div id="main-menu" class="main-menu" popover data-overlay>
        <nav aria-label="{{ 'layout.header.menu_label'|trans }}">
            <button type="button" class="btn btn--close" popovertarget="main-menu" popovertargetaction="hide" aria-label="{{ 'layout.close'|trans }}">{{ icon('x') }}</button>
            <ul class="main-menu__list">{{ include('layout/_main_menu.html.twig') }}</ul>
        </nav>
    </div>
</header>
