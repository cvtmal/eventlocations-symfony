{#
    /llms.txt (llmstxt.org): the site in one Markdown file for language models. H1, summary quote, a short note,
    then H2 sections of `- [name](url): note`; "Optional" last, as the format reserves it for links a reader may skip.
    Autoescape is off (Markdown, not HTML): every text value goes through `md`; URLs come from the router.
    Params: site_name, cantons, towns, buildings (list<LandingPageEntry>, live pages only), venues (list<IndexedVenue>).
#}
{% macro landings(heading, entries) %}
{% if entries is not empty %}
## {{ heading|md }}

{% for entry in entries %}
- [{{ entry.name|md }}]({{ entry.url }}): {{ 'llms.landing_note'|trans({count: entry.venueCount, formatted: entry.venueCount|swiss_number}, 'seo')|md }}
{% endfor %}

{% endif %}
{% endmacro %}
{% autoescape false %}
# {{ site_name|md }}

> {{ 'llms.summary'|trans({}, 'seo')|md }}

{{ 'llms.about'|trans({}, 'seo')|md }}
{{ 'llms.filters'|trans({}, 'seo')|md }} {{ url('listing', {guests: 120}) }}

## {{ 'llms.section.search'|trans({}, 'seo')|md }}

- [{{ 'llms.home'|trans({}, 'seo')|md }}]({{ url('home') }}): {{ 'llms.home_note'|trans({}, 'seo')|md }}
- [{{ 'llms.listing'|trans({}, 'seo')|md }}]({{ url('listing') }}): {{ 'llms.listing_note'|trans({}, 'seo')|md }}

{{ _self.landings('llms.section.cantons'|trans({}, 'seo'), cantons) }}
{{ _self.landings('llms.section.towns'|trans({}, 'seo'), towns) }}
{{ _self.landings('llms.section.buildings'|trans({}, 'seo'), buildings) }}
{% if venues is not empty %}
## {{ 'llms.section.venues'|trans({}, 'seo')|md }}

{% for venue in venues %}
{% set notes = [
    venue.townName ? 'detail.head.place'|trans({zip: venue.zip ?? '', town: venue.townName}, 'venues') : null,
    venue.canton ? 'venue.canton_area'|trans({canton: venue.canton|trans}, 'seo') : null,
    'llms.capacity'|trans({count: venue.capacityMax|swiss_number}, 'seo'),
]|filter(note => note) %}
- [{{ venue.name|md }}]({{ url('venue_markdown', {slug: venue.slug}) }}): {{ notes|join(', ')|md }}
{% endfor %}

{% endif %}
## {{ 'llms.section.optional'|trans({}, 'seo')|md }}

- [{{ 'llms.sitemap'|trans({}, 'seo')|md }}]({{ url('sitemap') }}): {{ 'llms.sitemap_note'|trans({}, 'seo')|md }}
- [{{ 'legal.imprint.link'|trans({}, 'shared')|md }}]({{ url('impressum') }})
- [{{ 'legal.privacy.link'|trans({}, 'shared')|md }}]({{ url('datenschutz') }})
{% endautoescape %}
