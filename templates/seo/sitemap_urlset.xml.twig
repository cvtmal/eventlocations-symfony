<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{% for url in urls %}
    <url>
        <loc>{{ url.loc }}</loc>
{% if url.lastmod %}        <lastmod>{{ url.lastmod|date('c', 'UTC') }}</lastmod>
{% endif %}{% for image in url.images %}        <image:image><image:loc>{{ image }}</image:loc></image:image>
{% endfor %}    </url>
{% endfor %}
</urlset>
