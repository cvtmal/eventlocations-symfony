{#
    SEO-1: description, robots, Open Graph and Twitter tags. Params: seo (Seo\ValueObject\PageMeta), picture (?Picture).
    Include with `with_context = false`. The twitter:* tags are explicit: nothing relies on X's og:* fallback.
    A page without a photo of its own shares the brand's card (BRAND SWAP POINT: public/brand/og-default.png, 1200 × 630).
#}
{% set image = picture ? picture.shareImage() : {url: asset('brand/og-default.png'), width: 1200, height: 630} %}
{% if seo.description is not empty %}<meta name="description" content="{{ seo.description }}">{% endif %}
{% if seo.noindex %}<meta name="robots" content="noindex, follow">{% endif %}
<meta property="og:type" content="{{ seo.ogType }}">
<meta property="og:title" content="{{ seo.title }}">
{% if seo.description is not empty %}<meta property="og:description" content="{{ seo.description }}">{% endif %}
<meta property="og:url" content="{{ seo.canonical }}">
<meta property="og:site_name" content="{{ 'layout.site_name'|trans }}">
<meta property="og:locale" content="{{ app.request.locale ~ '_CH' }}">
{% if seo.latitude is not null %}
<meta property="place:location:latitude" content="{{ seo.latitude }}">
<meta property="place:location:longitude" content="{{ seo.longitude }}">
{% endif %}
<meta property="og:image" content="{{ absolute_url(image.url) }}">
<meta property="og:image:width" content="{{ image.width }}">
<meta property="og:image:height" content="{{ image.height }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo.title }}">
{% if seo.description is not empty %}<meta name="twitter:description" content="{{ seo.description }}">{% endif %}
<meta name="twitter:image" content="{{ absolute_url(image.url) }}">
