<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'layout.site_name'|trans }}{% endblock %}</title>
        {% block meta %}{% endblock %}
        {% block canonical %}{% endblock %}
        {% block hreflang %}{{ include('shared/_hreflang.html.twig', ignore_missing = true) }}{% endblock %}
        {{ include('layout/_brand_head.html.twig', {}, with_context = false) }}
        <link rel="stylesheet" href="{{ asset('styles/app.scss') }}">
        {% block stylesheets %}{% endblock %}
        {% block jsonld %}{{ site_jsonld() }}{% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        <a class="skip-link" href="#main">{{ 'layout.skip_to_content'|trans }}</a>
        {{ include('layout/_header.html.twig') }}
        {% block hero %}{% endblock %}
        <main id="main" tabindex="-1">{% block main %}{% endblock %}</main>
        {{ include('layout/_footer.html.twig') }}
        <div class="toast-region" role="status" aria-live="polite" data-toast-region></div>
        <script type="module" src="{{ asset('js/overlay.js') }}"></script>
        <script type="module" src="{{ asset('js/merkliste.js') }}"></script>
        {# A private page (G5's preview link) empties this block: no statistics. #}
        {% block stats_beacon %}
        <script type="module" src="{{ asset('js/stats.js') }}" data-stats-url="{{ path('_stats_collect') }}" data-stats-page="{% block stats_page %}{% set page_type = 'other' %}{{ page_type }}{% endblock %}" data-stats-venue="{% block stats_venue %}{% endblock %}"></script>
        {% endblock %}
        {% block scripts %}{% endblock %}
    </body>
</html>
