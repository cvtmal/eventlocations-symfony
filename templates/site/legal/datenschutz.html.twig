{#
    /datenschutz (#18). A draft for the owner's review, not legal advice. Every sentence is a literal key in
    `shared` (`legal.privacy.*`); the variable facts come from the controller.
    Variables: site (as /impressum), retention_months (%inquiries.retention_months%), merkliste_days (LegalController::MERKLISTE_DAYS),
    processors (%site.processors%, D26: key, name, location; the purpose is `legal.privacy.processors.<key>`).
    D48: the Google rating and photos paragraphs, the Maps title and Google's processor line follow the switches
    (venue_google_rating_enabled(), venue_google_photos_enabled()), so the page names only what the site does.
    f16: likewise the detail page's "Karte laden" paragraph (venue_map_embed_enabled(), GOOGLE_MAPS_EMBED_KEY) and the
    near-me map's (nearby_map_enabled(), GOOGLE_MAPS_JS_KEY). The rating paragraph needs the live rating
    (venue_google_rating_live(): switch on and the JS key); switched on without the key the rating is a plain link,
    named under "Links". `shows` lists what Google delivers (map, rating, photos joined by "_"; `none`): with nothing,
    the section is left out and Google's processor line names the YouTube videos only.
#}
{% extends 'base.html.twig' %}
{% set google_rating = venue_google_rating_live() %}
{% set google_rating_link = venue_google_rating_enabled() and not google_rating %}
{% set google_photos = venue_google_photos_enabled() %}
{% set google_map = venue_map_embed_enabled() %}
{% set google_nearby = nearby_map_enabled() %}
{% set google_shows = [google_map or google_nearby ? 'map', google_rating ? 'rating', google_photos ? 'photos']|filter(part => part)|join('_')|default('none') %}

{% block title %}{{ 'legal.privacy.page_title'|trans({}, 'shared') }}{% endblock %}

{% block meta %}<meta name="description" content="{{ 'legal.privacy.meta_description'|trans({}, 'shared') }}">{% endblock %}

{% block canonical %}<link rel="canonical" href="{{ url('datenschutz') }}">{% endblock %}

{% block main %}
    <div class="container legal">
        <h1 class="legal__title">{{ 'legal.privacy.title'|trans({}, 'shared') }}</h1>
        <p class="legal__updated">{{ 'legal.privacy.updated'|trans({}, 'shared') }}</p>
        <p>{{ 'legal.privacy.intro'|trans({}, 'shared') }}</p>
        <section class="legal__section">
            <h2>{{ 'legal.privacy.controller.title'|trans({}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.controller.text'|trans({}, 'shared') }}</p>
            {{ include('site/legal/_operator.html.twig', {site: site}, with_context = false) }}
            <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        </section>
        <section class="legal__section">
            <h2>{{ 'legal.privacy.inquiry.title'|trans({}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.inquiry.data'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.inquiry.purpose'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.inquiry.brief'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.inquiry.retention'|trans({months: retention_months}, 'shared') }}</p>
            <p>{{ 'legal.privacy.inquiry.feedback'|trans({}, 'shared') }}</p>
        </section>
        <section class="legal__section">
            <h2>{{ 'legal.privacy.crm.title'|trans({}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.crm.data'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.crm.purpose'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.crm.retention'|trans({}, 'shared') }}</p>
        </section>
        <section class="legal__section">
            <h2>{{ 'legal.privacy.report.title'|trans({}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.report.data'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.report.process'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.report.retention'|trans({}, 'shared') }}</p>
        </section>
        <section class="legal__section">
            <h2>{{ 'legal.privacy.merkliste.title'|trans({}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.merkliste.text'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.merkliste.content'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.merkliste.lifetime'|trans({days: merkliste_days}, 'shared') }}</p>
            <p>{{ 'legal.privacy.merkliste.processing'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.merkliste.control'|trans({}, 'shared') }}</p>
        </section>
        <section class="legal__section">
            <h2>{{ 'legal.privacy.stats.title'|trans({}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.stats.body'|trans({}, 'shared') }}</p>
        </section>
        <section class="legal__section">
            <h2>{{ 'legal.privacy.abuse.title'|trans({}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.abuse.text'|trans({}, 'shared') }}</p>
        </section>
        <section class="legal__section">
            <h2>{{ 'legal.privacy.processors.title'|trans({}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.processors.intro'|trans({}, 'shared') }}</p>
            <ul class="legal__processors">
                {%- for processor in processors %}
                <li><strong>{{ processor.name }}</strong>: {{ ('legal.privacy.processors.' ~ processor.key)|trans({shows: google_shows}, 'shared') }} ({{ processor.location }})</li>
                {%- endfor %}
            </ul>
        </section>
        <section class="legal__section">
            <h2>{{ 'legal.privacy.hosting.title'|trans({}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.hosting.web'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.hosting.database'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.hosting.mail'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.hosting.errors'|trans({}, 'shared') }}</p>
        </section>
        {% if google_shows != 'none' %}
        <section class="legal__section">
            <h2>{{ 'legal.privacy.maps.title'|trans({shows: google_shows}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.maps.intro'|trans({}, 'shared') }}</p>
            {% if google_map %}<p>{{ 'legal.privacy.maps.text'|trans({}, 'shared') }}</p>{% endif %}
            {% if google_nearby %}<p>{{ 'legal.privacy.maps.nearby'|trans({}, 'shared') }}</p>{% endif %}
            {% if google_rating %}<p>{{ 'legal.privacy.maps.rating'|trans({}, 'shared') }}</p>{% endif %}
            {% if google_photos %}<p>{{ 'legal.privacy.maps.photos'|trans({}, 'shared') }}</p>{% endif %}
            <p>{{ 'legal.privacy.maps.policy'|trans({}, 'shared') }} <a href="https://policies.google.com/privacy">{{ 'legal.privacy.maps.policy_link'|trans({}, 'shared') }}</a></p>
        </section>
        {% endif %}
        <section class="legal__section">
            <h2>{{ 'legal.privacy.videos.title'|trans({}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.videos.text'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.videos.modes'|trans({}, 'shared') }}</p>
            <p>{{ 'legal.privacy.videos.policy'|trans({}, 'shared') }} <a href="https://policies.google.com/privacy">{{ 'legal.privacy.videos.policy_youtube'|trans({}, 'shared') }}</a>, <a href="https://vimeo.com/privacy">{{ 'legal.privacy.videos.policy_vimeo'|trans({}, 'shared') }}</a></p>
        </section>
        <section class="legal__section">
            <h2>{{ 'legal.privacy.links.title'|trans({}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.links.text'|trans({}, 'shared') }}</p>
            {% if google_rating_link %}<p>{{ 'legal.privacy.links.rating'|trans({}, 'shared') }}</p>{% endif %}
        </section>
        <section class="legal__section">
            <h2>{{ 'legal.privacy.staff.title'|trans({}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.staff.text'|trans({}, 'shared') }}</p>
        </section>
        <section class="legal__section">
            <h2>{{ 'legal.privacy.rights.title'|trans({}, 'shared') }}</h2>
            <p>{{ 'legal.privacy.rights.text'|trans({}, 'shared') }}</p>
        </section>
    </div>
{% endblock %}
