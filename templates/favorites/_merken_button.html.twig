{#
    The "Merken ♡" button (S7, no-JS form). Include with `only`:
      number (venue number), name (venue name), label (visible text, translated; default 'merken.label'|trans({}, 'favorites')),
      variant: card|detail (default card).
    Created by #7; owned by #13 from now on. #8 includes it with variant: 'detail', label: 'merken.label_detail'|trans({}, 'favorites').
#}
{#
    Works without JS: the form posts to merkliste_toggle, and merkliste.js takes over when it runs.
    The token is the constant of the stateless same-origin check, so cached HTML stays the same for every visitor (S10).
#}
{%- set label = label|default('merken.label'|trans({}, 'favorites')) -%}
{%- set variant = variant|default('card') -%}
<form class="merken merken--{{ variant }}" method="post" action="{{ path('merkliste_toggle', {number: number}) }}"><input type="hidden" name="_token" value="{{ csrf_token('submit') }}"><button type="submit" class="merken__button" aria-pressed="false" aria-label="{{ 'merken.label_for'|trans({name: name}, 'favorites') }}" data-merken="{{ number }}" data-merken-name="{{ name }}">{{ icon('heart') }}<span class="merken__text">{{ label }}</span></button></form>
