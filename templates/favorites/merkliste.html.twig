{#
    /merkliste (MK-3). Variables: cards (list<ListingCard>, saved order), full (bool), max (int).
    The empty state, the count and the notice are always rendered, so merkliste.js can show and hide them without a reload.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'merkliste.title'|trans({}, 'favorites') }} | {{ 'layout.site_name'|trans }}{% endblock %}

{% block meta %}<meta name="robots" content="noindex, nofollow"><meta name="description" content="{{ 'merkliste.meta_description'|trans({}, 'favorites') }}">{% endblock %}

{% block main %}
    <div class="listing container merkliste" data-merkliste-page>
        <div class="merkliste__head">
            <h1 class="merkliste__title" tabindex="-1" data-merkliste-title>{{ 'merkliste.title'|trans({}, 'favorites') }}</h1>
            <p class="merkliste__count" data-merkliste-total data-count-one="{{ 'merkliste.count'|trans({count: 1, formatted: '1'}, 'favorites') }}" data-count-other="{{ 'merkliste.count'|trans({count: 2, formatted: '__count__'}, 'favorites') }}"{% if cards is empty %} hidden{% endif %}>{{ 'merkliste.count'|trans({count: cards|length, formatted: cards|length|swiss_number}, 'favorites') }}</p>
        </div>
        <p class="merkliste__notice" data-merkliste-full{% if not full %} hidden{% endif %}>{{ icon('info') }}<span>{{ 'merkliste.full'|trans({max: max|swiss_number}, 'favorites') }}</span></p>
        {%- if cards is not empty %}
        <ol class="listing__results" aria-label="{{ 'merkliste.results_label'|trans({}, 'favorites') }}">
            {%- for card in cards %}
            <li class="listing__item" data-merkliste-item>{{ include('search/_card.html.twig', {card: card, index: loop.index0, action: 'remove'}, with_context = false) }}</li>
            {%- endfor %}
        </ol>
        {%- endif %}
        <div class="listing-empty" data-merkliste-empty{% if cards is not empty %} hidden{% endif %}>
            <span class="listing-empty__disc" aria-hidden="true">{{ icon('heart') }}</span>
            <p class="listing-empty__title">{{ 'merkliste.empty.title'|trans({}, 'favorites') }}</p>
            {{ include('components/_button.html.twig', {href: path('listing'), label: 'merkliste.empty.cta'|trans({}, 'favorites'), size: 'lg'}, with_context = false) }}
        </div>
    </div>
{% endblock %}

{% block scripts %}<script type="module" src="{{ asset('js/carousel.js') }}"></script>{% endblock %}
