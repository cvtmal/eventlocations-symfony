# Template for /var/www/deine-eventlocation.ch/shared/.env.local, the one file with production secrets
# (#20, F15). chmod 600, owned by the deploy user, written once by hand, never committed; every release
# links to it and a deploy never writes it.
#
# Replace every __PLACEHOLDER__. Values in single quotes stay literal, so a $ in a password is safe.
# bin/deploy runs app:prod:check-env first and changes nothing while this file fails it.

APP_ENV=prod
APP_DEBUG=0
# At least 32 characters: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=__APP_SECRET__
DEFAULT_URI=https://deine-eventlocation.ch

# Neon's direct string, not the pooled one. No % anywhere (the value goes through Symfony's resolver),
# so a password that needs percent-encoding gets a new password instead.
DATABASE_URL='postgresql://__NEON_USER__:__NEON_PASSWORD__@__NEON_ENDPOINT__.eu-central-1.aws.neon.tech/__NEON_DATABASE__?serverVersion=18&charset=utf8&sslmode=require'
# If the probe shows libpq below 14 (no SNI), use this shape: the endpoint id goes into the password,
# never percent-encoded. Drop PGCHANNELBINDING below too if the probe could not connect with it.
#DATABASE_URL='postgresql://__NEON_USER__:endpoint=__NEON_ENDPOINT__;__NEON_PASSWORD__@__NEON_ENDPOINT__.eu-central-1.aws.neon.tech/__NEON_DATABASE__?serverVersion=18&charset=utf8&sslmode=require'
# DBAL drops channel_binding and connect_timeout from the URL, so neither goes there (app:prod:check-env refuses
# them). The connect timeout is in doctrine.yaml. Channel binding reaches libpq only as a process variable, so
# ChannelBindingMiddleware sets this one just before a connection. libpq below 13 ignores it silently: deploy/probe.sh check 8.
PGCHANNELBINDING=require

# Infomaniak SMTP, 587 with STARTTLS; the login is the full mailbox address, its @ is %40.
MAILER_DSN='smtp://hallo%40deine-eventlocation.ch:__MAILER_PASSWORD__@mail.infomaniak.com:587'
MAILER_FROM="deine-eventlocation.ch <hallo@deine-eventlocation.ch>"
# Must stay empty: any value sends every venue's inquiries and every CRM mail to that one address.
INQUIRY_RECIPIENT_OVERRIDE=

# Base64 of 32 bytes, encrypts the staff's TOTP secrets. Keep a copy in the password manager: without
# it every staff member has to enrol again. Must differ from the dev key in .env.
# php -r 'echo base64_encode(random_bytes(SODIUM_CRYPTO_SECRETBOX_KEYBYTES)), PHP_EOL;'
ADMIN_TOTP_KEY=__ADMIN_TOTP_KEY__
# Must stay empty: .env sets a dev value.
ADMIN_DEV_AUTOLOGIN=

# Originals, in shared/, so every release sees the same files. Absolute.
MEDIA_ROOT=/var/www/deine-eventlocation.ch/shared/var/media
# MEDIA_PUBLIC_DIR is not set here: production stays on the default public/media, which each release
# links to shared/public/media. Only bin/prod-import sets it, for its local mirror.
# CMS photo limits (#25, reasons in .env). Raise the pixels only together with memory_limit in public/.user.ini.
MEDIA_MAX_PIXELS=20000000
MEDIA_MAX_PORTRAIT_RATIO=2

# Maps Embed API key, restricted to that API and the site's referrer. Empty: only the link to Google Maps.
GOOGLE_MAPS_EMBED_KEY=
# Maps JavaScript API key for the near-me map (#52) and the Google rating on the detail page (#53);
# restrict it to the Maps JavaScript API and Places UI Kit and the site's referrers.
# Empty: the near-me page shows the list only, venue pages show only the link to the Google reviews,
# and no request goes to Google.
GOOGLE_MAPS_JS_KEY=
# The near-me map's raster JavaScript Map ID; required (and not DEMO_MAP_ID) once GOOGLE_MAPS_JS_KEY is set.
GOOGLE_MAPS_MAP_ID=
# Sentry EU project. Empty: no error reports.
SENTRY_DSN=

# Media backup (F15b, bin/cron-media-backup): restic copies shared/var/media to Infomaniak Object Storage
# every night, encrypted on the server. TODO(owner): the bucket, its S3 keys and the endpoint of its
# region (docs/operations.md, "Media backup"). Single quotes, as above; the script reads these lines itself.
MEDIA_BACKUP_REPOSITORY='s3:https://s3.pub1.infomaniak.cloud/__MEDIA_BACKUP_BUCKET__/deine-eventlocation'
# Encrypts the backup: without it the backup cannot be read. Keep a copy in the password manager, apart
# from the server. openssl rand -hex 32
MEDIA_BACKUP_PASSWORD='__MEDIA_BACKUP_PASSWORD__'
MEDIA_BACKUP_ACCESS_KEY_ID='__MEDIA_BACKUP_ACCESS_KEY_ID__'
MEDIA_BACKUP_SECRET_ACCESS_KEY='__MEDIA_BACKUP_SECRET_ACCESS_KEY__'
# Empty unless restic cannot find the bucket's region by itself.
MEDIA_BACKUP_REGION=

# nginx on the VPS talks to the visitor directly, so this stays unset. Only if a proxy or CDN is ever put
# in front (REMOTE_ADDR is private and X-Forwarded-For carries the client): its exact address, never REMOTE_ADDR.
#SYMFONY_TRUSTED_PROXIES=127.0.0.1,::1
