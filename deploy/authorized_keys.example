# One line in ~/.ssh/authorized_keys for the GitHub deploy key (#20). The path is absolute because
# authorized_keys does not expand $HOME; the gate sits outside the app directory because a deploy
# replaces everything inside it. The key can run the gate's three commands and nothing else.
command="/home/djweddin/deploy/hochzeitslocation/deploy-gate",restrict ssh-ed25519 AAAA… github-deploy
