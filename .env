# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:app@database:5432/app?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailpit:1025
###< symfony/mailer ###

###> hochzeitslocation ###
# Originals (S9), outside public/; relative paths in venue_photos.original_path and
# venue_documents.path resolve against it.
MEDIA_ROOT=%kernel.project_dir%/var/media
# Generated variants and published PDFs (#20, PD12). Production keeps this; bin/prod-import overrides it.
MEDIA_PUBLIC_DIR=%kernel.project_dir%/public/media
# Largest CMS photo in pixels, for every type (#25, read from the header before gd decodes it). The site shows
# at most 1920 px. A php-fpm worker keeps freed memory for its next requests, so raise this only together with
# memory_limit (#20). Console batches use their own limit (ImageVariantGenerator::BATCH_MAX_PIXELS).
MEDIA_MAX_PIXELS=20000000
# Tallest shape of any upload, height ÷ width, read as stored and as EXIF turns it. Rows round up to 4 KiB
# pages and the 1920-wide variant grows with the height. Landscapes have no limit.
MEDIA_MAX_PORTRAIT_RATIO=2
# Content folders (S8, #9): <CONTENT_ROOT>/venues/<key>/venue.yaml; never committed.
CONTENT_ROOT=%kernel.project_dir%/content
# Size guard of the HttpCache store (#19, app:http-cache:clear --if-over-limit): 5 GiB, 1,000,000 files.
HTTP_CACHE_MAX_BYTES=5368709120
HTTP_CACHE_MAX_FILES=1000000
# Sender of every mail (IQ-2, Q1, Q5).
MAILER_FROM="Hochzeitslocation <hallo@hochzeitslocation.ch>"
# Redirects all venue mails and every CRM mail to one address outside production (IQ-4, CRM-10),
# and drops a CRM mail's CC. Production must leave it empty, here and in .env.local: a non-empty
# value means no venue gets its inquiries and no CRM mail reaches its recipient.
INQUIRY_RECIPIENT_OVERRIDE=

# Maps Embed API key for the Standort map (#15, DP-10, Q3). Empty = keyless: only the
# "Auf Google Maps öffnen" link. Production sets it in the host's env, never in a committed file;
# restrict it to the Maps Embed API and the site's referrer.
GOOGLE_MAPS_EMBED_KEY=
# Places API key for the one-off app:venues:geocode. Shell only, never in a file: leave it empty here.
GOOGLE_PLACES_API_KEY=
# Maps JavaScript API key for the near-me map (#52, owner Q1) and the Google rating on the detail
# page (#53). Empty = no map (list only), only the link to the Google reviews, and no request to
# Google. Production sets it in the host's env only; restrict it to the Maps JavaScript API and
# Places UI Kit and the site's referrer. A separate key from GOOGLE_MAPS_EMBED_KEY.
GOOGLE_MAPS_JS_KEY=
# Map ID for the near-me map's Advanced Markers. DEMO_MAP_ID is for dev and test only;
# app:prod:check-env refuses it in production when GOOGLE_MAPS_JS_KEY is set.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Back office (#22). Base64 of 32 bytes, encrypts admin_users.totp_secret_encrypted. Dev only: #20 generates production's.
ADMIN_TOTP_KEY=C4z5x/NrvHcYaxTo/OB1TIwDVPn7lTqoinJVPx8NV3M=
# Dev only: the X-Admin-Dev-Login and X-Portal-Dev-Login header value that logs Lighthouse in (make lighthouse ... ADMIN=1 or PORTAL=1). Inert outside APP_ENV=dev.
ADMIN_DEV_AUTOLOGIN=dev-lighthouse
ADMIN_DEV_AUTOLOGIN_EMAIL=admin@hochzeitslocation.test
PORTAL_DEV_AUTOLOGIN_EMAIL=manager@hochzeitslocation.test
###< hochzeitslocation ###

###> sentry/sentry-symfony ###
# Empty = no-op; production sets it in .env.local. Only the prod env loads the bundle.
SENTRY_DSN=
# The deployed commit; bin/deploy writes it to .env.prod.local.
SENTRY_RELEASE=
###< sentry/sentry-symfony ###
