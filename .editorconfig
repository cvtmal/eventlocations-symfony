# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[{compose.yaml,compose.*.yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Fixture pages that are ISO-8859-1 / Windows-1252 on purpose: do not re-save them as UTF-8.
[tests/Fixtures/SiteImport/05-iso-8859-1-restaurant/*.html]
charset = latin1
