# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# CI has no Mailpit; tests assert on queued mail and never open SMTP.
MAILER_DSN=null://null
# IQ-4: tests that need the real recipient build InquiryMailer by hand.
INQUIRY_RECIPIENT_OVERRIDE=override@hochzeitslocation.test
# Originals for tests (S9); variants go to var/test-media/public (app.media_public_dir).
MEDIA_ROOT=%kernel.project_dir%/var/test-media/originals
# Content folders for tests (#9); tests build their own and pass the path explicitly.
CONTENT_ROOT=%kernel.project_dir%/var/test-content
